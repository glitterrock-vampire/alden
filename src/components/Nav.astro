---
export interface Props {
  currentPage?: 'home' | 'work' | 'info';
}

const { currentPage = 'home' } = Astro.props;
---

<nav class="nav" id="main-nav" data-appear="nav">
  <div class="nav-container">
    <!-- Logo -->
    <a href="/" class="logo">
      <span class="nav-letter">A</span>
      <span class="nav-letter">L</span>
      <span class="nav-letter">D</span>
      <span class="nav-letter">E</span>
      <span class="nav-letter">N</span>
    </a>
    
    <!-- Navigation Links -->
    <div class="nav-links">
      <a href="/" class={`nav-link ${currentPage === 'home' ? 'active' : ''}`} onclick="handleNavClick(event, '/')">
        <span class="nav-link-text">HOME</span>
      </a>
      
      <a href="/work" class={`nav-link ${currentPage === 'work' ? 'active' : ''}`} onclick="handleNavClick(event, '/work')">
        <span class="nav-link-text">WORK</span>
      </a>
      
      <a href="/info" class={`nav-link ${currentPage === 'info' ? 'active' : ''}`} onclick="handleNavClick(event, '/info')">
        <span class="nav-link-text">INFO</span>
      </a>
    </div>
    
    <!-- Date Display -->
    <div class="nav-year">
      <span class="year-current"></span>
      <span class="day-current"></span>
    </div>
  </div>
</nav>

<script>
class NavScrollController {
  nav: HTMLElement;
  lastScrollY: number;
  isNavHidden: boolean;
  isReady: boolean;
  introDelay: number;

  constructor() {
    this.nav = document.getElementById('main-nav') as HTMLElement;
    this.lastScrollY = window.scrollY;
    this.isNavHidden = false;
    this.isReady = false;

    // Match the CSS animation delay
    const isMobile = window.matchMedia('(max-width: 809.98px)').matches;
    this.introDelay = isMobile ? (1 + 1.6) * 1000 : (2.5 + 1.5) * 1000;

    this.init();
  }

  init() {
    setTimeout(() => {
      this.nav.style.animation = 'none';
      this.nav.style.opacity = '1';
      this.nav.style.transform = 'translateY(0)';
      this.nav.style.transition = 'transform 0.35s cubic-bezier(0.55, 0.45, 0.16, 1), opacity 0.35s ease';

      this.isReady = true;
      this.lastScrollY = window.scrollY;
    }, this.introDelay);

    window.addEventListener('scroll', () => this.handleScroll(), { passive: true });
  }

  handleScroll() {
    if (!this.isReady) return;

    const currentScrollY = window.scrollY;
    const delta = currentScrollY - this.lastScrollY;

    if (Math.abs(delta) < 4) return;

    if (delta > 0) {
      this.hideNav();
    } else {
      this.showNav();
    }

    this.lastScrollY = currentScrollY;
  }

  hideNav() {
    if (!this.isNavHidden) {
      this.nav.style.transform = 'translateY(-120%)';
      this.nav.style.opacity = '0';
      this.isNavHidden = true;
    }
  }

  showNav() {
    if (this.isNavHidden) {
      this.nav.style.transform = 'translateY(0)';
      this.nav.style.opacity = '1';
      this.isNavHidden = false;
    }
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => new NavScrollController());
} else {
  new NavScrollController();
}

// Navigation click handler
function handleNavClick(event, targetUrl) {
  event.preventDefault();
  document.body.style.animation = 'slideUp 0.5s ease-out forwards';
  setTimeout(() => {
    window.location.href = targetUrl;
  }, 400);
}
</script>

<script>
// Update date
const date = new Date();
const formatted = `${(date.getMonth() + 1).toString().padStart(2, '0')}.${date.getDate().toString().padStart(2, '0')}.${date.getFullYear()}`;
const yearEl = document.querySelector('.year-current');
if (yearEl) yearEl.textContent = `[${formatted}]`;

const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const chineseDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
const dayIndex = date.getDay();
const dayText = `${days[dayIndex]} [${chineseDays[dayIndex]}]`;
const dayEl = document.querySelector('.day-current');
if (dayEl) dayEl.textContent = dayText;
</script>

<style>
.nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  padding: 24px;
  animation: slideDown 1.5s 2.5s cubic-bezier(0.55, 0.45, 0.16, 1) forwards;
  opacity: 0.001;
  transform: translateY(-150px);
  will-change: transform, opacity;
  /* Using the original mix-blend-mode from the Framer site */
  mix-blend-mode: difference;
  background: transparent;
}

@media (max-width: 809.98px) {
  .nav {
    animation: slideDown 1.6s 1s cubic-bezier(0.55, 0.45, 0.16, 1) forwards;
    padding: 24px 16px;
  }
}

.nav-container {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  max-width: 2500px;
  margin: 0 auto;
  position: relative;
}

.logo {
  text-decoration: none;
  transition: opacity 0.3s cubic-bezier(0.55, 0.45, 0.16, 1);
  display: flex;
  align-items: center;
  gap: 0;
  position: absolute;
  left: 0;
}

.logo:hover {
  opacity: 0.8;
}

.nav-letter {
  font-family: var(--font-koulen);
  font-size: 22px;
  letter-spacing: 0.02em;
  color: var(--token-text-light);
  transition: all 0.8s cubic-bezier(0.55, 0.45, 0.16, 1);
  display: inline-block;
  opacity: 1;
  transform: translateX(0);
}

.nav-links {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
}

@media (max-width: 1199.98px) {
  .nav-links {
    padding-left: 40px;
    gap: 1px;
  }
}

@media (max-width: 809.98px) {
  .nav-links {
    padding-left: 0;
  }
  
  .nav-link {
    transform: scale(0.9);
  }
}

.nav-link {
  text-decoration: none;
  position: relative;
  overflow: hidden;
  height: 20px;
  display: flex;
  align-items: center;
}

.nav-link-text {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-light);
  transition: transform 0.3s cubic-bezier(0.55, 0.45, 0.16, 1);
  display: block;
}

.nav-link.active .nav-link-text {
  position: relative;
  padding-left: 12px;
}

.nav-link.active .nav-link-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 5px;
  height: 5px;
  background: var(--token-text-light);
  border-radius: 0; /* Square dot as in original */
}

.nav-link:hover .nav-link-text {
  transform: translateY(-20px);
}

.nav-link.coming-soon {
  position: relative;
  cursor: not-allowed;
}

.nav-link.coming-soon .nav-link-text {
  opacity: 0.7;
}

.coming-soon-badge {
  position: absolute;
  top: -7px;
  left: 50%;
  transform: translateX(-50%) rotate(-6deg);
  width: 80px;
  height: 23px;
  background-image: url('/images/coming-soon-badge.png');
  background-size: contain;
  background-repeat: no-repeat;
  opacity: 0;
  transition: opacity 0.3s cubic-bezier(0.55, 0.45, 0.16, 1);
  pointer-events: none;
}

.nav-link.coming-soon:hover .coming-soon-badge {
  opacity: 1;
}

.nav-year {
  position: absolute;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: auto;
  height: auto;
  cursor: default;
}

.year-current {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  color: var(--token-text-light);
  white-space: nowrap;
  line-height: 1.4;
}

.day-current {
  font-family: var(--font-roboto-mono);
  font-size: 12px;
  color: var(--token-text-light);
  white-space: nowrap;
  margin-top: 2px;
  display: block;
  line-height: 1.4;
  opacity: 0.8;
}

@keyframes slideDown {
  0% {
    opacity: 0.001;
    transform: translateY(-150px);
    filter: blur(10px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

@keyframes slideUp {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateY(-50px);
  }
}
</style>