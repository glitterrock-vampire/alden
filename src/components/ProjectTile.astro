---
// src/components/ProjectTile.astro
export interface Props {
  project: {
    id: string;
    name: string;
    title: string;
    category: string;
    imageSrc: string;
    imageAlt: string;
    link: string;
    status: string;
  };
  featured?: boolean;
  class?: string;
}

const { project, featured = false, class: className = "" } = Astro.props;
---

<div class={`project-tile-wrapper ${featured ? 'featured' : ''} ${project.status === 'coming-soon' ? 'coming-soon' : ''} animate-on-scroll ${className}`} data-animate="fade-scale">
  <a href={project.link} class="project-link">
    <div class="project-image-container">
      <div class="project-image-wrapper">
        <img src={project.imageSrc} alt={project.imageAlt} class="project-image" loading="lazy" />
        <div class="project-image-overlay"></div>
        {project.status === 'coming-soon' && (
          <div class="coming-soon-badge">COMING SOON</div>
        )}
      </div>
      <div class="project-content">
        <div class="project-category">{project.category}</div>
        <div class="project-title">{project.title}</div>
        <div class="project-view">
          {project.status === 'coming-soon' ? 'COMING SOON' : 'VIEW PROJECT →'}
        </div>
      </div>
    </div>
  </a>
</div>

<style>
/* Project Tile Wrapper */
.project-tile-wrapper {
  position: relative;
  width: 100%;
  transform: translateY(0);
  opacity: 1;
  visibility: visible;
  filter: none;
  animation: fadeUp 0.8s ease forwards;
  transition: all 0.8s cubic-bezier(0.55, 0.45, 0.16, 1);
}

/* Force visibility for work section project tiles - no !important needed */
section.work .project-tile-wrapper {
  opacity: 1;
  transform: translateY(0);
  filter: none;
  visibility: visible;
}

section.work .project-content {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
}

.project-tile-wrapper:hover .project-image {
  transform: scale(1.1);
  filter: brightness(0.4);
}

.project-tile-wrapper:hover .project-image-overlay {
  background: linear-gradient(135deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.6) 100%);
}

.project-tile-wrapper:hover .project-content {
  transform: translateY(0);
  opacity: 1;
}

/* Project Link */
.project-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

/* Project Image Container */
.project-image-container {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 62.5%;
  overflow: hidden;
  border-radius: 8px;
  background: var(--token-bg-dark);
}

.featured-projects .project-image-container {
  padding-bottom: 75%;
}

.projects-grid .project-image-container {
  padding-bottom: 100%;
}

/* Project Image */
.project-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1), filter 0.8s ease;
}

/* Project Image Overlay */
.project-image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.2) 100%);
  transition: background 0.8s ease;
}

/* Project Content */
.project-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 24px;
  transform: translateY(100%);
  opacity: 0;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.8s ease;
}

/* Project Text */
.project-category {
  font-family: var(--font-roboto-mono);
  font-size: 11px;
  color: white;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 8px;
  transform: translateY(10px);
  transition: transform 0.6s ease 0.1s;
}

.project-title {
  font-family: var(--font-koulen);
  font-size: 22px;
  line-height: 1.1;
  color: white;
  margin-bottom: 12px;
  transform: translateY(10px);
  transition: transform 0.6s ease 0.15s;
}

.project-view {
  font-family: var(--font-roboto-mono);
  font-size: 12px;
  color: white;
  opacity: 0.7;
  transform: translateY(10px);
  transition: transform 0.6s ease 0.2s, opacity 0.6s ease 0.2s;
}

.project-tile-wrapper:hover .project-category,
.project-tile-wrapper:hover .project-title,
.project-tile-wrapper:hover .project-view {
  transform: translateY(0);
}

.project-tile-wrapper:hover .project-view {
  opacity: 1;
}

/* Coming Soon Badge */
.coming-soon-badge {
  position: absolute;
  top: 16px;
  right: 16px;
  background: var(--token-accent-gold);
  color: var(--token-bg-dark);
  padding: 4px 8px;
  font-family: var(--font-roboto-mono);
  font-size: 10px;
  font-weight: 600;
  border-radius: 4px;
  z-index: 2;
}

.project-tile-wrapper.coming-soon {
  opacity: 0.7;
}

.project-tile-wrapper.coming-soon .project-link {
  cursor: not-allowed;
}

/* Featured Projects Specific */
.featured-projects .project-tile-wrapper {
  flex: 1;
  max-width: 48%;
}

/* Projects Grid Specific */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 40px;
}

@media (max-width: 1199.98px) {
  .projects-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 809.98px) {
  .featured-projects {
    flex-direction: column;
    align-items: center;
    gap: 42px;
  }
  
  .featured-projects > * {
    width: 100%;
  }
  
  .projects-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }
}
</style>