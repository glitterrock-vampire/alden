---
// src/components/Footer.astro
import MusicPlayer from './MusicPlayer.astro';
import BackToTop from './BackToTop.astro';
import Button from './Button.astro';
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <span class="footer-name">[ALDEN]</span>
      <span class="footer-copyright">[COPYRIGHT 2026]</span>
    </div>
    
    <div class="footer-middle">
      <div class="footer-title">
        <span class="title-line footer-come" data-animate="COME" id="footerCome">COME</span>
        <span class="title-line footer-say" data-animate="say" id="footerSay">say</span>
        <span class="title-line footer-hello" data-animate="HELLO" id="footerHello">HELLO</span>
      </div>
      
      <div class="footer-chinese">
        <span class="chinese-char" data-animate="﹁">﹁</span>
        <span class="chinese-char" data-animate="你">你</span>
        <span class="chinese-char" data-animate="好">好</span>
        <span class="chinese-char" data-animate="﹂">﹂</span>
      </div>
      
      <div class="footer-player">
        <span class="player-label">[CURRENTLY ON REPEAT]</span>
        <MusicPlayer size="medium" />
        <span class="player-label-bottom">[LC - MEAN IT IN THE MORNING]</span>
      </div>
    </div>
    
    <div class="footer-bottom">
      <Button href="https://www.linkedin.com/in/andre-walters-ja/" variant="light" size="medium" target="_blank" class="social-linkedin">
        LINKEDIN
      </Button>
      
      <BackToTop />
      
      <Button href="https://www.instagram.com/andre_walters_ja/" variant="light" size="medium" target="_blank" class="social-instagram">
        INSTAGRAM
      </Button>
    </div>
  </div>
  
  <div class="footer-border"></div>
  <div class="footer-bg-blur">
    <img src="/images/footer-bg.jpg" alt="" loading="lazy" />
  </div>
</footer>

<script>
  // Universal footer animation script - works on all pages
  document.addEventListener('DOMContentLoaded', () => {
    const footerCome = document.getElementById('footerCome');
    const footerSay = document.getElementById('footerSay');
    const footerHello = document.getElementById('footerHello');
    const chineseChars = document.querySelectorAll('.chinese-char');
    
    // Make footer text visible immediately on all pages
    setTimeout(() => {
      if (footerCome) footerCome.classList.add('visible');
      if (footerSay) footerSay.classList.add('visible');
      if (footerHello) footerHello.classList.add('visible');
      
      // Make Chinese characters visible
      chineseChars.forEach(char => {
        char.style.opacity = '1';
        char.style.filter = 'blur(0)';
        char.style.transform = 'none';
      });
    }, 500);
  });
</script>

<style>
.footer {
  background: var(--token-bg-light);
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.footer-container {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.footer-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
}

.footer-name, .footer-copyright {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.5;
  color: var(--token-text-light);
  /* Smart color blending for readability */
  mix-blend-mode: difference;
  text-shadow: 0 0 8px rgba(0,0,0,0.6);
}

.footer-middle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 1;
  padding: 16px 76px;
}

.footer-title {
  width: 33%;
  padding: 24px;
}

.title-line {
  display: block;
  font-family: var(--font-koulen);
  font-size: 158px;
  line-height: 0.9em;
  color: var(--token-text-light);
  /* Smart color blending for readability */
  mix-blend-mode: difference;
  text-shadow: 0 0 20px rgba(0,0,0,0.8);
  transition: all 0.6s cubic-bezier(0.44,0,0.56,1);
  opacity: 0.001;
  filter: blur(10px);
  transform: translateY(10px);
}

/* Work page footer styles - ensure visibility */
.footer-come,
.footer-say,
.footer-hello {
  color: var(--token-text-light) !important;
  mix-blend-mode: difference !important;
  text-shadow: 0 0 20px rgba(0,0,0,0.8) !important;
}

.footer-come.visible,
.footer-say.visible,
.footer-hello.visible {
  opacity: 1 !important;
  filter: blur(0) !important;
  transform: none !important;
}

@media (min-width: 2000px) {
  .title-line {
    font-size: 205px;
  }
}

@media (max-width: 1499.98px) {
  .title-line {
    font-size: 128px;
  }
}

@media (max-width: 1199.98px) {
  .title-line {
    font-size: 88px;
  }
}

@media (max-width: 809.98px) {
  .title-line {
    font-size: 78px;
  }
}

@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

.footer-chinese {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 9999 !important;
}

.chinese-char {
  display: block;
  font-family: 'HanyiSentyFoundation Regular', sans-serif;
  font-size: 136px;
  line-height: 1.1;
  color: var(--token-accent-gold) !important;
  animation: fadeUp 1s 0.5s forwards;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
  /* Smart color blending for readability */
  mix-blend-mode: difference;
  text-shadow: 0 0 20px rgba(0,0,0,0.6);
  z-index: 9999 !important;
  position: relative;
}

@media (min-width: 2000px) {
  .chinese-char {
    font-size: 156px;
  }
}

@media (max-width: 1499.98px) {
  .chinese-char {
    font-size: 106px;
  }
}

@media (max-width: 1199.98px) {
  .chinese-char {
    font-size: 76px;
  }
}

@media (max-width: 809.98px) {
  .chinese-char {
    font-size: 73px;
    display: inline-block;
    z-index: 9999 !important;
    position: relative !important;
  }
  
  .footer-chinese {
    position: relative;
    top: auto;
    left: auto;
    transform: none;
    margin-bottom: 20px;
    z-index: 9999 !important;
  }
}

.footer-player {
  width: 33%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 25px;
  padding: 24px 45px 46px;
}

@media (max-width: 1199.98px) {
  .footer-player {
    padding: 24px 0;
  }
}

@media (max-width: 809.98px) {
  .footer-player {
    width: 100%;
    align-items: center;
    padding: 24px 0;
  }
}

.player-label, .player-label-bottom {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-light);
  white-space: nowrap;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
}

/* Enhanced social links styling */
.social-linkedin,
.social-instagram {
  position: relative;
  z-index: 9998 !important; /* Bring to top layer */
  transition: all 0.3s ease !important;
}

.social-linkedin:hover,
.social-instagram:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
}

.social-linkedin::before,
.social-instagram::before {
  content: '';
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  background: rgba(255,255,255,0.1);
  border-radius: 8px;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: -1;
}

.social-linkedin:hover::before,
.social-instagram:hover::before {
  opacity: 1;
}

/* Force all button elements to be visible and white */
.footer-bottom button,
.footer-bottom .button {
  z-index: 9998 !important;
}

.footer-bottom button *,
.footer-bottom .button * {
  color: #ffffff !important;
  z-index: 9999 !important;
}

.footer-bottom .button-text {
  color: #ffffff !important; /* Force white color */
  font-family: var(--font-koulen);
  font-size: 14px;
  font-weight: bold;
  mix-blend-mode: normal;
  text-shadow: 0 0 8px rgba(0, 0, 0, 0.8) !important;
  position: relative;
  z-index: 9999 !important; /* Bring button text to highest layer */
}

@media (max-width: 809.98px) {
  .footer-bottom {
    padding: 16px 0;
  }
}

.footer-border {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 21px solid var(--token-bg-light);
  pointer-events: none;
  z-index: 1;
}

@media (max-width: 809.98px) {
  .footer-border {
    border-width: 11px;
  }
}

.footer-bg-blur {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  filter: grayscale(0) saturate(0.6) blur(10px);
  z-index: 0;
}

.footer-bg-blur img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
</style>