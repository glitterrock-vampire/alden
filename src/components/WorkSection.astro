---
// src/components/WorkSection.astro
import ProjectTile from './ProjectTile.astro';
import Button from '../components/Button.astro';
import { projects } from '../data/projects.js';

export interface Props {
  showFeaturedOnly?: boolean;
}

const { showFeaturedOnly = false } = Astro.props;
---

<section class="work animate-on-scroll" data-animate>
  <div class="work-header">
    <h2 class="work-title">WORK</h2>
    <div class="work-chinese">
      <span class="chinese-bracket">﹁</span>
      <span class="chinese-char">作</span>
      <span class="chinese-char">品</span>
      <span class="chinese-char">集</span>
      <span class="chinese-bracket">﹂</span>
    </div>
    <h2 class="work-subtitle">PROJECTS</h2>
  </div>

  <!-- Featured Projects -->
  <div class="featured-projects stagger-animation">
    {projects.slice(0, 2).map((project) => (
      <ProjectTile project={project} featured={true} />
    ))}
  </div>

  {!showFeaturedOnly && (
    <>
      <!-- Projects Grid -->
      <div class="projects-grid stagger-animation">
        {projects.slice(2, 6).map((project) => (
          <ProjectTile project={project} />
        ))}
      </div>

      <div class="work-footer animate-on-scroll" data-animate="fade-scale">
        <p class="work-description">
          We take pride in providing our clients with an unforgettable experience from start to finish. From brainstorming sessions to casting calls, from scouting locations to post-production, we handle every aspect of the filmmaking process with care and attention to detail.
        </p>

        <Button href="/work" chineseText="看作品集" size="large" class="hover-lift">
          VIEW ALL WORK
        </Button>
      </div>
    </>
  )}
</section>

<style>
/* Work Section */
.work {
  background: var(--token-bg-light);
  padding: 50px 24px 500px;
  position: relative;
  z-index: 100;
  margin-top: 250px;
}

.work::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('https://framerusercontent.com/images/rR6HYXBrMmX4cRpXfXUOvpvpB0.png');
  background-repeat: repeat;
  background-size: 256px 256px;
  opacity: 0.05;
  pointer-events: none;
  z-index: -1;
}

.work-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px 0;
  position: relative;
  background: transparent;
  z-index: 3;
}

.work-title {
  font-family: var(--font-koulen);
  font-size: 244px;
  line-height: 0.83;
  color: var(--token-text-light);
}

.work-chinese {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: sticky;
  top: 0;
}

.work-chinese .chinese-char,
.work-chinese .chinese-bracket {
  font-size: 132px;
  color: var(--token-accent-gold);
  font-family: 'HanyiSentyFoundation Regular', sans-serif;
}

.work-subtitle {
  font-family: var(--font-koulen);
  font-size: 244px;
  line-height: 0.83;
  color: var(--token-text-light);
  text-align: right;
}

/* Featured Projects */
.featured-projects {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 50px;
  margin-top: 50px;
  gap: 40px;
  margin-bottom: 80px;
}

/* Projects Grid */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 40px;
}

/* Work Footer */
.work-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40px;
  padding: 100px 0 0;
  margin-top: 80px;
}

.work-description {
  width: 38%;
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.4;
  text-align: center;
  color: var(--token-text-light);
}

/* Responsive Design */
@media (max-width: 809.98px) {
  .work {
    padding: 75px 16px 0;
  }

  .work-header {
    flex-direction: column;
    align-items: center;
    gap: 21px;
    padding: 0;
  }

  .work-title {
    font-size: 90px;
    text-align: center;
    order: 1;
  }

  .work-chinese {
    position: relative;
    height: auto;
    order: 0;
  }

  .work-chinese .chinese-char,
  .work-chinese .chinese-bracket {
    font-size: 80px;
  }

  .work-subtitle {
    font-size: 90px;
    text-align: center;
    order: 3;
  }

  .featured-projects {
    flex-direction: column;
    align-items: center;
    gap: 42px;
    padding: 60px 0 0;
  }

  .featured-projects > * {
    width: 100%;
  }

  .projects-grid {
    grid-template-columns: 1fr;
    gap: 30px;
    padding: 40px 0 0;
  }

  .work-footer {
    padding: 60px 0 100px;
    gap: 29px;
  }

  .work-description {
    width: 100%;
    font-size: 14px;
  }
}

@media (min-width: 810px) and (max-width: 1199.98px) {
  .work-title,
  .work-subtitle {
    font-size: 92px;
  }

  .work-chinese .chinese-char,
  .work-chinese .chinese-bracket {
    font-size: 76px;
  }

  .projects-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .work-description {
    width: 49%;
    font-size: 12px;
  }
}

@media (min-width: 1200px) and (max-width: 1999.98px) {
  .work-title,
  .work-subtitle {
    font-size: 140px;
  }

  .work-chinese .chinese-char,
  .work-chinese .chinese-bracket {
    font-size: 80px;
  }

  .work-description {
    width: 60%;
  }
}

@media (min-width: 2000px) {
  .work-title,
  .work-subtitle {
    font-size: 244px;
  }

  .work-chinese .chinese-char,
  .work-chinese .chinese-bracket {
    font-size: 132px;
  }

  .work-description {
    width: 38%;
  }
}

/* Work Section - Force text visibility */
section.work .work-title,
section.work .work-subtitle,
section.work .work-chinese .chinese-char,
section.work .work-chinese .chinese-bracket {
  opacity: 1;
  visibility: visible;
  display: block;
  transform: none;
  filter: none;
  z-index: 9999;
  position: relative;
}

/* Work section positioning fix */
section.work {
  position: relative;
  z-index: 100;
  isolation: isolate;
}

section.work .work-header {
  position: relative;
  z-index: 101;
  isolation: isolate;
}
</style>
