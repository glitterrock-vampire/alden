---
// src/components/MusicPlayer.astro
export interface Props {
  size?: 'small' | 'medium' | 'large';
}

const { size = 'medium' } = Astro.props;

const sizeClasses = {
  small: 'music-player-small',
  medium: 'music-player-medium',
  large: 'music-player-large',
};
---

<div class={`music-player ${sizeClasses[size]}`} id="musicPlayer">
  <div class="player-lp" id="playerLp">
    <div class="player-label"></div>
    <div class="vinyl-grooves"></div>
  </div>
  
  <div class="player-album" id="playerAlbum">
    <div class="album-cover" id="albumCover">
      <img id="albumImage" src="/api/default-album" alt="Album Cover" />
    </div>
    <div class="album-overlay">
      <img src="/images/album-overlay.png" alt="" loading="lazy" />
    </div>
    <div class="playback-indicator" id="playbackIndicator">
      <div class="indicator-dot"></div>
    </div>
  </div>
  
  <div class="player-info">
    <span class="player-label-top" id="currentStatus">[CONNECTING TO SPOTIFY...]</span>
    <span class="player-label-bottom" id="trackInfo">[PLEASE WAIT]</span>
    <span class="player-label-history" id="lastPlayed">[LAST: --]</span>
  </div>
</div>

<script>
class DynamicMusicPlayer {
  constructor() {
    this.accessToken = null;
    this.currentTrack = null;
    this.lastTrack = null;
    this.isPlaying = false;
    this.clientId = 'andrewalters1997@gmail.com'; // Will need to be replaced with actual Client ID
    this.clientSecret = 'Frasshead1997'; // Will need to be replaced with actual Client Secret
    this.init();
  }

  async init() {
    try {
      // Initialize Spotify Web API
      await this.initializeSpotifyAPI();
      // Start polling for current track
      this.startTrackPolling();
      // Add hover animations
      this.setupHoverEffects();
    } catch (error) {
      console.error('Failed to initialize music player:', error);
      this.fallbackToStatic();
    }
  }

  async initializeSpotifyAPI() {
    try {
      // Since we're in static mode, we'll use simulation for now
      // In production with server mode, this would call the real API
      console.log('Running in static mode - using simulation');
      this.simulateSpotifyConnection();
    } catch (error) {
      console.log('Spotify API not available, using simulation');
      this.simulateSpotifyConnection();
    }
  }

  async getAccessToken() {
    try {
      const response = await fetch('/api/spotify', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ action: 'get_token' })
      });
      
      if (!response.ok) {
        throw new Error('Failed to get access token');
      }
      
      return await response.json();
    } catch (error) {
      throw new Error('Failed to get access token');
    }
  }

  async getCurrentPlayback() {
    if (!this.accessToken) return;
    
    try {
      const response = await fetch('https://api.spotify.com/v1/me/player/currently-playing', {
        headers: {
          'Authorization': 'Bearer ' + this.accessToken
        }
      });
      
      if (response.status === 204) {
        // No active playback
        await this.getRecentlyPlayed();
        return;
      }
      
      if (response.ok) {
        const data = await response.json();
        this.updateTrackInfo({
          name: data.item.name,
          artist: data.item.artists[0].name,
          album: data.item.album.name,
          image: data.item.album.images[0]?.url || '/images/default-album.jpg',
          isPlaying: data.is_playing,
          progress: data.progress_ms,
          duration: data.item.duration_ms
        });
      }
    } catch (error) {
      console.error('Error getting current playback:', error);
      await this.getRecentlyPlayed();
    }
  }

  async getRecentlyPlayed() {
    if (!this.accessToken) return;
    
    try {
      const response = await fetch('https://api.spotify.com/v1/me/player/recently-played?limit=1', {
        headers: {
          'Authorization': 'Bearer ' + this.accessToken
        }
      });
      
      if (response.ok) {
        const data = await response.json();
        const track = data.items[0].track;
        
        this.updateTrackInfo({
          name: track.name,
          artist: track.artists[0].name,
          album: track.album.name,
          image: track.album.images[0]?.url || '/images/default-album.jpg',
          isPlaying: false
        });
      }
    } catch (error) {
      console.error('Error getting recently played:', error);
      this.simulateSpotifyConnection();
    }
  }

  simulateSpotifyConnection() {
    // Dynamic simulated track data with varied genres and realistic info
    const tracks = [
      { name: "Blinding Lights", artist: "The Weeknd", album: "After Hours", image: "/api/default-album", isPlaying: true },
      { name: "Levitating", artist: "Dua Lipa", album: "Future Nostalgia", image: "/api/default-album", isPlaying: false },
      { name: "Heat Waves", artist: "Glass Animals", album: "Dreamland", image: "/api/default-album", isPlaying: false },
      { name: "Stay", artist: "The Kid LAROI & Justin Bieber", album: "Stay", image: "/api/default-album", isPlaying: false },
      { name: "Good 4 U", artist: "Olivia Rodrigo", album: "SOUR", image: "/api/default-album", isPlaying: false },
      { name: "Industry Baby", artist: "Lil Nas X & Jack Harlow", album: "Montero", image: "/api/default-album", isPlaying: false },
      { name: "Peaches", artist: "Justin Bieber ft. Daniel Caesar & Giveon", album: "Justice", image: "/api/default-album", isPlaying: false },
      { name: "Montero (Call Me By Your Name)", artist: "Lil Nas X", album: "Montero", image: "/api/default-album", isPlaying: false },
      { name: "Kiss Me More", artist: "Doja Cat ft. SZA", album: "Planet Her", image: "/api/default-album", isPlaying: false },
      { name: "Save Your Tears", artist: "The Weeknd", album: "After Hours", image: "/api/default-album", isPlaying: false },
      { name: "Drivers License", artist: "Olivia Rodrigo", album: "SOUR", image: "/api/default-album", isPlaying: false },
      { name: "Deja Vu", artist: "Olivia Rodrigo", album: "SOUR", image: "/api/default-album", isPlaying: false },
      { name: "Familia", artist: "BTS", album: "Proof", image: "/api/default-album", isPlaying: false },
      { name: "Bad Habits", artist: "Ed Sheeran", album: "=", image: "/api/default-album", isPlaying: false },
      { name: "Shivers", artist: "Ed Sheeran", album: "=", image: "/api/default-album", isPlaying: false }
    ];

    let trackIndex = 0;
    let playDuration = 15000 + Math.random() * 10000; // 15-25 seconds per track
    
    const updateTrack = () => {
      const track = tracks[trackIndex];
      this.updateTrackInfo(track);
      
      // Simulate track changes with random timing
      setTimeout(() => {
        trackIndex = (trackIndex + 1) % tracks.length;
        playDuration = 15000 + Math.random() * 10000; // Random duration for next track
        updateTrack();
      }, playDuration);
    };

    updateTrack();
  }

  updateTrackInfo(track) {
    const albumImage = document.getElementById('albumImage');
    const trackInfo = document.getElementById('trackInfo');
    const currentStatus = document.getElementById('currentStatus');
    const lastPlayed = document.getElementById('lastPlayed');
    const playbackIndicator = document.getElementById('playbackIndicator');
    const playerLp = document.getElementById('playerLp');

    // Update album cover
    if (albumImage && track.image) {
      albumImage.src = track.image;
      albumImage.onerror = () => {
        albumImage.src = '/api/default-album';
      };
    }

    // Update track info
    if (trackInfo) {
      trackInfo.textContent = `[${track.artist} - ${track.name}]`;
    }

    // Update status
    if (currentStatus) {
      currentStatus.textContent = track.isPlaying ? '[NOW PLAYING]' : '[LAST PLAYED]';
    }

    // Update last played
    if (lastPlayed && this.lastTrack) {
      lastPlayed.textContent = `[LAST: ${this.lastTrack.artist} - ${this.lastTrack.name}]`;
    }

    // Update playback indicator
    if (playbackIndicator) {
      playbackIndicator.classList.toggle('playing', track.isPlaying);
    }

    // Animate vinyl rotation when playing
    if (playerLp) {
      if (track.isPlaying) {
        playerLp.classList.add('spinning');
      } else {
        playerLp.classList.remove('spinning');
      }
    }

    // Store last track
    this.lastTrack = this.currentTrack;
    this.currentTrack = track;
    this.isPlaying = track.isPlaying;
  }

  setupHoverEffects() {
    const playerAlbum = document.getElementById('playerAlbum');
    const playerLp = document.getElementById('playerLp');
    const musicPlayer = document.getElementById('musicPlayer');

    if (!playerAlbum || !playerLp || !musicPlayer) return;

    musicPlayer.addEventListener('mouseenter', () => {
      // Enhanced hover animations
      playerAlbum.style.transform = 'translate(-50%, -50%) translateX(-30px) scale(1.05) rotate(2deg)';
      playerLp.style.transform = 'translate(-50%, -50%) translateX(60px) rotate(-15deg)';
      playerAlbum.style.boxShadow = '0 60px 65px -35px rgba(0,0,0,0.35)';
      playerLp.style.boxShadow = '0 15px 30px -10px rgba(0,0,0,0.4)';
    });

    musicPlayer.addEventListener('mouseleave', () => {
      // Reset animations
      playerAlbum.style.transform = 'translate(-50%, -50%)';
      playerLp.style.transform = 'translate(-50%, -50%)';
      playerAlbum.style.boxShadow = '0 50px 55px -30px rgba(0,0,0,0.25)';
      playerLp.style.boxShadow = 'inset 0 0 0 6px rgba(255,255,255,0.1)';
    });
  }

  startTrackPolling() {
    // Poll for track updates every 5 seconds
    setInterval(async () => {
      if (this.accessToken) {
        await this.getCurrentPlayback();
      }
    }, 5000);
  }

  fallbackToStatic() {
    const trackInfo = document.getElementById('trackInfo');
    const currentStatus = document.getElementById('currentStatus');
    
    if (trackInfo) trackInfo.textContent = '[LC - Mean It In The Morning]';
    if (currentStatus) currentStatus.textContent = '[CURRENTLY ON REPEAT]';
  }
}

// Initialize the player when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => new DynamicMusicPlayer());
} else {
  new DynamicMusicPlayer();
}
</script>

<style>
.music-player {
  position: relative;
}

.music-player-medium {
  width: 378px;
  height: 280px;
}

.music-player-small {
  width: 270px;
  height: 200px;
}

.music-player-large {
  width: 420px;
  height: 310px;
}

.player-lp {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 264px;
  height: 264px;
  border-radius: 50%;
  background: linear-gradient(45deg, #1a1a1a 0%, #2a2a2a 50%, #1a1a1a 100%);
  box-shadow: 
    inset 0 0 0 6px rgba(255,255,255,0.1),
    0 10px 20px rgba(0,0,0,0.3);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

.music-player-small .player-lp {
  width: 180px;
  height: 180px;
}

.music-player-large .player-lp {
  width: 300px;
  height: 300px;
}

.player-lp.spinning {
  animation: vinyl-spin 3s linear infinite;
}

@keyframes vinyl-spin {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.vinyl-grooves {
  position: absolute;
  inset: 20px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.05);
  box-shadow: 
    inset 0 0 0 1px rgba(255,255,255,0.03),
    inset 0 0 0 20px rgba(255,255,255,0.02),
    inset 0 0 0 40px rgba(255,255,255,0.01);
}

.player-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-30deg);
  width: 81px;
  height: 81px;
  border-radius: 50%;
  background: radial-gradient(circle, #ff6b6b 0%, #c92a2a 100%);
  box-shadow: 
    0 0 0 10px rgba(255,255,255,0.1),
    inset 0 2px 4px rgba(0,0,0,0.2);
}

.music-player-small .player-label {
  width: 55px;
  height: 55px;
  box-shadow: 0 0 0 7px rgba(255,255,255,0.1);
}

.music-player-large .player-label {
  width: 92px;
  height: 92px;
  box-shadow: 0 0 0 12px rgba(255,255,255,0.1);
}

.player-album {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 267px;
  height: 267px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.3);
  background-color: #a18f5c;
  filter: saturate(1.3);
  box-shadow: 0 50px 55px -30px rgba(0,0,0,0.25);
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.music-player-small .player-album {
  width: 182px;
  height: 182px;
}

.music-player-large .player-album {
  width: 303px;
  height: 303px;
}

.album-cover {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.album-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.music-player:hover .album-cover img {
  transform: scale(1.05);
}

.album-overlay {
  position: absolute;
  bottom: 0;
  left: -1px;
  width: 101%;
  height: 100%;
  mix-blend-mode: screen;
  pointer-events: none;
}

.album-overlay img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.playback-indicator {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 12px;
  height: 12px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.playback-indicator.playing {
  opacity: 1;
}

.indicator-dot {
  width: 100%;
  height: 100%;
  background: #00ff00;
  border-radius: 50%;
  box-shadow: 0 0 10px #00ff00;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.2); }
}

.player-info {
  position: absolute;
  bottom: 46px;
  right: 45px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 15px;
}

.music-player-small .player-info {
  bottom: 30px;
  right: 30px;
  gap: 10px;
}

.music-player-large .player-info {
  bottom: 52px;
  right: 52px;
  gap: 20px;
}

.player-label-top, 
.player-label-bottom, 
.player-label-history {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-light);
  white-space: nowrap;
  transition: all 0.3s ease;
}

.music-player-small .player-label-top,
.music-player-small .player-label-bottom,
.music-player-small .player-label-history {
  font-size: 12px;
}

.music-player-large .player-label-top,
.music-player-large .player-label-bottom,
.music-player-large .player-label-history {
  font-size: 16px;
}

.player-label-history {
  opacity: 0.6;
  font-size: 12px;
}

.music-player-small .player-label-history {
  font-size: 10px;
}

.music-player-large .player-label-history {
  font-size: 14px;
}

/* Enhanced hover effects */
.music-player:hover .player-label-top {
  color: #00ff00;
  text-shadow: 0 0 5px #00ff00;
}

.music-player:hover .player-label-bottom {
  transform: translateX(-5px);
}

.music-player:hover .player-label-history {
  opacity: 0.8;
}
</style>