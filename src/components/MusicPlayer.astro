---
// src/components/MusicPlayer.astro
export interface Props {
  size?: 'small' | 'medium' | 'large';
}

const { size = 'medium' } = Astro.props;

const sizeClasses = {
  small: 'music-player-small',
  medium: 'music-player-medium',
  large: 'music-player-large',
};
---

<div class={`music-player ${sizeClasses[size]}`} id="musicPlayer">
  <div class="player-lp" id="playerLp">
    <div class="player-label"></div>
    <div class="vinyl-grooves"></div>
  </div>
  
  <div class="player-album" id="playerAlbum">
    <div class="album-cover" id="albumCover">
      <img id="albumImage" src="/images/default-album.jpg" alt="Album Cover" />
    </div>
    <div class="album-overlay">
      <img src="/images/album-overlay.png" alt="" loading="lazy" />
    </div>
    <div class="playback-indicator" id="playbackIndicator">
      <div class="indicator-dot"></div>
    </div>
  </div>
  
  <div class="player-info">
    <span class="player-label-top" id="currentStatus">[CONNECTING TO SPOTIFY...]</span>
    <span class="player-label-bottom" id="trackInfo">[PLEASE WAIT]</span>
    <span class="player-label-history" id="lastPlayed">[LAST: --]</span>
  </div>
</div>

<script>
class DynamicMusicPlayer {
  constructor() {
    this.accessToken = null;
    this.currentTrack = null;
    this.lastTrack = null;
    this.isPlaying = false;
    this.init();
  }

  async init() {
    try {
      // Initialize Spotify Web SDK
      await this.initializeSpotifySDK();
      // Start polling for current track
      this.startTrackPolling();
      // Add hover animations
      this.setupHoverEffects();
    } catch (error) {
      console.error('Failed to initialize music player:', error);
      this.fallbackToStatic();
    }
  }

  async initializeSpotifySDK() {
    // You'll need to implement Spotify Web Playback SDK or use Spotify Web API
    // For now, we'll simulate with a fallback
    this.simulateSpotifyConnection();
  }

  simulateSpotifyConnection() {
    // Simulated track data - replace with real API calls
    const tracks = [
      { name: "Mean It In The Morning", artist: "LC", album: "Dreams", image: "/images/album1.jpg", isPlaying: true },
      { name: "Midnight City", artist: "M83", album: "Hurry Up, We're Dreaming", image: "/images/album2.jpg", isPlaying: false },
      { name: "Starlight", artist: "Muse", album: "Black Holes and Revelations", image: "/images/album3.jpg", isPlaying: false }
    ];

    let trackIndex = 0;
    
    const updateTrack = () => {
      const track = tracks[trackIndex];
      this.updateTrackInfo(track);
      
      // Simulate track changes
      setTimeout(() => {
        trackIndex = (trackIndex + 1) % tracks.length;
        updateTrack();
      }, 8000); // Change track every 8 seconds
    };

    updateTrack();
  }

  updateTrackInfo(track) {
    const albumImage = document.getElementById('albumImage');
    const trackInfo = document.getElementById('trackInfo');
    const currentStatus = document.getElementById('currentStatus');
    const lastPlayed = document.getElementById('lastPlayed');
    const playbackIndicator = document.getElementById('playbackIndicator');
    const playerLp = document.getElementById('playerLp');

    // Update album cover
    if (albumImage && track.image) {
      albumImage.src = track.image;
    }

    // Update track info
    if (trackInfo) {
      trackInfo.textContent = `[${track.artist} - ${track.name}]`;
    }

    // Update status
    if (currentStatus) {
      currentStatus.textContent = track.isPlaying ? '[NOW PLAYING]' : '[CURRENTLY ON REPEAT]';
    }

    // Update last played
    if (lastPlayed && this.lastTrack) {
      lastPlayed.textContent = `[LAST: ${this.lastTrack.artist} - ${this.lastTrack.name}]`;
    }

    // Update playback indicator
    if (playbackIndicator) {
      playbackIndicator.classList.toggle('playing', track.isPlaying);
    }

    // Animate vinyl rotation when playing
    if (playerLp) {
      if (track.isPlaying) {
        playerLp.classList.add('spinning');
      } else {
        playerLp.classList.remove('spinning');
      }
    }

    // Store last track
    this.lastTrack = this.currentTrack;
    this.currentTrack = track;
    this.isPlaying = track.isPlaying;
  }

  setupHoverEffects() {
    const playerAlbum = document.getElementById('playerAlbum');
    const playerLp = document.getElementById('playerLp');
    const musicPlayer = document.getElementById('musicPlayer');

    if (!playerAlbum || !playerLp || !musicPlayer) return;

    musicPlayer.addEventListener('mouseenter', () => {
      // Enhanced hover animations
      playerAlbum.style.transform = 'translate(-50%, -50%) translateX(-30px) scale(1.05) rotate(2deg)';
      playerLp.style.transform = 'translate(-50%, -50%) translateX(60px) rotate(-15deg)';
      playerAlbum.style.boxShadow = '0 60px 65px -35px rgba(0,0,0,0.35)';
      playerLp.style.boxShadow = '0 15px 30px -10px rgba(0,0,0,0.4)';
    });

    musicPlayer.addEventListener('mouseleave', () => {
      // Reset animations
      playerAlbum.style.transform = 'translate(-50%, -50%)';
      playerLp.style.transform = 'translate(-50%, -50%)';
      playerAlbum.style.boxShadow = '0 50px 55px -30px rgba(0,0,0,0.25)';
      playerLp.style.boxShadow = 'inset 0 0 0 6px rgba(255,255,255,0.1)';
    });
  }

  startTrackPolling() {
    // Poll for track updates every 5 seconds
    setInterval(() => {
      // In real implementation, this would call Spotify API
      // For now, we're using the simulation
    }, 5000);
  }

  fallbackToStatic() {
    const trackInfo = document.getElementById('trackInfo');
    const currentStatus = document.getElementById('currentStatus');
    
    if (trackInfo) trackInfo.textContent = '[LC - Mean It In The Morning]';
    if (currentStatus) currentStatus.textContent = '[CURRENTLY ON REPEAT]';
  }
}

// Initialize the player when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => new DynamicMusicPlayer());
} else {
  new DynamicMusicPlayer();
}
</script>

<style>
.music-player {
  position: relative;
}

.music-player-medium {
  width: 378px;
  height: 280px;
}

.music-player-small {
  width: 270px;
  height: 200px;
}

.music-player-large {
  width: 420px;
  height: 310px;
}

.player-lp {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 264px;
  height: 264px;
  border-radius: 50%;
  background: linear-gradient(45deg, #1a1a1a 0%, #2a2a2a 50%, #1a1a1a 100%);
  box-shadow: 
    inset 0 0 0 6px rgba(255,255,255,0.1),
    0 10px 20px rgba(0,0,0,0.3);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

.music-player-small .player-lp {
  width: 180px;
  height: 180px;
}

.music-player-large .player-lp {
  width: 300px;
  height: 300px;
}

.player-lp.spinning {
  animation: vinyl-spin 3s linear infinite;
}

@keyframes vinyl-spin {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.vinyl-grooves {
  position: absolute;
  inset: 20px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.05);
  box-shadow: 
    inset 0 0 0 1px rgba(255,255,255,0.03),
    inset 0 0 0 20px rgba(255,255,255,0.02),
    inset 0 0 0 40px rgba(255,255,255,0.01);
}

.player-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-30deg);
  width: 81px;
  height: 81px;
  border-radius: 50%;
  background: radial-gradient(circle, #ff6b6b 0%, #c92a2a 100%);
  box-shadow: 
    0 0 0 10px rgba(255,255,255,0.1),
    inset 0 2px 4px rgba(0,0,0,0.2);
}

.music-player-small .player-label {
  width: 55px;
  height: 55px;
  box-shadow: 0 0 0 7px rgba(255,255,255,0.1);
}

.music-player-large .player-label {
  width: 92px;
  height: 92px;
  box-shadow: 0 0 0 12px rgba(255,255,255,0.1);
}

.player-album {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 267px;
  height: 267px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.3);
  background-color: #a18f5c;
  filter: saturate(1.3);
  box-shadow: 0 50px 55px -30px rgba(0,0,0,0.25);
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.music-player-small .player-album {
  width: 182px;
  height: 182px;
}

.music-player-large .player-album {
  width: 303px;
  height: 303px;
}

.album-cover {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.album-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.music-player:hover .album-cover img {
  transform: scale(1.05);
}

.album-overlay {
  position: absolute;
  bottom: 0;
  left: -1px;
  width: 101%;
  height: 100%;
  mix-blend-mode: screen;
  pointer-events: none;
}

.album-overlay img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.playback-indicator {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 12px;
  height: 12px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.playback-indicator.playing {
  opacity: 1;
}

.indicator-dot {
  width: 100%;
  height: 100%;
  background: #00ff00;
  border-radius: 50%;
  box-shadow: 0 0 10px #00ff00;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.2); }
}

.player-info {
  position: absolute;
  bottom: 46px;
  right: 45px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 15px;
}

.music-player-small .player-info {
  bottom: 30px;
  right: 30px;
  gap: 10px;
}

.music-player-large .player-info {
  bottom: 52px;
  right: 52px;
  gap: 20px;
}

.player-label-top, 
.player-label-bottom, 
.player-label-history {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-light);
  white-space: nowrap;
  transition: all 0.3s ease;
}

.music-player-small .player-label-top,
.music-player-small .player-label-bottom,
.music-player-small .player-label-history {
  font-size: 12px;
}

.music-player-large .player-label-top,
.music-player-large .player-label-bottom,
.music-player-large .player-label-history {
  font-size: 16px;
}

.player-label-history {
  opacity: 0.6;
  font-size: 12px;
}

.music-player-small .player-label-history {
  font-size: 10px;
}

.music-player-large .player-label-history {
  font-size: 14px;
}

/* Enhanced hover effects */
.music-player:hover .player-label-top {
  color: #00ff00;
  text-shadow: 0 0 5px #00ff00;
}

.music-player:hover .player-label-bottom {
  transform: translateX(-5px);
}

.music-player:hover .player-label-history {
  opacity: 0.8;
}
</style>