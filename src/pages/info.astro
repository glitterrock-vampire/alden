      0% { box-shadow: 0 0 0 0 rgba(43, 219, 0, 0.4); }
      70% { box-shadow: 0 0 0 10px rgba(43, 219, 0, 0); }
      100% { box-shadow: 0 0 0 0 rgba(43, 219, 0, 0); }
