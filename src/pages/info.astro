  <!-- CSS Animations for Intersection Observer -->
  <style>
    /* Animation classes for Intersection Observer */
    [data-animate] {
      opacity: 0 !important;
      transform: translateY(30px);
      transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-animate].visible {
      opacity: 1 !important;
      transform: translateY(0);
    }

    /* Staggered animations */
    .letter-char {
      transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1); /* Increased from 0.6s to 0.8s */
    }

    /* Footer animations */
    .footer #footerCome,
    .footer #footerSay,
    .footer #footerHello,
    .footer .chinese-char {
      opacity: 0;
      transform: translateY(20px) scale(0.9);
      transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .footer #footerCome.visible,
    .footer #footerSay.visible,
    .footer #footerHello.visible,
    .footer .chinese-char.visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* Stagger for footer */
    .footer #footerSay.visible {
      transition-delay: 0.1s;
    }

    .footer #footerHello.visible {
      transition-delay: 0.2s;
    }
  </style>
