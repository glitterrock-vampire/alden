      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle at center, rgba(204, 187, 135, 0.1) 0%, transparent 70%);
      animation: rotate 30s linear infinite;
      pointer-events: none;
    }

    @keyframes rotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .cta-wrapper {
      display: flex;
      justify-content: space-between;
      padding: 0 150px;
      position: relative;
      z-index: 2;
    }

    .cta-left, .cta-right {
      position: relative;
      flex: 1;
    }

    .cta-large {
      font-family: var(--font-koulen);
      font-size: clamp(90px, 15vw, 212px);
      line-height: 0.83;
      color: var(--color-text-primary);
      text-align: center;
    }

    .large-word {
      display: block;
      transition: transform var(--transition-base);
      cursor: default;
    }

    .large-word:hover {
      transform: scale(1.05);
      color: var(--color-accent-gold);
    }

    .cta-chinese {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--font-hanyi);
      font-size: clamp(50px, 10vw, 126px);
      line-height: 1.1;
      color: var(--color-accent-gold);
      text-align: center;
      white-space: pre-line;
      opacity: 0.9;
      transition: all var(--transition-base);
    }

    .cta-chinese:hover {
      transform: translate(-50%, -50%) scale(1.1);
      text-shadow: 0 0 20px rgba(204, 187, 135, 0.5);
    }

    /* ----------------------------------------
       Next Project Section
       ---------------------------------------- */
    .next-project {
      background-color: var(--color-bg);
      color: var(--color-text-primary);
      padding: 50px var(--space-lg);
      position: relative;
    }

    .next-header {
      text-align: center;
      margin-bottom: 40px;
      position: relative;
      z-index: 2;
    }

    .next-label {
      font-family: var(--font-koulen);
      font-size: 54px;
      line-height: 1.4;
      color: var(--color-text-primary);
      margin-bottom: var(--space-sm);
      transition: transform var(--transition-base);
      cursor: default;
    }

    .next-label:hover {
      transform: scale(1.02);
      color: var(--color-accent-gold);
    }

    .next-meta {
      font-family: var(--font-roboto-mono);
      font-size: 14px;
      color: var(--color-text-primary);
      opacity: 0.7;
      letter-spacing: 0.05em;
    }

    .next-card {
      display: block;
      width: 70%;
      height: 70vh;
      margin: 0 auto 60px;
      position: relative;
      overflow: hidden;
      border-radius: 20px;
      cursor: pointer;
      box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }

    .next-image {
      width: 100%;
      height: 100%;
    }

    .next-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 1.2s var(--ease-out-expo);
    }

    .next-card:hover .next-image img {
      transform: scale(1.1);
    }

    .next-overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      display: flex;
      justify-content: space-between;
      padding: 0 var(--space-lg);
      color: var(--color-white);
      font-family: var(--font-roboto-mono);
      font-size: 14px;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
      z-index: 3;
      opacity: 0;
      transition: opacity var(--transition-base);
    }

    .next-card:hover .next-overlay {
      opacity: 1;
    }

    .next-overlay span {
      transform: translateY(20px);
      transition: transform var(--transition-base);
      transition-delay: 0.1s;
    }

    .next-card:hover .next-overlay span {
      transform: translateY(0);
    }

    .next-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.5));
      opacity: 0;
      transition: opacity var(--transition-base);
      z-index: 2;
    }

    .next-card:hover::after {
      opacity: 1;
    }

    .next-description {
      max-width: 38%;
      margin: 0 auto 40px;
      text-align: center;
      font-family: var(--font-roboto-mono);
      font-size: 14px;
      line-height: 1.4;
      color: var(--color-text-primary);
      position: relative;
      z-index: 2;
    }

    .next-button {
      display: inline-block;
      padding: 12px 24px;
      background-color: transparent;
      color: var(--color-text-primary);
      font-family: var(--font-koulen);
      font-size: 20px;
      line-height: 1.4;
      text-decoration: none;
      margin: 0 auto;
      display: table;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(231, 229, 223, 0.3);
      border-radius: 4px;
      transition: all var(--transition-base);
      cursor: pointer;
      letter-spacing: 0.1em;
    }

    .next-button::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: var(--color-text-primary);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
      z-index: -1;
    }

    .next-button:hover {
      color: var(--color-bg);
    }

    .next-button:hover::before {
      width: 300px;
      height: 300px;
    }

