---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const pageData = {
  offerings: [
    {
      id: 'strategy',
      title: 'STRATEGY',
      description: 'Crafting comprehensive design strategies that align with business objectives and user needs. From research to implementation, I ensure every design decision serves a purpose.',
      related: ['UX Research', 'Brand Strategy', 'Product Planning']
    },
    {
      id: 'design',
      title: 'DESIGN',
      description: 'Creating intuitive, beautiful interfaces that balance aesthetics with functionality. Every pixel, every interaction is thoughtfully designed to enhance the user experience.',
      related: ['UI/UX Design', 'Interaction Design', 'Visual Design']
    },
    {
      id: 'development',
      title: 'DEVELOPMENT',
      description: 'Bringing designs to life with clean, efficient code. I specialize in modern web technologies and frameworks to create performant, scalable solutions.',
      related: ['Frontend Development', 'React/Vue/Astro', 'Performance Optimization']
    },
    {
      id: 'leadership',
      title: 'LEADERSHIP',
      description: 'Guiding teams and projects to success. From mentoring junior designers to leading cross-functional initiatives, I help organizations achieve their design goals.',
      related: ['Team Leadership', 'Design Systems', 'Mentorship']
    }
  ]
};
---

<!-- HTML Template -->
<Layout title="ALDEN | Info" description="Learn more about ALDEN, Senior Visual Designer at IBM iX.">
  <Nav currentPage="info" />
  
  <!-- Intersection Observer Animation Script -->
  <script>
    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', () => {
      console.log('Initializing Intersection Observer animations...');
      
      // Add initial delay before any animations start
      setTimeout(() => {
        // Intersection Observer for hero letters
        const heroObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element = entry.target;
              element.classList.add('visible');
              heroObserver.unobserve(element);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        // Animate hero letters with longer delay
        document.querySelectorAll('.letter-char').forEach((char, index) => {
          setTimeout(() => {
            char.style.opacity = '1';
            char.style.transform = 'translateX(0px) translateY(0px) scale(1)';
            char.style.filter = 'blur(0px)';
          }, index * 150); // Increased from 100ms to 150ms for slower animation
        });

        // Enhanced scroll observer for all bio sections
        const scrollObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const element = entry.target;
            
            if (entry.isIntersecting) {
              // Element is entering viewport - animate in
              setTimeout(() => {
                element.classList.add('visible');
              }, 100); // Reduced delay for smoother animations
            } else {
              // Element is leaving viewport - animate out
              element.classList.remove('visible');
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        // Observe all sections including immersive
        const sectionsToObserve = [
          '.about-description',
          '.about-bio',
          '.about-experience',
          '.about-education',
          '.about-achievements',
          '.about-interests',
          '.bio-meta',
          '.bio-text',
          '.immersive',
          '.immersive-stats',
          '.immersive-description'
        ];

        sectionsToObserve.forEach(selector => {
          document.querySelectorAll(selector).forEach(el => {
            scrollObserver.observe(el);
          });
        });

        // Footer animations with delay
        const footerObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            setTimeout(() => {
              document.getElementById('footerCome')?.classList.add('visible');
              setTimeout(() => {
                document.getElementById('footerSay')?.classList.add('visible');
              }, 100);
              setTimeout(() => {
                document.getElementById('footerHello')?.classList.add('visible');
              }, 200);
              setTimeout(() => {
                document.querySelector('.footer-chinese-wrap')?.classList.add('visible');
              }, 300);
            }, 300); // 300ms delay before footer animations start
            footerObserver.unobserve(entry.target);
          });
        }, { threshold: 0.2 });

        const footer = document.querySelector('.footer');
        if (footer) {
          footerObserver.observe(footer);
        }

        console.log('Animations initialized successfully');
      }, 800); // 800ms initial delay before any animations start
    });
  </script>
  <style>
    /* ----------------------------------------
       CSS Variables & Theme Configuration
       ---------------------------------------- */
    :root {
      /* Color System - Exact tokens from original */
      --color-bg: #000000;
      --color-bg-light: #e7e5df;
      --color-text-primary: #e7e5df;
      --color-text-secondary: #2f2f2f;
      --color-accent-gold: #ccbb87;
      --color-accent-gold-dark: #8a7432;
      --color-accent-light: #e6d8ad;
      --color-border: rgba(231, 229, 223, 0.2);
      --color-overlay: rgba(0, 0, 0, 0.3);
      --color-white: #ffffff;
      
      /* Font variables */
      --font-koulen: 'Koulen', cursive;
      --font-roboto: 'Roboto', sans-serif;
      --font-roboto-mono: 'Roboto Mono', monospace;
      --font-pinyon: 'Pinyon Script', cursive;
      --font-hanyi: 'Georgia', serif;
      --font-albert-sans: 'Albert Sans', sans-serif;
      --font-inter: 'Inter', sans-serif;
      
      /* Compatibility variables for Nav component */
      --token-text-light: var(--color-text-primary);
      
      /* Spacing */
      --space-xs: 4px;
      --space-sm: 8px;
      --space-md: 16px;
      --space-lg: 24px;
      --space-xl: 32px;
      --space-2xl: 48px;
      --space-3xl: 64px;
      --space-4xl: 80px;
      --space-5xl: 120px;
      
      /* Transitions */
      --transition-fast: 0.3s cubic-bezier(0.55, 0.45, 0.16, 1);
      --transition-base: 0.6s cubic-bezier(0.55, 0.45, 0.16, 1);
      --transition-slow: 1.2s cubic-bezier(0.55, 0.45, 0.16, 1);
      --transition-extra-slow: 1.8s cubic-bezier(0.55, 0.45, 0.16, 1);
      
      /* GSAP-specific easings */
      --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in-out-expo: cubic-bezier(0.87, 0, 0.13, 1);
      --ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
      --ease-in-out-smooth: cubic-bezier(0.76, 0, 0.24, 1);
      
      /* Z-index layers */
      --z-background: 1;
      --z-content: 2;
      --z-overlay: 5;
      --z-nav: 10;
      --z-modal: 100;
      
      /* Layout */
      --nav-height: 80px;
      --container-max-width: 2000px;
      --grid-gap: 24px;
    }

    /* ----------------------------------------
       Base Reset & Global Styles
       ---------------------------------------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 87.5%; /* 14px base */
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-roboto-mono);
      color: var(--color-text-primary);
      background: var(--color-bg);
      line-height: 1.4;
      overflow-x: hidden;
      width: 100%;
      position: relative;
      cursor: default;
    }

    /* Custom cursor for specific elements */
    body.has-custom-cursor {
      cursor: none;
    }

    /* Hide scrollbar but keep functionality */
    ::-webkit-scrollbar {
      display: none;
    }

    html {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Typography defaults */
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-koulen);
      font-weight: 400;
      line-height: 0.83em;
      letter-spacing: 0.02em;
    }

    p {
      font-family: var(--font-roboto-mono);
      font-size: 14px;
      line-height: 1.4;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: color var(--transition-fast);
    }

    img {
      display: block;
      max-width: 100%;
      height: auto;
    }

    /* Selection styling */
    ::selection {
      background: var(--color-accent-gold);
      color: var(--color-bg);
    }

    ::-moz-selection {
      background: var(--color-accent-gold);
      color: var(--color-bg);
    }

    /* ----------------------------------------
       GSAP Animation Base Classes
       ---------------------------------------- */
    .gsap-fade-in {
      opacity: 0;
      will-change: opacity, transform;
    }

    .gsap-slide-up {
      opacity: 0;
      transform: translateY(50px);
      will-change: opacity, transform;
    }

    .gsap-slide-down {
      opacity: 0;
      transform: translateY(-50px);
      will-change: opacity, transform;
    }

    .gsap-slide-left {
      opacity: 0;
      transform: translateX(50px);
      will-change: opacity, transform;
    }

    .gsap-slide-right {
      opacity: 0;
      transform: translateX(-50px);
      will-change: opacity, transform;
    }

    .gsap-scale-in {
      opacity: 0;
      transform: scale(0.95);
      will-change: opacity, transform;
    }

    .gsap-blur-in {
      opacity: 0;
      filter: blur(10px);
      will-change: opacity, filter;
    }

    .gsap-rotate-in {
      opacity: 0;
      transform: rotate(5deg) scale(0.95);
      will-change: opacity, transform;
    }

    /* Stagger children containers */
    .gsap-stagger > * {
      opacity: 0;
      transform: translateY(30px);
      will-change: opacity, transform;
    }

    /* ----------------------------------------
       Parallax Sections
       ---------------------------------------- */
    .parallax-section {
      position: relative;
      overflow: hidden;
      will-change: transform;
    }

    .parallax-bg {
      position: absolute;
      top: -20%;
      left: 0;
      width: 100%;
      height: 140%;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      will-change: transform;
      z-index: var(--z-background);
    }

    .parallax-content {
      position: relative;
      z-index: var(--z-content);
      transform: translateZ(0);
      backface-visibility: hidden;
    }

    /* Background pattern removed */

    /* ===== VIDEO BACKGROUND OVERLAY SYSTEM ===== */
.page-video-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  pointer-events: none;
}

.page-dark-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
  background: linear-gradient(#0000 0%, #000 34.9539%);
  pointer-events: none;
}

    /* ----------------------------------------
       Hero Section - Enhanced with Character Animations
       ---------------------------------------- */
    .hero {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 600px;
      padding-top: 200px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: #000;
    }

    @media (max-width: 809.98px) {
      .hero {
        padding-top: 150px;
      }
    }

    .hero-letter-wrap {
      position: relative;
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 60px;
    }

    .hero-letter {
      font-family: var(--font-koulen);
      line-height: 0.7em;
      color: var(--color-text-primary);
      white-space: nowrap;
      font-size: 670px;
    }

    .letter-char {
      display: inline-block;
      opacity: 0.001;
      transform: translateX(0px) translateY(10px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg);
    }

    /* Hero subtitle with character animations */
    .hero-subtitle {
      position: relative;
      z-index: 2;
      text-align: center;
      max-width: 800px;
      padding: 0 40px;
    }

    .hero-tagline {
      font-family: var(--font-roboto-mono);
      font-size: 18px;
      line-height: 1.6;
      color: var(--color-text-primary);
      opacity: 0.8;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }

    .tagline-word {
      display: flex;
      gap: 2px;
    }

    /* Responsive sizes */
    @media (min-width: 2000px) { .hero-letter { font-size: 940px; } }
    @media (min-width: 1500px) and (max-width: 1999px) { .hero-letter { font-size: 670px; } }
    @media (min-width: 1200px) and (max-width: 1499px) { .hero-letter { font-size: 500px; } }
    @media (min-width: 810px) and (max-width: 1199px) { .hero-letter { font-size: 400px; } }
    @media (max-width: 809.98px) { 
      .hero-letter { font-size: 280px; }
      .hero-tagline { font-size: 16px; }
      .hero-subtitle { padding: 0 20px; }
    }

    /* ----------------------------------------
       About Section
       ---------------------------------------- */
    .about-section {
      background: var(--color-bg);
      color: var(--color-text-primary);
      padding: 100px var(--space-lg);
      position: relative;
    }

    .about-content {
      max-width: 1200px;
      margin: 0 auto;
    }

    .about-description {
      margin-bottom: 80px;
      text-align: center; /* Center align the description */
    }

    .about-lead {
      font-family: var(--font-koulen);
      font-size: clamp(60px, 8vw, 120px);
      line-height: 0.9;
      color: var(--color-text-primary);
      margin-bottom: 20px;
    }

    .about-subline {
      font-family: var(--font-roboto-mono);
      font-size: 24px;
      color: var(--color-text-primary);
      opacity: 0.8;
    }

    .about-script {
      font-family: var(--font-pinyon);
      font-style: italic;
      color: var(--color-accent-gold);
      font-size: 28px;
    }

    .about-bio {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 60px;
      align-items: start;
    }

    .bio-title {
      font-family: var(--font-koulen);
      font-size: 24px;
      color: var(--color-text-primary);
      margin: 0;
    }

    .bio-text p {
      font-family: var(--font-roboto-mono);
      font-size: 16px;
      line-height: 1.6;
      color: var(--color-text-primary);
      margin-bottom: 20px;
      opacity: 0.9;
      text-align: justify; /* Justify the text */
      text-justify: inter-word; /* Use inter-word justification */
    }

    .bio-text h3 {
      font-family: var(--font-koulen);
      font-size: 20px;
      color: var(--color-text-primary);
      margin: 32px 0 12px 0;
    }

    .bio-text h3:first-child {
      margin-top: 0;
    }

    .bio-text ul {
      margin: 16px 0;
      padding-left: 20px;
    }

    .bio-text li {
      font-family: var(--font-roboto-mono);
      font-size: 15px;
      line-height: 1.5;
      color: var(--color-text-primary);
      opacity: 0.9;
      margin-bottom: 8px;
    }

    .bio-text strong {
      color: var(--color-accent-gold);
      font-weight: normal;
    }

    /* Animation transitions for all sections */
    .about-description,
    .about-bio,
    .about-experience,
    .about-education,
    .about-achievements,
    .about-interests {
      opacity: 0;
      transform: translateY(40px);
      transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .about-description.visible,
    .about-bio.visible,
    .about-experience.visible,
    .about-education.visible,
    .about-achievements.visible,
    .about-interests.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Staggered animations for sections */
    .about-bio { transition-delay: 0.2s; }
    .about-experience { transition-delay: 0.4s; }
    .about-education { transition-delay: 0.6s; }
    .about-achievements { transition-delay: 0.8s; }
    .about-interests { transition-delay: 1.0s; }

    /* Parallax effect for bio text */
    .bio-text {
      opacity: 0;
      transform: translateY(30px) translateX(-20px);
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .bio-text.visible {
      opacity: 1;
      transform: translateY(0) translateX(0);
    }

    /* Staggered paragraph animations */
    .bio-text p {
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .bio-text.visible p {
      opacity: 0.9;
      transform: translateY(0);
    }

    /* Staggered paragraph delays */
    .bio-text.visible p:nth-child(1) { transition-delay: 0.1s; }
    .bio-text.visible p:nth-child(2) { transition-delay: 0.2s; }
    .bio-text.visible p:nth-child(3) { transition-delay: 0.3s; }
    .bio-text.visible p:nth-child(4) { transition-delay: 0.4s; }
    .bio-text.visible p:nth-child(5) { transition-delay: 0.5s; }
    .bio-text.visible p:nth-child(6) { transition-delay: 0.6s; }
    .bio-text.visible p:nth-child(7) { transition-delay: 0.7s; }

    /* Bio meta title animations */
    .bio-meta {
      opacity: 0;
      transform: translateX(-30px);
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .bio-meta.visible {
      opacity: 1;
      transform: translateX(0);
    }

    /* Heading animations */
    .bio-text h3 {
      opacity: 0;
      transform: translateY(15px) scale(0.95);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .bio-text.visible h3 {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* List animations */
    .bio-text ul {
      opacity: 0;
      transform: translateX(-20px);
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .bio-text.visible ul {
      opacity: 1;
      transform: translateX(0);
    }

    .bio-text li {
      opacity: 0;
      transform: translateX(-15px);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .bio-text.visible li {
      opacity: 0.9;
      transform: translateX(0);
    }

    /* Staggered list item animations */
    .bio-text.visible li:nth-child(1) { transition-delay: 0.05s; }
    .bio-text.visible li:nth-child(2) { transition-delay: 0.1s; }
    .bio-text.visible li:nth-child(3) { transition-delay: 0.15s; }
    .bio-text.visible li:nth-child(4) { transition-delay: 0.2s; }
    .bio-text.visible li:nth-child(5) { transition-delay: 0.25s; }
    .bio-text.visible li:nth-child(6) { transition-delay: 0.3s; }
    .bio-text.visible li:nth-child(7) { transition-delay: 0.35s; }

    /* New sections styling */
    .about-experience,
    .about-education,
    .about-achievements,
    .about-interests {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 60px;
      align-items: start;
      margin-top: 40px; /* Reduced from 80px */
      margin-bottom: 20px; /* Added bottom margin reduction */
    }

    .about-experience:first-of-type,
    .about-education:first-of-type,
    .about-achievements:first-of-type,
    .about-interests:first-of-type {
      margin-top: 60px;
    }

    @media (max-width: 809.98px) {
      .about-section {
        padding: 60px var(--space-md);
      }
      
      .about-bio,
      .about-experience,
      .about-education,
      .about-achievements,
      .about-interests {
        grid-template-columns: 1fr;
        gap: 30px;
      }
      
      .about-lead {
        font-size: 48px;
      }
    }

    /* ----------------------------------------
       Immersive Section - Enhanced Design
       ---------------------------------------- */
    .immersive {
      background-color: var(--color-bg-light, #1a1a1a);
      color: var(--color-text-secondary, #ffffff);
      padding: 120px var(--space-lg, 80px);
      position: relative;
      overflow: hidden;
      display: block; /* Ensure it's displayed */
      visibility: visible; /* Ensure it's visible */
      opacity: 1; /* Ensure it's not transparent */
    }

    .immersive::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.1) 0%, transparent 50%);
      pointer-events: none;
    }

    .immersive-container {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .immersive-header {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 400px; /* 5x more spacing between numbers and title */
      align-items: center;
      margin-bottom: 80px;
    }

    .immersive-numbers {
      display: flex;
      gap: 5px;
      font-family: var(--font-koulen);
      font-size: 64px;
      color: var(--color-text-secondary);
      align-items: center;
    }

    .num {
      font-family: var(--font-koulen);
      display: inline-block;
    }

    .num-bracket {
      font-family: var(--font-roboto);
      font-size: 56px;
    }

    .num-dash {
      font-size: 56px;
      font-family: var(--font-roboto);
    }

    .immersive-title {
      border-left: 2px solid rgba(255,255,255,0.2);
      padding-left: 30px; /* Reduced padding for better alignment */
    }

    .immersive-heading {
      font-family: var(--font-koulen);
      font-size: clamp(48px, 6vw, 80px);
      line-height: 0.9;
      color: var(--color-text-secondary);
      margin: 0 0 10px 0;
      text-align: left;
    }

    .immersive-subheading {
      font-family: var(--font-koulen);
      font-size: clamp(36px, 4vw, 60px);
      line-height: 0.9;
      color: var(--color-text-secondary);
      margin: 0;
      text-align: left;
      opacity: 0.8;
    }

    .immersive-content {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 60px; /* Increased gap for better spacing */
      align-items: start; /* Align to top for better visual flow */
      position: relative;
      z-index: 2;
      opacity: 1;
      visibility: visible;
    }

    .immersive-stats {
      display: flex;
      gap: 60px; /* Back to original spacing */
      justify-content: center;
      position: relative;
      z-index: 2;
      opacity: 1;
      visibility: visible;
    }

    .stat-item {
      text-align: center;
      opacity: 1;
      visibility: visible;
    }

    .stat-number {
      display: block;
      font-family: var(--font-koulen);
      font-size: clamp(48px, 6vw, 72px);
      line-height: 1;
      color: var(--color-text-secondary);
      margin-bottom: 10px;
    }

    .stat-label {
      display: block;
      font-family: var(--font-roboto-mono);
      font-size: 16px;
      color: var(--color-text-secondary);
      opacity: 0.8;
    }

    .immersive-description {
      font-family: var(--font-roboto-mono, 'Courier New', monospace);
      font-size: 18px;
      line-height: 1.8; /* Increased line height for better spacing */
