      font-size: 14px;
      color: var(--color-text-secondary);
      letter-spacing: 0.05em;
    }

    .timeline-dot {
      width: 12px;
      height: 12px;
      background-color: #2bdb00;
      border-radius: 50%;
      transition: transform var(--transition-base);
      box-shadow: 0 0 0 rgba(43, 219, 0, 0.4);
