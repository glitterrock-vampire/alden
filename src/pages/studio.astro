---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
---

<!-- HTML Template -->
<Layout title="ALDEN | Studio" description="ALDEN is a multidisciplinary studio working at the intersection of technology, visual design, and brand systems.">
  <Nav currentPage="studio" />
  
  <!-- Hero Section -->
  <section class="hero">
    <!-- Hero Background -->
    <div class="page-video-bg">
      <div class="page-dark-overlay"></div>
    </div>
    
    <!-- Hero title -->
    <div class="hero-letter-wrap">
      <div class="hero-main-word">
        <span class="hero-letter" data-letter="S" data-index="0">S</span>
        <span class="hero-letter" data-letter="T" data-index="1">T</span>
        <span class="hero-letter" data-letter="U" data-index="2">U</span>
        <span class="hero-letter" data-letter="D" data-index="3">D</span>
        <span class="hero-letter" data-letter="I" data-index="4">I</span>
        <span class="hero-letter" data-letter="O" data-index="5">O</span>
      </div>
    </div>
  </section>

  <!-- Studio Description Section -->
  <section class="studio-section">
    <div class="studio-content">
      <div class="studio-description">
        <h2 class="studio-title">ALDEN is a multidisciplinary studio working at the intersection of technology, visual design, brand systems, and photography.</h2>
        
        <p class="studio-subtitle">The practice focuses on building thoughtful digital products, scalable systems, creative work, and visual storytelling that connect technology with real-world experiences.</p>
        
        <p class="studio-text">With experience contributing to enterprise platforms, modern digital infrastructure, and professional photography services, the studio approaches every project with clarity, precision, and long-term thinking.</p>
        
        <p class="studio-text">Technology, design, photography, and systems working together to create quietly powerful digital experiences and captured moments.</p>
        
        <p class="studio-location" style="color: var(--token-accent-gold);">Based in Jamaica. Working globally.</p>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Intersection Observer Animation Script -->
  <script>
    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', () => {
      console.log('Initializing Intersection Observer animations...');
      
      // Add initial delay before any animations start
      setTimeout(() => {
        // Animate small word first
        const smallWord = document.querySelector('.hero-small-word');
        if (smallWord) {
          smallWord.style.opacity = '1';
          smallWord.style.transform = 'translateY(0)';
        }
        
        // Then animate main word letters
        const heroLetters = document.querySelectorAll('.hero-letter');
        heroLetters.forEach((letter, index) => {
          setTimeout(() => {
            letter.style.opacity = '1';
            letter.style.transform = 'translateX(0px) translateY(0px) scale(1)';
          }, 800 + index * 100); // Start after small word animation
        });
      }, 500);
    });
  </script>
</Layout>

<style>
  /* Hero Section Styles */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  
  .page-dark-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }

  .hero-letter-wrap {
    position: absolute;
    bottom: 0;
    left: 0; 
    right: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px; /* Spacing between "the" and main word */
    padding: 0 40px; /* Add horizontal padding to prevent edge clipping */
  }

  .hero-small-word {
    font-family: var(--font-koulen);
    font-size: 80px;
    color: var(--color-text-primary);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(-20px);
    animation: hero-small-word-in 0.6s cubic-bezier(0.77,0.02,0.38,1) forwards;
    animation-delay: 0.5s;
  }

  .hero-main-word {
    display: flex;
    gap: 12px; /* Proper spacing between letters */
  }

  .hero-letter {
    font-family: var(--font-koulen);
    line-height: 0.7em;
    color: var(--color-text-primary);
    /* Responsive sizes from work page */
    font-size: 670px;
    display: inline-block;
    opacity: 0;
    transform: translateY(-230px);
    animation: hero-letter-in 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
  }

  /* Staggered animation delays for each letter - matching work page */
  .hero-letter:nth-child(1) { animation-delay: 0.8s; }
  .hero-letter:nth-child(2) { animation-delay: 0.9s; }
  .hero-letter:nth-child(3) { animation-delay: 1.0s; }
  .hero-letter:nth-child(4) { animation-delay: 1.1s; }
  .hero-letter:nth-child(5) { animation-delay: 1.2s; }
  .hero-letter:nth-child(6) { animation-delay: 1.3s; }

  @keyframes hero-letter-in { 
    to { 
      opacity: 1;
      transform: translateY(0); 
    } 
  }

  @keyframes hero-small-word-in { 
    to { 
      opacity: 1;
      transform: translateY(0); 
    } 
  }

  /* Responsive breakpoints from work page */
  @media (min-width: 2000px) { 
    .hero-letter { font-size: 940px; }
    .hero-small-word { font-size: 120px; }
  }
  @media (min-width: 1500px) and (max-width: 1999px) { 
    .hero-letter { font-size: 670px; }
    .hero-small-word { font-size: 80px; }
  }
  @media (min-width: 1200px) and (max-width: 1499px) { 
    .hero-letter { font-size: 350px; }
    .hero-small-word { font-size: 60px; }
  }
  @media (min-width: 810px)  and (max-width: 1199px) { 
    .hero-letter { font-size: 189px; }
    .hero-small-word { font-size: 50px; }
  }
  @media (max-width: 809px)  { 
    .hero-letter { font-size: 120px; }
    .hero-small-word { font-size: 40px; }
    .hero-letter-wrap { gap: 15px; }
  }

  .letter-char {
    display: inline-block;
    opacity: 0.001;
    transform: translateX(0px) translateY(10px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* Studio Section Styles */
  .studio-section {
    padding: 120px 0;
    position: relative;
    z-index: 2;
  }

  .studio-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .studio-description {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .studio-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 40px;
    color: var(--token-text-primary);
  }

  .studio-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 300;
    line-height: 1.4;
    margin-bottom: 30px;
    color: var(--token-text-secondary);
  }

  .studio-text {
    font-size: clamp(1.1rem, 2.5vw, 1.25rem);
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 25px;
    color: var(--token-text-secondary);
  }

  .studio-location {
    font-size: clamp(1.1rem, 2.5vw, 1.25rem);
    font-weight: 300;
    line-height: 1.6;
    margin-top: 40px;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero-small-word {
      font-size: 40px;
    }

    .hero-letter {
      font-size: 100px;
    }

    .hero-main-word {
      gap: 5px;
    }

    .studio-section {
      padding: 80px 0;
    }

    .studio-content {
      padding: 0 20px;
    }

    .studio-title {
      margin-bottom: 30px;
    }

    .studio-subtitle {
      margin-bottom: 25px;
    }

    .studio-text {
      margin-bottom: 20px;
    }

    .studio-location {
      margin-top: 30px;
    }
  }
</style>
