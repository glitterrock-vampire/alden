---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

// Define construction services
const CONSTRUCTION_SERVICES = [
  {
    name: "Steel Frame Homes",
    description: "Durable and affordable steel frame construction",
    price: "From $XXk",
    bedrooms: "1-3 BR",
    timeline: "3-4 months",
    features: ["Earthquake resistant", "Energy efficient", "Low maintenance", "Customizable designs"],
    status: "coming-soon"
  },
  {
    name: "Container Homes",
    description: "Modern container home conversions",
    price: "From $XXk",
    bedrooms: "Studio-2BR",
    timeline: "2-3 months",
    features: ["Sustainable materials", "Quick construction", "Portable design", "Modern finishes"],
    status: "coming-soon"
  },
  {
    name: "Blueprint Packages",
    description: "DIY home building plans and materials",
    price: "From $XXX",
    bedrooms: "Various",
    timeline: "DIY timeline",
    features: ["Detailed plans", "Material lists", "Construction guide", "Support consultation"],
    status: "available"
  }
];

// Define waitlist benefits
const WAITLIST_BENEFITS = [
  "Early bird pricing discounts",
  "Priority access to first homes",
  "Exclusive design previews",
  "Regular construction updates",
  "Invitation to launch events"
];
---

<Layout title="ALDEN BUILD | Affordable Homes" description="Affordable homes for Jamaica - steel frames, container homes, and blueprint packages. Coming 2026. Join our waitlist for updates.">
  <Nav currentPage="build" />
  
  <!-- Hero Section -->
  <section class="build-hero">
    <!-- Hero Background -->
    <div class="page-video-bg">
      <div class="page-dark-overlay"></div>
    </div>
    
    <!-- Hero title -->
    <div class="hero-letter-wrap">
      <div class="hero-main-word">
        <span class="hero-letter" data-letter="B" data-index="0">B</span>
        <span class="hero-letter" data-letter="U" data-index="1">U</span>
        <span class="hero-letter" data-letter="I" data-index="2">I</span>
        <span class="hero-letter" data-letter="L" data-index="3">L</span>
        <span class="hero-letter" data-letter="D" data-index="4">D</span>
      </div>
    </div>
  </section>

  <!-- Build Header -->
  <section class="build-header">
    <div class="section-container">
      <div class="header-content">
        <h2 class="page-title">ALDEN BUILD</h2>
        <p class="page-subtitle">Affordable Homes · Steel Frames · Coming 2026</p>
        <p class="page-description">Affordable homes for Jamaica. Steel frames, container homes, and blueprint packages designed for modern living. Building the future of Jamaican housing with sustainable, cost-effective solutions.</p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="services-section">
    <div class="section-container">
      <h2 class="section-title">Home Types</h2>
      
      <div class="services-grid">
        {CONSTRUCTION_SERVICES.map((service, index) => (
          <div class="service-card" data-service-index={index}>
            <div class="service-status">
              {service.status === 'coming-soon' ? (
                <span class="status-badge coming-soon">Coming Soon</span>
              ) : (
                <span class="status-badge available">Available</span>
              )}
            </div>
            <h3 class="service-name">{service.name}</h3>
            <p class="service-description">{service.description}</p>
            <div class="service-details">
              <div class="detail-item">
                <span class="detail-label">Price:</span>
                <span class="detail-value">{service.price}</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Bedrooms:</span>
                <span class="detail-value">{service.bedrooms}</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Timeline:</span>
                <span class="detail-value">{service.timeline}</span>
              </div>
            </div>
            <div class="service-features">
              {service.features.map((feature, featureIndex) => (
                <div class="feature-item" data-feature-index={featureIndex}>
                  <span class="checkmark">+</span>
                  <span class="feature-text">{feature}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Waitlist Section -->
  <section class="waitlist-section">
    <div class="section-container">
      <h2 class="section-title">Join Our Waitlist</h2>
      
      <div class="waitlist-content">
        <div class="waitlist-info">
          <p class="waitlist-description">Be the first to know when ALDEN BUILD launches. Get exclusive access to early bird pricing and priority home selection.</p>
          
          <div class="benefits-list">
            {WAITLIST_BENEFITS.map((benefit, index) => (
              <div class="benefit-item">
                <span class="benefit-number">{index + 1}</span>
                <span class="benefit-text">{benefit}</span>
              </div>
            ))}
          </div>
        </div>
        
        <div class="waitlist-form">
          <form class="signup-form" action="/api/waitlist" method="POST">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" required>
            </div>
            
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required>
            </div>
            
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone">
            </div>
            
            <div class="form-group">
              <label for="home-type">Preferred Home Type</label>
              <select id="home-type" name="home-type">
                <option value="">Select a home type</option>
                <option value="steel-frame">Steel Frame Home</option>
                <option value="container">Container Home</option>
                <option value="blueprint">Blueprint Package</option>
                <option value="all">Interested in all options</option>
              </select>
            </div>
            
            <div class="form-group">
              <label for="timeline">Timeline</label>
              <select id="timeline" name="timeline">
                <option value="">Select timeline</option>
                <option value="immediate">Ready now</option>
                <option value="6months">Within 6 months</option>
                <option value="1year">Within 1 year</option>
                <option value="2years">Within 2 years</option>
                <option value="flexible">Flexible</option>
              </select>
            </div>
            
            <div class="form-group">
              <label for="message">Additional Comments</label>
              <textarea id="message" name="message" rows="4"></textarea>
            </div>
            
            <Button type="submit" variant="light" class="submit-button">Join Waitlist</Button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="timeline-section">
    <div class="section-container">
      <h2 class="section-title">Project Timeline</h2>
      
      <div class="timeline-content">
        <div class="timeline-item">
          <div class="timeline-date">2024</div>
          <div class="timeline-content-item">
            <h3>Planning & Design</h3>
            <p>Finalizing home designs, securing permits, and establishing construction partnerships.</p>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-date">2025</div>
          <div class="timeline-content-item">
            <h3>Pilot Program</h3>
            <p>Building first homes, testing construction methods, and refining processes.</p>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-date">2026</div>
          <div class="timeline-content-item">
            <h3>Full Launch</h3>
            <p>Official launch of ALDEN BUILD with full construction capabilities and home deliveries.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="section-container">
      <div class="cta-content">
        <h2 class="cta-title">Ready to Build Your Future?</h2>
        <p class="cta-subtitle">Join our waitlist and be part of Jamaica's affordable housing revolution</p>
        <div class="cta-buttons">
          <Button href="#waitlist" variant="light" class="cta-button primary">Join Waitlist</Button>
          <Button href="/contact" variant="light" class="cta-button secondary">Contact Us</Button>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Animation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Animate hero letters
      const heroLetters = document.querySelectorAll('.hero-letter');
      heroLetters.forEach((letter, index) => {
        setTimeout(() => {
          letter.style.opacity = '1';
          letter.style.transform = 'translateX(0px) translateY(0px) scale(1)';
        }, 800 + index * 100);
      });

      // Animate service cards on scroll
      const serviceObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target;
            const index = parseInt(card.dataset.serviceIndex);
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, index * 100);
            serviceObserver.unobserve(card);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      document.querySelectorAll('.service-card').forEach(card => {
        serviceObserver.observe(card);
      });

      // Handle form submission
      const form = document.querySelector('.signup-form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          // Here you would normally send the data to your backend
          alert('Thank you for joining our waitlist! We\'ll be in touch soon.');
          form.reset();
        });
      }
    });
  </script>
</Layout>

<style>
  /* Hero Section Styles */
  .build-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .page-dark-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }

  .hero-letter-wrap {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 0 40px;
    width: 100%;
  }

  .hero-main-word {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .hero-letter {
    font-family: var(--font-koulen);
    line-height: 0.7em;
    color: var(--token-text-light);
    font-size: 670px;
    display: inline-block;
    opacity: 0;
    transform: translateY(-230px);
    animation: hero-letter-in 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
  }

  .hero-letter:nth-child(1) { animation-delay: 0.8s; }
  .hero-letter:nth-child(2) { animation-delay: 0.9s; }
  .hero-letter:nth-child(3) { animation-delay: 1.0s; }
  .hero-letter:nth-child(4) { animation-delay: 1.1s; }
  .hero-letter:nth-child(5) { animation-delay: 1.2s; }

  @keyframes hero-letter-in { 
    to { 
      opacity: 1;
      transform: translateY(0); 
    } 
  }

  /* Section Container */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Build Header */
  .build-header {
    padding: 120px 0 80px;
    text-align: center;
    background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.8), transparent);
  }

  .header-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-family: var(--font-koulen);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    margin-bottom: 30px;
    color: var(--token-text-primary);
  }

  .page-subtitle {
    font-family: var(--font-roboto-mono);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    color: var(--token-accent-gold);
    margin-bottom: 20px;
  }

  .page-description {
    font-family: var(--font-roboto-mono);
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    line-height: 1.6;
    color: var(--token-text-secondary);
  }

  /* Services Section */
  .services-section {
    padding: 80px 0;
    background: var(--token-bg-dark);
  }

  .section-title {
    font-family: var(--font-koulen);
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
    margin-bottom: 60px;
    color: var(--token-text-primary);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 40px;
  }

  .service-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 40px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s cubic-bezier(0.55, 0.45, 0.16, 1);
  }

  .service-card:hover {
    background: rgba(255,255,255,0.08);
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }

  .service-status {
    margin-bottom: 20px;
  }

  .status-badge {
    font-family: var(--font-roboto-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 12px;
    border-radius: 20px;
    display: inline-block;
  }

  .coming-soon {
    background: rgba(255, 152, 0, 0.2);
    color: #ff9800;
    border: 1px solid rgba(255, 152, 0, 0.3);
  }

  .available {
    background: rgba(76, 175, 80, 0.2);
    color: #4caf50;
    border: 1px solid rgba(76, 175, 80, 0.3);
  }

  .service-name {
    font-family: var(--font-koulen);
    font-size: 24px;
    margin-bottom: 16px;
    color: var(--token-text-primary);
  }

  .service-description {
    font-family: var(--font-roboto-mono);
    font-size: 16px;
    line-height: 1.6;
    color: var(--token-text-secondary);
    margin-bottom: 24px;
  }

  .service-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .detail-label {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-text-secondary);
  }

  .detail-value {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-accent-gold);
    font-weight: bold;
  }

  .service-features {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .checkmark {
    color: var(--token-accent-gold);
    font-size: 16px;
    font-weight: bold;
  }

  .feature-text {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-text-secondary);
  }

  /* Waitlist Section */
  .waitlist-section {
    padding: 80px 0;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.02), transparent);
  }

  .waitlist-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .waitlist-description {
    font-family: var(--font-roboto-mono);
    font-size: 18px;
    line-height: 1.8;
    color: var(--token-text-secondary);
    margin-bottom: 40px;
  }

  .benefits-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .benefit-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: rgba(255,255,255,0.05);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .benefit-number {
    font-family: var(--font-koulen);
    font-size: 24px;
    color: var(--token-accent-gold);
    opacity: 0.8;
    min-width: 30px;
  }

  .benefit-text {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-text-secondary);
  }

  /* Form Styles */
  .waitlist-form {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 40px;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-group label {
    display: block;
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-text-secondary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 8px;
    padding: 12px 16px;
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-text-primary);
    transition: all 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--token-accent-gold);
    background: rgba(255,255,255,0.15);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .submit-button {
    width: 100%;
    text-align: center;
  }

  /* Timeline Section */
  .timeline-section {
    padding: 80px 0;
    background: var(--token-bg-dark);
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .timeline-item {
    display: flex;
    gap: 40px;
    align-items: start;
  }

  .timeline-date {
    font-family: var(--font-koulen);
    font-size: 24px;
    color: var(--token-accent-gold);
    min-width: 100px;
    text-align: right;
  }

  .timeline-content-item {
    flex: 1;
    padding: 20px;
    background: rgba(255,255,255,0.05);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .timeline-content-item h3 {
    font-family: var(--font-koulen);
    font-size: 20px;
    margin-bottom: 12px;
    color: var(--token-text-primary);
  }

  .timeline-content-item p {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    line-height: 1.6;
    color: var(--token-text-secondary);
  }

  /* CTA Section */
  .cta-section {
    padding: 120px 0;
    text-align: center;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.02), transparent);
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: var(--font-koulen);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 20px;
    color: var(--token-text-primary);
  }

  .cta-subtitle {
    font-family: var(--font-roboto-mono);
    font-size: 18px;
    margin-bottom: 40px;
    color: var(--token-text-secondary);
  }

  .cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    min-width: 180px;
  }

  .cta-button.secondary {
    background: transparent;
    border: 1px solid var(--token-text-primary);
  }

  .cta-button.secondary:hover {
    background: rgba(255,255,255,0.1);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-letter {
      font-size: 120px;
    }

    .hero-main-word {
      gap: 5px;
    }

    .build-header,
    .services-section,
    .waitlist-section,
    .timeline-section,
    .cta-section {
      padding: 60px 0;
    }

    .section-container {
      padding: 0 20px;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .service-card {
      padding: 30px 24px;
    }

    .waitlist-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .waitlist-form {
      padding: 30px 24px;
    }

    .timeline-item {
      flex-direction: column;
      gap: 20px;
    }

    .timeline-date {
      text-align: left;
      min-width: auto;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .cta-button {
      width: 100%;
      max-width: 300px;
    }
  }
</style>
