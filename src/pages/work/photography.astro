---
// src/pages/work/photography.astro
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

interface PhotoProject {
  id: number;
  title: string;
  category: string;
  href: string;
  image: string;
  imageW: number;
  imageH: number;
  comingSoon?: boolean;
  liveUrl?: string;
}

// PHOTO letters for animated hero text
const PHOTO_LETTERS = ["P", "H", "O", "T", "O"];

const photoProjects: PhotoProject[] = [
  { id:1, title:"JAMAICA LANDSCAPES",           category:"NATURE PHOTOGRAPHY",          href:"https://example.com",         image:"https://framerusercontent.com/images/o6w4CVRNseGWbrL67Z02tHFMU.png",   imageW:1628, imageH:1119, comingSoon:true },
  { id:2, title:"PORTRAIT SESSIONS",         category:"PORTRAIT PHOTOGRAPHY",      href:"https://example.com",       image:"https://framerusercontent.com/images/XbAyT67MOmZ9iWY72g8FEkEZZFM.png", imageW:2718, imageH:1810, comingSoon:true },
  { id:3, title:"URBAN EXPLORATION",                category:"STREET PHOTOGRAPHY",   href:"https://example.com",               image:"https://framerusercontent.com/images/jGIDW70qyfBuP6v8UKUwumU8HGo.png", imageW:1628, imageH:1119, comingSoon:true },
  { id:4, title:"WEDDING STORIES",            category:"EVENT PHOTOGRAPHY",    href:"https://example.com",           image:"https://framerusercontent.com/images/Dqg69EBbfiJJHyD2a4T7Ki7uPuc.png", imageW:1628, imageH:1119, comingSoon:true },
  { id:5, title:"PRODUCT PHOTOGRAPHY",           category:"COMMERCIAL",     href:"https://example.com",           image:"https://framerusercontent.com/images/fKFKHb1VZsz50W8Ctq7RIZW4SRw.png", imageW:1628, imageH:1119, comingSoon:true },
];
---

<Layout
  title="ALDEN Photo Studio"
  description="Photography work by ALDEN Photo Studio, capturing moments through professional photography services."
>
  <Nav currentPage="work" />
  
  <!-- Animated Grain Overlay -->
  <div class="grain-overlay"></div>

  <!-- ─── HERO ─────────────────────────────────────────────────── -->
  <section class="hero" id="hero">
    <!-- Hero Background -->
    <div class="page-video-bg" id="pageVideoBg">
      <div class="page-dark-overlay"></div>
      
      <div class="page-video-wrap" id="pageVideoWrap">
        <video
          src="https://framerusercontent.com/assets/WTjKqrn8HNXvDANMM6KjIZoIHI.mp4"
          muted playsinline preload="auto"
          class="page-video"
        ></video>
      </div>
    </div>

    <!-- Giant "PHOTO" letters -->
    <div class="hero-letter-wrap">
      {PHOTO_LETTERS.map((letter, index) => (
        <span class="hero-letter" data-letter={letter} data-index={index}>
          {letter}
        </span>
      ))}
    </div>
  </section>

  <!-- ─── CREAM SECTION ────────────────────────────────────────────────── -->
  <section class="cream-section" style="padding-top: 120px;">

    <!-- Horizontal scroll gallery -->
    <div class="hscroll-outer" id="hscrollOuter">
      <div class="hscroll-sticky">
        <div class="hscroll-track" id="hscrollTrack">
          {photoProjects.map((p) => (
            <div
              class={`card${p.comingSoon ? " card--soon" : ""}`}
              data-project-id={p.id}
              aria-label={p.title}
            >
              <div class="card-bg">
                {p.liveUrl ? (
                  <iframe
                    src={p.liveUrl}
                    title={`${p.title} Live Preview`}
                    loading="lazy"
                    class="card-live-preview"
                    sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                    referrerpolicy="no-referrer"
                    allowfullscreen
                  ></iframe>
                ) : (
                  <img
                    src={`${p.image}?scale-down-to=1024&width=${p.imageW}&height=${p.imageH}`}
                    width={p.imageW} height={p.imageH}
                    loading={p.id <= 3 ? "eager" : "lazy"}
                    alt={`${p.title} project`}
                    class="card-bg-img"
                  />
                )}
              </div>
              <div class="card-labels">
                <div class="card-labels-inner">
                  <span class="card-category">{p.category}</span>
                  <span class="card-title">{p.title}</span>
                </div>
              </div>
              {p.comingSoon && (
                <div class="card-soon-badge">
                  <span>COMING SOON</span>
                </div>
              )}
              {p.liveUrl && (
                <div class="card-live-link">
                  <a href={p.liveUrl} target="_blank" rel="noopener noreferrer">
                    VIEW LIVE →
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT PHOTO STUDIO SECTION ─────────────────────────────────────── -->
  <section class="capabilities-section" style="background: var(--cream); padding: 120px 0;">
    <div class="capabilities-container">
      <div class="capabilities-header">
        <h2 class="capabilities-title">ALDEN Photo Studio</h2>
        <p class="capabilities-subtitle">Professional photography services capturing life's precious moments</p>
      </div>
      
      <div class="capabilities-grid">
        <div class="capability-item">
          <h3>Nature & Landscape</h3>
          <p>Capturing the beauty of Jamaica's natural landscapes, from mountains to coastlines.</p>
        </div>
        <div class="capability-item">
          <h3>Portrait Photography</h3>
          <p>Professional portrait sessions that capture personality and emotion.</p>
        </div>
        <div class="capability-item">
          <h3>Event Coverage</h3>
          <p>Comprehensive event photography for weddings, corporate events, and special occasions.</p>
        </div>
        <div class="capability-item">
          <h3>Commercial Photography</h3>
          <p>Product and commercial photography that showcases your business in the best light.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CONTACT SECTION ───────────────────────────────────────────────── -->
  <section class="contact-section" style="padding: 80px 0; text-align: center;">
    <div class="contact-container">
      <h2 style="font-family: var(--ff-disp); font-size: clamp(32px, 4vw, 48px); margin-bottom: 20px;">Interested in a photoshoot?</h2>
      <p style="font-family: var(--ff-mono); font-size: 18px; color: var(--dark); opacity: 0.8; margin-bottom: 40px;">Get in touch to discuss your photography needs</p>
      <a href="mailto:contact@alden.com" style="font-family: var(--ff-mono); font-size: 16px; color: var(--gold); text-decoration: none; border: 1px solid var(--gold); padding: 12px 24px; transition: all 0.3s ease;">
        CONTACT US
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Base styles from work page */
  .hero-letter {
    font-family: var(--font-koulen);
    font-size: 600px;
    line-height: 0.8;
    color: var(--token-text-light);
    white-space: nowrap;
    will-change: transform;
    display: inline-block;
    opacity: 0.001;
    transform: translateY(-230px);
    animation: hero-letter-in 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
    transition: all 0.8s cubic-bezier(0.55, 0.45, 0.16, 1);
  }

  @keyframes hero-letter-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
  }

  .hero-letter-wrap {
    position: absolute;
    top: 32%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    z-index: 3;
  }

  .page-video-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }

  .page-dark-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.8) 100%);
    z-index: 1;
  }

  .page-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 110vw;
    height: 110vh;
    object-fit: cover;
    transform: translate(-50%, -50%);
    filter: blur(15px);
  }

  .grain-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('data:image/svg+xml;base64,');
    opacity: 0.15;
    pointer-events: none;
    z-index: 2;
  }

  .cream-section {
    background: var(--cream);
    position: relative;
    z-index: 3;
  }

  .hscroll-outer {
    position: relative;
    height: 100vh;
    overflow-x: hidden;
  }

  .hscroll-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-x: auto;
    overflow-y: hidden;
    display: flex;
    align-items: center;
  }

  .hscroll-track {
    display: flex;
    gap: 40px;
    padding: 0 40px;
    min-width: fit-content;
  }

  .card {
    width: 400px;
    height: 500px;
    background: var(--dark);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }

  .card-bg {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .card-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-labels {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  }

  .card-labels-inner {
    color: var(--cream);
  }

  .card-category {
    font-family: var(--ff-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
  }

  .card-title {
    font-family: var(--ff-disp);
    font-size: 24px;
    margin-top: 5px;
  }

  .card--soon {
    opacity: 0.8;
  }

  .card-soon-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--gold);
    color: var(--dark);
    padding: 8px 16px;
    border-radius: 4px;
    font-family: var(--ff-mono);
    font-size: 12px;
    font-weight: bold;
  }

  /* Photo-specific styles */
  .hero-letter:nth-child(1) { animation-delay: 0.6s; }
    .hero-letter:nth-child(2) { animation-delay: 0.75s; }
    .hero-letter:nth-child(3) { animation-delay: 0.9s; }
    .hero-letter:nth-child(4) { animation-delay: 1.05s; }
    .hero-letter:nth-child(5) { animation-delay: 1.2s; }

  /* Responsive breakpoints matching main ALDEN page */
  @media (min-width: 2000px) { .hero-letter { font-size: 940px; } }
  @media (min-width: 1500px) and (max-width: 1999px) { .hero-letter { font-size: 670px; } }
  @media (min-width: 1200px) and (max-width: 1499px) { .hero-letter { font-size: 470px; } }
  @media (min-width: 810px) and (max-width: 1199px) { .hero-letter { font-size: 350px; } }
  @media (max-width: 809px) { 
    .hero-letter { 
      font-size: 120px;
      transform: none;
    } 
  }

  .capabilities-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .capabilities-header {
    text-align: center;
    margin-bottom: 80px;
  }

  .capabilities-title {
    font-family: var(--ff-disp);
    font-size: clamp(48px, 8vw, 72px);
    line-height: 0.9em;
    color: var(--dark);
    margin-bottom: 20px;
  }

  .capabilities-subtitle {
    font-family: var(--ff-mono);
    font-size: 18px;
    color: var(--dark);
    opacity: 0.7;
    max-width: 600px;
    margin: 0 auto;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
  }

  .capability-item h3 {
    font-family: var(--ff-disp);
    font-size: 24px;
    color: var(--dark);
    margin-bottom: 12px;
  }

  .capability-item p {
    font-family: var(--ff-mono);
    font-size: 16px;
    color: var(--dark);
    opacity: 0.8;
    line-height: 1.6;
  }

  .contact-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media (max-width: 809px) {
    .capabilities-container,
    .contact-container {
      padding: 0 20px;
    }
    
    .capabilities-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>

<script>
  // Video frame-by-frame animation (like work page)
  const pageVideoBg = document.getElementById('pageVideoBg');
  const pageVideoWrap = document.getElementById('pageVideoWrap');
  
  if (pageVideoBg && pageVideoWrap) {
    const video = pageVideoWrap.querySelector('.page-video');
    
    if (video) {
      let videoLoaded = false;
      let lastTargetTime = 0;
      let seekTimeout = null;
      
      // Prepare video
      video.currentTime = 0;
      video.playbackRate = 1.0;
      video.muted = true;
      video.loop = false;
      video.preload = 'auto';
      
      // Video loaded handler
      video.addEventListener('loadeddata', () => {
        videoLoaded = true;
      });
      
      // Frame-by-frame animation on scroll
      window.addEventListener('scroll', () => {
        if (videoLoaded && video.duration) {
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const scrollProgress = Math.min(1, Math.max(0, window.pageYOffset / maxScroll));
          const targetTime = scrollProgress * video.duration;
          
          // Only seek if target time changed significantly
          const timeDiff = Math.abs(targetTime - lastTargetTime);
          if (timeDiff > 0.1) {
            lastTargetTime = targetTime;
            
            // Clear any pending seek
            if (seekTimeout) {
              clearTimeout(seekTimeout);
            }
            
            // Seek to target frame with optimized performance
            seekTimeout = setTimeout(() => {
              const currentTimeDiff = Math.abs(video.currentTime - targetTime);
              if (currentTimeDiff > 0.03) {
                video.currentTime = targetTime;
                lastTargetTime = targetTime;
              }
            }, 8); // 120fps for smoother animation
          }
        }
      });
    }
  }
  
  // Horizontal scroll gallery
  const hscrollOuter = document.getElementById('hscrollOuter');
  const hscrollTrack = document.getElementById('hscrollTrack');
  
  if (hscrollOuter && hscrollTrack) {
    // Calculate total width of all cards
    const cards = hscrollTrack.querySelectorAll('.card');
    let totalWidth = 0;
    
    cards.forEach(card => {
      totalWidth += card.offsetWidth + 40; // card width + gap
    });
    
    // Set track width
    hscrollTrack.style.width = `${totalWidth}px`;
    
    // Horizontal scroll on vertical scroll
    window.addEventListener('scroll', () => {
      const scrolled = window.pageYOffset;
      const hscrollTop = hscrollOuter.offsetTop;
      const windowHeight = window.innerHeight;
      const hscrollHeight = hscrollOuter.offsetHeight;
      
      // Check if we're in the hscroll section
      if (scrolled + windowHeight > hscrollTop && scrolled < hscrollTop + hscrollHeight) {
        // Calculate scroll progress
        const progress = (scrolled - hscrollTop) / (hscrollHeight - windowHeight);
        const maxScroll = totalWidth - window.innerWidth + 80; // 80 for padding
        
        // Apply horizontal scroll
        const scrollX = Math.max(0, Math.min(progress * maxScroll, maxScroll));
        hscrollOuter.querySelector('.hscroll-sticky').scrollLeft = scrollX;
      }
    });
  }
  
  // Hero letter animations with performance optimization
  const heroLetters = document.querySelectorAll('.hero-letter');
  
  // Animate hero letters on page load matching CORE timing
  setTimeout(() => {
    heroLetters.forEach((letter, index) => {
      setTimeout(() => {
        letter.style.opacity = '1';
        letter.style.transform = 'translateX(0px) translateY(0px) scale(1)';
      }, 600 + index * 100); // Match CORE exactly
    });
  }, 600); // Match CORE initial delay
</script>
