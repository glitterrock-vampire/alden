<script>
/* ═══════════════════════════════════════════════════════════════════
   SCROLL-BASED VIDEO CONTROL
   Video plays frame-by-frame based on scroll position for parallax effect
═══════════════════════════════════════════════════════════════════ */
(function initVideoScroll() {
  const pageVideoBg = document.getElementById('pageVideoBg') as HTMLElement;
  const videoWrap   = document.getElementById('pageVideoWrap') as HTMLElement;
  const video       = document.querySelector('.page-video') as HTMLVideoElement;
  if (!pageVideoBg || !videoWrap || !video) return;

  let ticking   = false;
  let animated  = false;
  let lastSY    = 0;
  let videoLoaded = false;
  let lastVideoTime = 0;
  let seekTimeout = null;
  let lastTargetTime = 0;
  let frameCount = 0;
  let lastFrameTime = performance.now();
  let fps = 60; // Target FPS for work page

  // Enhanced video preparation with production optimizations
  function prepareVideo() {
    video.currentTime = 0;
    video.playbackRate = 1.0;
    video.muted = true;
    video.loop = false;
    
    // Production: Add video preloading for better performance
    video.preload = 'auto';
    
    // Production: Optimize for different devices
    const isLowEndDevice = navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4;
    const isSlowConnection = navigator.connection && navigator.connection.effectiveType && 
                            ['slow-2g', '2g', '3g'].includes(navigator.connection.effectiveType);
    
    if (isLowEndDevice || isSlowConnection) {
      // Reduce performance demands on slower devices
      video.playbackRate = 0.8;
    }
    
    // Preload video frames
    if ('requestVideoFrameCallback' in video) {
      video.requestVideoFrameCallback(() => {
        videoLoaded = true;
      });
    } else {
      videoLoaded = true;
    }
  }

  // Wait for video to load metadata
  video.addEventListener('loadedmetadata', prepareVideo);
  
  // Fallback if metadata doesn't load
  setTimeout(() => {
    if (!videoLoaded && video.readyState >= 2) {
      prepareVideo();
    }
  }, 1000);

  function apply() {
    ticking = false;
    const sy = window.scrollY;
    lastSY = sy;

    // Video: no parallax movement, only scale animation
    const scale = animated ? 1 : 1.1;
    if (animated) {
      videoWrap.style.transform = 'none';
    } else {
      videoWrap.style.transform = `scale(${scale})`;
    }
    
    // Enhanced video playback control
    if (videoLoaded && video.duration) {
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const scrollProgress = Math.min(1, Math.max(0, sy / maxScroll));
      const targetTime = scrollProgress * video.duration;
      
      // Only seek if target time changed significantly
      const timeDiff = Math.abs(targetTime - lastTargetTime);
      if (timeDiff > 0.1) { // Increased threshold for production stability
        lastTargetTime = targetTime;
        
        // Clear any pending seek
        if (seekTimeout) {
          clearTimeout(seekTimeout);
        }
        
        // Optimized seek with production-friendly frame rate
        seekTimeout = setTimeout(() => {
          const currentTimeDiff = Math.abs(video.currentTime - targetTime);
          if (currentTimeDiff > 0.05) { // Increased threshold for better performance
            video.currentTime = targetTime;
            lastVideoTime = targetTime;
            frameCount++;
          }
        }, 16); // 60fps update rate for better production performance
      }
    }
  }

  function onScroll() {
    // FPS throttling for better performance
    const now = performance.now();
    const elapsed = now - lastFrameTime;
    const targetFrameTime = 1000 / fps; // 16.67ms for 60fps
    
    if (!ticking && elapsed >= targetFrameTime) {
      requestAnimationFrame(apply);
      ticking = true;
      lastFrameTime = now;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });

  // After zoom animation finishes, hand control fully to JS
  setTimeout(() => {
    animated = true;
    videoWrap.style.animation = 'none';
    videoWrap.style.transform = 'none';
  }, 3900);

  apply();
})();

/* ═══════════════════════════════════════════════════════════════════
   HORIZONTAL SCROLL
   Sets hscroll-outer height dynamically so the sticky track scrolls
   through the full horizontal distance.
═══════════════════════════════════════════════════════════════════ */
(function initHScroll() {
  const track = document.getElementById('hscrollTrack') as HTMLElement;
  const outer = document.getElementById('hscrollOuter') as HTMLElement;
  if (!track || !outer) return;

  function resize() {
    const extra = Math.max(0, track.scrollWidth - window.innerWidth);
    outer.style.height = `${extra + window.innerHeight}px`;
  }

  function update() {
    const outerTop = outer.offsetTop;
    const outerH   = parseFloat(outer.style.height) || 0;
    const sy       = window.scrollY;
    const progress = (sy - outerTop) / (outerH - window.innerHeight);
    const clamped  = Math.max(0, Math.min(1, progress));
    const maxTX    = track.scrollWidth - window.innerWidth;
    // Slow down scroll speed by using a factor (0.7 = 30% slower)
    const scrollFactor = 0.7;
    track.style.transform = `translate3d(${-clamped * maxTX * scrollFactor}px, 0, 0)`;
  }

  resize();
  window.addEventListener('resize', () => { resize(); update(); }, { passive: true });
  window.addEventListener('scroll', update, { passive: true });
  update();
})();

/* ═══════════════════════════════════════════════════════════════════
   SCROLL-REVEAL: Capabilities list items (staggered)
═══════════════════════════════════════════════════════════════════ */
(function initCaps() {
  const io = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    }),
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.cap-item').forEach(el => io.observe(el));
})();

/* ═══════════════════════════════════════════════════════════════════
   SCROLL-REVEAL: Footer COME/say/HELLO + Chinese chars
═══════════════════════════════════════════════════════════════════ */
(function initFooterReveal() {
  const come    = document.getElementById('footerCome');
  const chinese = document.querySelector('.footer-chinese-wrap');
  if (!come) return;

  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      document.getElementById('footerCome')  ?.classList.add('visible');
      document.getElementById('footerSay')   ?.classList.add('visible');
      document.getElementById('footerHello') ?.classList.add('visible');
      chinese?.classList.add('visible');
      io.unobserve(e.target);
    });
  }, { threshold: 0.2 });

  io.observe(come);
})();

/* ═══════════════════════════════════════════════════════════════════
   BACK TO TOP
═══════════════════════════════════════════════════════════════════ */
document.getElementById('backToTop')?.addEventListener('click', () => {
  window.scrollTo({ top: 0, behavior: 'smooth' });
});
</script>