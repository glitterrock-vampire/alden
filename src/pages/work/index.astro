<script>
/* ═══════════════════════════════════════════════════════════════════
   PARALLAX
   Mirrors Framer Motion's scroll-linked transform on the bg container.
   
   Layout.astro scrolls to top on DOMContentLoaded — good, ensures
   parallax starts from scrollY=0.
   
   Two layers:
   - heroBg (the 330vh container):  translateY at 0.15× scroll
   - heroVideoWrap (the video):     translateY at 0.4× scroll
     → video moves slower than page = parallax depth illusion
   
   After the CSS zoom-in animation completes (2.6s + 1.2s = 3.8s),
   JS takes over the scale so CSS and JS don't fight.
═══════════════════════════════════════════════════════════════════ */
(function initParallax() {
  const heroBg    = document.getElementById('heroBg') as HTMLElement;
  const videoWrap = document.getElementById('heroVideoWrap') as HTMLElement;
  const heroEl    = document.getElementById('hero') as HTMLElement;
  if (!heroBg || !videoWrap || !heroEl) return;

  let ticking   = false;
  let animated  = false;  // becomes true after CSS zoom finishes
  let lastSY    = 0;

  function apply() {
    ticking = false;
    const sy = window.scrollY;
    lastSY = sy;

    if (sy > heroEl.offsetHeight * 1.5) return;

    // Bg container: subtle drift
    heroBg.style.transform = `translate3d(0, ${sy * 0.15}px, 0)`;

    // Video: faster parallax (moves up slower than page scroll)
    const scale = animated ? 1 : 1.1;
    videoWrap.style.transform = `translate3d(0, ${sy * 0.4}px, 0) scale(${scale})`;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(apply);
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });

  // After zoom animation finishes, hand control fully to JS
  // delay = 2.6s + duration 1.2s + small buffer = 3.9s
  setTimeout(() => {
    animated = true;
    // Remove the CSS animation so JS transform is sole authority
    videoWrap.style.animation = 'none';
    videoWrap.style.transform = `translate3d(0, ${lastSY * 0.4}px, 0) scale(1)`;
  }, 3900);

  apply();
})();

/* ═══════════════════════════════════════════════════════════════════
   HORIZONTAL SCROLL
   Sets hscroll-outer height dynamically so the sticky track scrolls
   through the full horizontal distance.
═══════════════════════════════════════════════════════════════════ */
(function initHScroll() {
  const track = document.getElementById('hscrollTrack') as HTMLElement;
  const outer = document.getElementById('hscrollOuter') as HTMLElement;
  if (!track || !outer) return;

  function resize() {
    const extra = Math.max(0, track.scrollWidth - window.innerWidth);
    outer.style.height = `${extra + window.innerHeight}px`;
  }

  function update() {
    const outerTop = outer.offsetTop;
    const outerH   = parseFloat(outer.style.height) || 0;
    const sy       = window.scrollY;
    const progress = (sy - outerTop) / (outerH - window.innerHeight);
    const clamped  = Math.max(0, Math.min(1, progress));
    const maxTX    = track.scrollWidth - window.innerWidth;
    track.style.transform = `translate3d(${-clamped * maxTX}px, 0, 0)`;
  }

  resize();
  window.addEventListener('resize', () => { resize(); update(); }, { passive: true });
  window.addEventListener('scroll', update, { passive: true });
  update();
})();

/* ═══════════════════════════════════════════════════════════════════
   SCROLL-REVEAL: FEATURED / PROJECTS labels
   Blur-in from bottom — same pattern as Framer's whileInView
═══════════════════════════════════════════════════════════════════ */
(function initTitleReveal() {
  const els = [
    document.getElementById('featuredStack'),
    document.getElementById('projectsStack'),
  ].filter(Boolean) as HTMLElement[];

  els.forEach(el => {
    el.style.cssText += `
      opacity: 0.001;
      filter: blur(10px);
      transform: translateY(10px);
      transition: opacity 0.7s cubic-bezier(0.44,0,0.56,1),
                  filter  0.7s cubic-bezier(0.44,0,0.56,1),
                  transform 0.7s cubic-bezier(0.44,0,0.56,1);
    `;
  });

  const io = new IntersectionObserver(entries => {
    entries.forEach((e, i) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      setTimeout(() => {
        el.style.opacity   = '1';
        el.style.filter    = 'blur(0px)';
        el.style.transform = 'translateY(0)';
      }, i * 100);
      io.unobserve(el);
    });
  }, { threshold: 0.1 });

  els.forEach(el => io.observe(el));
})();

/* ═══════════════════════════════════════════════════════════════════
   SCROLL-REVEAL: Capabilities list items (staggered)
═══════════════════════════════════════════════════════════════════ */
(function initCaps() {
  const io = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    }),
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.cap-item').forEach(el => io.observe(el));
})();

/* ═══════════════════════════════════════════════════════════════════
   SCROLL-REVEAL: Footer COME/say/HELLO + Chinese chars
═══════════════════════════════════════════════════════════════════ */
(function initFooterReveal() {
  const come    = document.getElementById('footerCome');
  const chinese = document.querySelector('.footer-chinese-wrap');
  if (!come) return;

  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      document.getElementById('footerCome')  ?.classList.add('visible');
      document.getElementById('footerSay')   ?.classList.add('visible');
      document.getElementById('footerHello') ?.classList.add('visible');
      chinese?.classList.add('visible');
      io.unobserve(e.target);
    });
  }, { threshold: 0.2 });

  io.observe(come);
})();

/* ═══════════════════════════════════════════════════════════════════
   BACK TO TOP
═══════════════════════════════════════════════════════════════════ */
document.getElementById('backToTop')?.addEventListener('click', () => {
  window.scrollTo({ top: 0, behavior: 'smooth' });
});
</script>