---
// src/pages/work.astro
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

interface Project {
  id: number;
  title: string;
  category: string;
  href: string;
  image: string;
  imageW: number;
  imageH: number;
  comingSoon?: boolean;
  liveUrl?: string;
}

// WORK letters for animated hero text
const WORK_LETTERS = ["W", "O", "R", "K"];

const projects: Project[] = [
  { id:1,  title:"CDT JAMAICA",           category:"DIGITAL PLATFORM",          href:"https://cdtjamaica.org",         image:"https://framerusercontent.com/images/o6w4CVRNseGWbrL67Z02tHFMU.png",   imageW:1628, imageH:1119, liveUrl:"https://cdtjamaica.org" },
  { id:2,  title:"TOTALLY BAKED",         category:"E-COMMERCE",      href:"https://totally-baked-ja.vercel.app",       image:"https://framerusercontent.com/images/XbAyT67MOmZ9iWY72g8FEkEZZFM.png", imageW:2718, imageH:1810, liveUrl:"https://totally-baked-ja.vercel.app" },
  { id:3,  title:"ZENITH TEAS",                category:"TEA MANAGEMENT",   href:"https://zenith-taupe.vercel.app",               image:"https://framerusercontent.com/images/jGIDW70qyfBuP6v8UKUwumU8HGo.png", imageW:1628, imageH:1119, liveUrl:"https://zenith-taupe.vercel.app" },
  { id:4,  title:"GLOWING LANDING",            category:"LANDING PAGE",    href:"https://glowing-landing-page.netlify.app",           image:"https://framerusercontent.com/images/Dqg69EBbfiJJHyD2a4T7Ki7uPuc.png", imageW:1628, imageH:1119, liveUrl:"https://glowing-landing-page.netlify.app" },
  { id:5,  title:"BLACKBOX SYSTEM",           category:"IOT SYSTEM",     href:"https://blackbox-online.vercel.app",           image:"https://framerusercontent.com/images/fKFKHb1VZsz50W8Ctq7RIZW4SRw.png", imageW:1628, imageH:1119, liveUrl:"https://blackbox-online.vercel.app" },
];
---

<Layout
  title="Work — ALDEN"
  description="Selected work by ALDEN, Sr Software Developer currently at IBM iX."
>
  <Nav currentPage="work" />
  
  <!-- Animated Grain Overlay -->
  <div class="grain-overlay"></div>

  <!-- ─── FULL PAGE VIDEO BACKGROUND ──────────────────────────────────────── -->
  <div class="page-video-bg" id="pageVideoBg">
    <div class="page-dark-overlay"></div>
    
    <div class="page-video-wrap" id="pageVideoWrap">
      <video
        src="https://framerusercontent.com/assets/WTjKqrn8HNXvDANMM6KjIZoIHI.mp4"
        muted playsinline preload="auto"
        class="page-video"
      ></video>
    </div>
  </div>

  <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
  <section class="hero" id="hero">

    <!-- Giant "WORK" letters (fecytw): y -230→0, delay 2.4s -->
    <div class="hero-letter-wrap">
      {WORK_LETTERS.map((letter, index) => (
        <span class="hero-letter" data-letter={letter} data-index={index}>
          {letter}
        </span>
      ))}
    </div>
  </section>

  <!-- ─── CREAM SECTION ────────────────────────────────────────────────── -->
  <section class="cream-section" style="padding-top: 120px;">

    <!-- Horizontal scroll gallery -->
    <div class="hscroll-outer" id="hscrollOuter">
      <div class="hscroll-sticky">
        <div class="hscroll-track" id="hscrollTrack">
          {projects.map((p) => (
            <div
              class={`card${p.comingSoon ? " card--soon" : ""}`}
              data-project-id={p.id}
              aria-label={p.title}
            >
              <div class="card-bg">
                {p.liveUrl ? (
                  <iframe
                    src={p.liveUrl}
                    title={`${p.title} Live Preview`}
                    loading="lazy"
                    class="card-live-preview"
                    sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                    referrerpolicy="no-referrer"
                    allowfullscreen
                  ></iframe>
                ) : (
                  <img
                    src={`${p.image}?scale-down-to=1024&width=${p.imageW}&height=${p.imageH}`}
                    width={p.imageW} height={p.imageH}
                    loading={p.id <= 3 ? "eager" : "lazy"}
                    alt={`${p.title} project`}
                    class="card-bg-img"
                  />
                )}
              </div>
              <div class="card-labels">
                <span class={`card-title-text ${p.id === 1 ? 'cdt-title' : ''}`}>{p.title}</span>
                <span class="card-category-text">{p.category}</span>
              </div>
              {p.comingSoon && <div class="card-soon">COMING SOON</div>}
              {p.liveUrl && (
                <a href={p.liveUrl} target="_blank" class="card-live-link">
                  <span class="live-link-text">VIEW LIVE SITE →</span>
                </a>
              )}
            </div>
          ))}
          <!-- Spacer tile for better scroll visibility of last item -->
          <div class="card-spacer"></div>
        </div>
      </div>
    </div>

    </section>

  <Footer />
</Layout>

<!-- ─────────────────────────────────────────────────────────────────────
     STYLES
     Note: Layout.astro's global `* { transition: 0.3s }` rule would
     interfere with the precisely-timed CSS animations below. We cancel
     it for every animated element with `transition: none` inside the
     .loading class (already done by Layout) and re-declare our own
     transition values explicitly so they always win via specificity.
──────────────────────────────────────────────────────────────────────── -->
<style is:global>
  /* ── Albert Sans (not preloaded by Layout) ──────────────────────────── */
  @import url('https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,400;0,500;1,400&display=swap');

  /* ── Design tokens (supplement Layout / global.css) ─────────────────── */
  :root {
    --cream:     #e7e5df;
    --cream-50:  #e7e5df80;
    --gold:      #FFD700; /* Changed from grey to gold */
    --gold-dk:   #8a7432;
    --gold-warm: rgb(213, 197, 148);
    --dark:      #ffffff; /* Changed from dark to white for text */
    --black:     #000000;
    --ff-disp:   'Koulen', sans-serif;
    --ff-mono:   'Roboto Mono', monospace;
    --ff-body:   'Albert Sans', sans-serif;
    --ff-cjk:    "HanyiSentyFoundation Regular", "PingFang SC", "Noto Serif CJK SC", serif;
    
    /* Footer background variables */
    --token-bg-light: #ffffff;
    --token-text-light: #ffffff;
    --token-text-dark: #333333;
    --token-accent-gold: #ccbb87;
  }

  /* Disable Layout's blanket transition on every animated element
     so our precise CSS keyframe timings are not delayed/cancelled. */
  /* Hero entrance elements — CSS @keyframes handle timing, NOT transitions */
  .hero-bg,
  .hero-video-wrap,
  .hero-blur-layer,
  .hero-letter {
    transition: none !important;
  }

  /* Scroll-revealed elements — JS sets explicit transitions on them;
     Layout's blanket rule must not pre-fire before JS applies opacity. */
  .title-featured-stack,
  .title-projects {
    opacity: 0.001;
  }
  .footer-greet-line,
  .footer-chinese {
    /* Initial hidden state — JS reveals via .visible class */
    opacity: 1 !important;
  }

  /* ===== ANIMATED GRAIN OVERLAY ===== */
.grain-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
  opacity: 0.01;
  background-image: 
    radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0),
    radial-gradient(circle at 2px 2px, rgba(255,255,255,0.2) 1px, transparent 0),
    radial-gradient(circle at 3px 3px, rgba(255,255,255,0.1) 1px, transparent 0);
  background-size: 50px 50px, 30px 30px, 20px 20px;
  background-position: 0 0, 10px 10px, 20px 20px;
  animation: grain-move 8s steps(10) infinite;
  filter: blur(0.5px);
  mix-blend-mode: overlay;
}

@keyframes grain-move {
  0%, 100% {
    transform: translate(0, 0);
    background-position: 0 0, 10px 10px, 20px 20px;
  }
  10% {
    transform: translate(-5px, -10px);
    background-position: 5px 5px, 15px 15px, 25px 25px;
  }
  20% {
    transform: translate(-10px, 5px);
    background-position: 10px 10px, 20px 20px, 30px 30px;
  }
  30% {
    transform: translate(5px, -5px);
    background-position: 15px 15px, 25px 25px, 35px 35px;
  }
  40% {
    transform: translate(-15px, -15px);
    background-position: 20px 20px, 30px 30px, 40px 40px;
  }
  50% {
    transform: translate(10px, 10px);
    background-position: 25px 25px, 35px 35px, 45px 45px;
  }
  60% {
    transform: translate(-20px, 5px);
    background-position: 30px 30px, 40px 40px, 50px 50px;
  }
  70% {
    transform: translate(15px, -10px);
    background-position: 35px 35px, 45px 45px, 55px 55px;
  }
  80% {
    transform: translate(-5px, 20px);
    background-position: 40px 40px, 50px 50px, 60px 60px;
  }
  90% {
    transform: translate(25px, -25px);
    background-position: 45px 45px, 55px 55px, 65px 65px;
  }
}
</style>

<style>
/* ═══════════════════════════════════════════════════════════════════
   FULL PAGE VIDEO BACKGROUND
═══════════════════════════════════════════════════════════════════ */
.page-video-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1; /* Push video behind all content */
  pointer-events: none;
}

.page-dark-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
  background: linear-gradient(#0000 0%, #000 34.9539%);
  pointer-events: none;
}

.page-video-wrap {
  position: absolute;
  top: -50px;
  left: -10%;
  width: 120%;
  height: 120%;
  z-index: 1;
  filter: brightness(0.95) blur(12px) saturate(0.7);
  will-change: transform;
  transform-origin: center center;
  transform: scale(1.01);
  animation: page-video-in 1.2s cubic-bezier(0.58,-0.13,0.17,1.02) 2.6s forwards;
  clip-path: inset(50px round 0px);
}

@keyframes page-video-in { to { transform: scale(1); } }

.page-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ═══════════════════════════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════════════════════════ */
.hero {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 600px;
  padding-top: 200px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  background: transparent;
}

@media (--mobile) {
  .hero {
    padding-top: 150px;
  }
}

/* ── Parallax BG container (framer-41kccs)
      330vh tall, absolute top:-79px, will-change:transform
      Entrance: opacity 0.001→1, delay:0.3s, dur:0.5s, ease:[0.44,0,0.56,1] */
.hero-bg {
  position: absolute;
  top: -79px;
  left: 0;
  width: 100%;
  height: 500vh;
  z-index: 2;
  will-change: transform;
  opacity: 0.001;
  animation: hero-bg-in 0.5s cubic-bezier(0.44,0,0.56,1) 0.3s forwards;
}
@keyframes hero-bg-in { to { opacity: 1; } }

/* ── Dark gradient overlay (framer-16z1j8k)
      opacity:0.43, gradient transparent → #000 at 34.95% */
.hero-dark-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
  background: linear-gradient(#0000 0%, #000 34.9539%);
  pointer-events: none;
}

/* ── Video container (framer-azf245-container)
      top:-708px, left:-1.5%, width:103%, height:111%
      filter: brightness(1.01) blur(10px), will-change:transform
      Entrance: scale 1.1→1, delay:0.6s, dur:1.2s, ease:[0.58,-0.13,0.17,1.02] */
.hero-video-wrap {
  position: absolute;
  top: -1000px;
  left: -5%;
  width: 110%;
  height: 120%;
  z-index: 1;
  filter: brightness(1.01) blur(4px);
  will-change: transform;
  transform-origin: center center;
  transform: scale(1.02);
  animation: hero-video-in 1.2s cubic-bezier(0.58,-0.13,0.17,1.02) 0.6s forwards;
  overflow: hidden;
}
@keyframes hero-video-in { to { transform: scale(1); } }

.hero-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0; left: 0;
  display: block;
}

/* ── Blur layer (framer-mlai04)
      scale 1.1→1, delay:1.2s, dur:1.2s, ease:[0.58,-0.13,0.17,1.02]
      (This is the secondary sharpening layer that resolves last) */
.hero-blur-layer {
  position: absolute;
  inset: 0;
  z-index: 1;
  will-change: transform;
  transform: scale(1.1);
  animation: hero-blur-in 1.2s cubic-bezier(0.58,-0.13,0.17,1.02) 1.2s forwards;
  pointer-events: none;
}
@keyframes hero-blur-in { to { transform: scale(1); } }

/* ── Hero letters "WORK" (framer-fecytw)
      y: -230px→0, delay:2.4s, dur:0.9s, ease:[0.77,0.02,0.38,1] */
.hero-letter-wrap {
  position: absolute;
  bottom: 0;
  left: 0; right: 0;
  z-index: 3;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  gap: 12px; /* Proper spacing between letters */
  padding: 0 40px; /* Add horizontal padding to prevent edge clipping */
}
.hero-letter {
  font-family: var(--ff-disp);
  line-height: 0.7em;
  color: var(--cream);
  white-space: nowrap;
  will-change: transform;
  display: inline-block;
  opacity: 0;
  transform: translateY(-230px);
  animation: hero-letter-in 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
  /* Responsive sizes from original breakpoints */
  font-size: 670px;
}

/* Staggered animation delays for each letter - optimized for faster loading */
.hero-letter:nth-child(1) { animation-delay: 0.8s; }
.hero-letter:nth-child(2) { animation-delay: 0.9s; }
.hero-letter:nth-child(3) { animation-delay: 1.0s; }
.hero-letter:nth-child(4) { animation-delay: 1.1s; }

@keyframes hero-letter-in { 
  to { 
    opacity: 1;
    transform: translateY(0); 
  } 
}

@media (min-width: 2000px) { .hero-letter { font-size: 940px; } }
@media (min-width: 1500px) and (max-width: 1999px) { .hero-letter { font-size: 670px; } }
@media (min-width: 1200px) and (max-width: 1499px) { .hero-letter { font-size: 350px; } }
@media (min-width: 810px)  and (max-width: 1199px) { .hero-letter { font-size: 189px; } }
@media (max-width: 809px)  { .hero-letter { font-size: 120px; } }

/* ═══════════════════════════════════════════════════════════════════
   CREAM SECTION
═══════════════════════════════════════════════════════════════════ */
.cream-section {
  background-color: transparent;
  position: relative;
  z-index: 2;
  padding: 50px 24px 0;
}

/* ── Horizontal scroll */
.hscroll-outer {
  width: 100%;
  overflow: visible;
  position: relative;
}
.hscroll-sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-x: auto;
  overflow-y: hidden;
  display: flex;
  align-items: center;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.hscroll-sticky::-webkit-scrollbar {
  display: none;
}
.hscroll-track {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 40px;
  gap: 16px;
  min-width: max-content;
}

/* ── Project cards (framer-l4ka5: 685×528px) */
.card {
  --cw: 560px;
  --ch: 350px; /* 16:10 aspect ratio */
  flex: none;
  width: var(--cw);
  height: var(--ch);
  position: relative;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  /* Override Layout's blanket transition, use our own */
  transition: transform 0.5s cubic-bezier(0.22,1,0.36,1) !important;
}
.card:hover { transform: scale(1.02); }
.card--soon { cursor: not-allowed; }

/* Portrait cards - also 16:10 */
.card:nth-child(5),
.card:nth-child(7) { --cw: 560px; --ch: 350px; }

/* Responsive tile sizes - maintaining 16:10 ratio */
@media (max-width: 1499px) {
  .card { --cw: 480px; --ch: 300px; }
  .card:nth-child(5),
  .card:nth-child(7) { --cw: 480px; --ch: 300px; }
  .card-spacer { --cw: 480px; --ch: 300px; }
}

@media (max-width: 1199px) {
  .card { --cw: 400px; --ch: 250px; }
  .card:nth-child(5),
  .card:nth-child(7) { --cw: 400px; --ch: 250px; }
  .card-spacer { --cw: 400px; --ch: 250px; }
}

/* Spacer tiles - 16:10 aspect ratio */
.card-spacer {
  --cw: 560px;
  --ch: 350px; /* 16:10 aspect ratio */
  flex: none;
  width: var(--cw);
  height: var(--ch);
  position: relative;
  pointer-events: none;
  visibility: hidden;
}

.card-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.85);
  transition: filter 0.45s cubic-bezier(0.22,1,0.36,1),
              opacity 0.45s cubic-bezier(0.22,1,0.36,1) !important;
}
.card-bg-img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: none !important;
}
.card:hover .card-bg {
  filter: blur(10px) brightness(0.5);
  opacity: 0.4;
}
.card--soon .card-bg-img { filter: brightness(0.35) grayscale(0.6); }

/* Foreground mockup (framer-1r8dz0f: 54% wide, 46% tall, top:23.85%, left:23%) */
.card-mockup {
  z-index: 4;
  position: absolute;
  width: 54%;
  height: 46%;
  top: 23.85%;
  left: 23%;
  overflow: hidden;
  opacity: 0;
  box-shadow: 0 32px 80px rgba(0,0,0,0.4), 0 8px 24px rgba(0,0,0,0.2);
  transform: translateY(-16px) scale(0.97);
  transition: opacity 0.45s cubic-bezier(0.22,1,0.36,1),
              transform 0.45s cubic-bezier(0.22,1,0.36,1) !important;
}
.card-mockup-img { width: 100%; height: 100%; object-fit: cover; }
.card:hover .card-mockup {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* Labels (positioned below tiles) */
.card-labels {
  z-index: 5;
  position: absolute;
  bottom: -40px; left: 0; right: 0;
  padding: 0 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 21px;
  pointer-events: none;
}
.card-labels {
  font-family: var(--ff-mono);
  font-size: 14px;
  line-height: 1.4em;
  color: #FFD700 !important; /* Direct gold color with !important */
  white-space: pre;
}
.card-title-text {
      font-family: var(--ff-mono);
      font-size: 14px;
      line-height: 1.4em;
      color: #FFD700 !important; /* Direct gold color with !important */
      white-space: pre;
      transition: color 0.3s ease !important; /* Smooth color transition */
    }
    
    .card:hover .card-title-text {
      color: #FFED4E !important; /* Brighter gold on hover */
    }
/* Gold titles for specific projects */
.liverpool-title,
.esports-title,
.norwegian-title {
      color: #FFD700 !important; /* Changed from grey to gold */
    }
.card-category-text {
      font-family: var(--ff-mono);
      font-size: 14px;
      line-height: 1.4em;
      color: #FFD700 !important; /* Direct gold color with !important */
      opacity: 1; /* Increased opacity for visibility */
      white-space: pre;
      transition: color 0.3s ease !important; /* Smooth color transition */
    }
    
    /* Force all card text to gold with maximum specificity */
    .card .card-labels .card-title-text,
    .card .card-labels .card-category-text,
    .card:hover .card-labels .card-title-text,
    .card:hover .card-labels .card-category-text {
      color: #FFD700 !important;
      opacity: 1 !important;
    }
    
    .card:hover .card-labels .card-title-text,
    .card:hover .card-labels .card-category-text {
      color: #FFED4E !important; /* Brighter gold on hover */
    }
.card-soon {
  position: absolute;
  bottom: 16px; right: 16px;
  z-index: 6;
  font-family: var(--ff-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  color: #FFD700 !important; /* Changed from var(--dark) to gold */
  border: 1px solid rgba(47,47,47,0.35);
  padding: 4px 10px;
  border-radius: 2px;
  background: rgba(231,229,223,0.75);
  backdrop-filter: blur(4px);
}

/* ── CTAs */
.cta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 70px;
  padding: 6px 24px 250px;
}
.cta-link {
  font-family: var(--ff-mono);
  font-size: 12px;
  letter-spacing: 0.12em;
  color: #FFD700 !important; /* Changed from var(--dark) to gold */
  opacity: 0.6;
  position: relative;
  transition: opacity 0.2s ease !important;
}
.cta-link::after {
  content: '';
  position: absolute;
  bottom: -2px; left: 0; right: 0;
  height: 1px;
  background: var(--dark);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s cubic-bezier(0.22,1,0.36,1) !important;
}
.cta-link:hover { opacity: 1; }
.cta-link:hover::after { transform: scaleX(1); }

/* ═══════════════════════════════════════════════════════════════════
   CAPABILITIES
═══════════════════════════════════════════════════════════════════ */
.capabilities-section {
  background-color: var(--cream);
  position: relative;
  z-index: 2;
  margin-top: 400px; /* Adjusted to match original proportions */
  padding: 0 150px; /* Remove top padding */
  padding-bottom: 10px; /* Minimal bottom padding to reduce gap */
}
.capabilities-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 120px;
  max-width: 1400px;
  margin: 0 auto;
}
.capabilities-left {
  flex: none;
  width: 40%;
  display: flex;
  flex-direction: column;
  gap: 60px;
  align-items: flex-start;
}
.cap-intro {
      font-family: var(--ff-body);
      font-size: clamp(28px, 3vw, 52px);
