--- 
import Layout from '../../layouts/Layout.astro';
import WorkSection from '../../components/WorkSection.astro';
import { projects } from '../../data/projects.js';
---

<Layout title="Andre Walters | Work">
<main>
  <!-- Work Section -->
  <WorkSection />
</main>
</Layout>

<style>
  /* Work Section */
  .work {
    background: var(--token-bg-light);
    padding: 50px 24px 500px;
    position: relative;
    z-index: 2;
    margin-top: 250px;
  }

  .work::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://framerusercontent.com/images/rR6HYXBrMmX4cRpXfXUOvpvpB0.png');
    background-repeat: repeat;
    background-size: 256px 256px;
    opacity: 0.05;
    pointer-events: none;
    z-index: -1;
  }

  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 0;
    position: relative;
    background: transparent;
    z-index: 3;
  }

  .work-title {
    font-family: var(--font-koulen);
    font-size: 244px;
    line-height: 0.83;
    color: #ffffff;
  }

  .work-chinese {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    position: sticky;
    top: 0;
  }

  .work-chinese .chinese-char,
  .work-chinese .chinese-bracket {
    font-size: 132px;
    color: var(--token-accent-gold-dark);
    font-family: 'HanyiSentyFoundation Regular', sans-serif;
  }

  .work-subtitle {
    font-family: var(--font-koulen);
    font-size: 244px;
    line-height: 0.83;
    color: #ffffff;
    text-align: right;
  }

  .featured-projects {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    margin-bottom: 80px;
  }

  .featured-projects > * {
    width: 48%;
  }

  .project-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 8px;
  }

  .project-image-container {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 75%; /* 4:3 aspect ratio */
    overflow: hidden;
    border-radius: 8px;
    cursor: pointer;
    background: var(--token-bg-dark);
  }

  .project-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1), filter 0.8s ease;
  }

  .project-image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.3) 100%);
    transition: background 0.8s ease;
  }

  .project-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 30px;
    z-index: 2;
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.8s ease;
  }

  .project-tile-wrapper:hover .project-image {
    transform: scale(1.1);
    filter: brightness(0.4);
  }

  .project-tile-wrapper:hover .project-image-overlay {
    background: linear-gradient(135deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.6) 100%);
  }

  .project-tile-wrapper:hover .project-content {
    transform: translateY(0);
    opacity: 1;
  }

  .project-category {
    font-family: var(--font-roboto-mono);
    font-size: 11px;
    color: white;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
    transform: translateY(10px);
    transition: transform 0.6s ease 0.1s;
  }

  .project-title {
    font-family: var(--font-koulen);
    font-size: 22px;
    line-height: 1.1;
    color: white;
    margin-bottom: 12px;
    transform: translateY(10px);
    transition: transform 0.6s ease 0.15s;
  }

  .project-view {
    font-family: var(--font-roboto-mono);
    font-size: 12px;
    color: white;
    opacity: 0.7;
    transform: translateY(10px);
    transition: transform 0.6s ease 0.2s, opacity 0.6s ease 0.2s;
  }

  .project-tile-wrapper:hover .project-category,
  .project-tile-wrapper:hover .project-title,
  .project-tile-wrapper:hover .project-view {
    transform: translateY(0);
  }

  .project-tile-wrapper:hover .project-view {
    opacity: 1;
  }

  .coming-soon-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--token-accent-gold);
    color: var(--token-bg-dark);
    padding: 8px 12px;
    font-family: var(--font-roboto-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 4px;
    z-index: 3;
  }

  .project-tile-wrapper.coming-soon {
    opacity: 0.7;
  }

  .project-tile-wrapper.coming-soon .project-link {
    cursor: not-allowed;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding: 0 50px;
    margin-top: 40px;
  }

  .project-tile-wrapper {
    position: relative;
    width: 100%;
  }

  .project-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    border-radius: 8px;
  }

  .project-tile-wrapper:hover .project-overlay {
    opacity: 1;
  }

  .overlay-text {
    color: white;
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  .work-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 100px 0 0;
    margin-top: 80px;
  }

  .work-description {
    width: 38%;
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
    color: #ffffff;
  }

  /* Responsive */
  @media (max-width: 1199.98px) and (min-width: 810px) {
    .work-title,
    .work-subtitle {
      font-size: 92px;
    }
    .work-chinese .chinese-char,
    .work-chinese .chinese-bracket {
      font-size: 76px;
    }
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
    .work-footer {
      padding: 20px 0 250px;
    }
    .work-description {
      width: 49%;
      font-size: 12px;
    }
  }

  @media (max-width: 809.98px) {
    .work {
      padding: 75px 16px 0;
    }
    .work-header {
      flex-direction: column;
      align-items: center;
      gap: 21px;
      position: relative;
      top: auto;
      padding: 0;
    }
    .work-title {
      font-size: 90px;
      text-align: center;
      order: 1;
    }
    .work-chinese {
      position: relative;
      height: auto;
      order: 0;
    }
    .work-chinese .chinese-char,
    .work-chinese .chinese-bracket {
      font-size: 80px;
    }
    .work-subtitle {
      font-size: 90px;
      text-align: center;
      order: 3;
    }
    .featured-grid {
      flex-direction: column;
      align-items: center;
      gap: 42px;
      padding: 60px 0 0;
    }
    .featured-grid > * {
      width: 100%;
    }
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 40px 0 0;
    }
    .work-footer {
      padding: 60px 0 100px;
      gap: 29px;
    }
    .work-description {
      width: 100%;
      font-size: 14px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', () => {
    
    // Work section header animation
    gsap.from('.work-header > *', {
      opacity: 0,
      y: 60,
      duration: 1.2,
      ease: 'power3.out',
      stagger: 0.15,
      delay: 0.3
    });

    // Featured projects stagger animation
    gsap.utils.toArray('.featured-projects .project-tile-wrapper').forEach((tile, i) => {
      gsap.from(tile, {
        opacity: 0,
        y: 80,
        scale: 0.95,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: tile,
          start: 'top 85%',
          toggleActions: 'play none none reverse'
        },
        delay: 0.6 + (i * 0.2)
      });
    });

    // Projects grid stagger animation
    gsap.utils.toArray('.projects-grid .project-tile-wrapper').forEach((tile, i) => {
      gsap.from(tile, {
        opacity: 0,
        y: 60,
        scale: 0.9,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: tile,
          start: 'top 90%',
          toggleActions: 'play none none reverse'
        },
        delay: 0.8 + (i * 0.1)
      });
    });

    // Work footer animation
    gsap.from('.work-footer', {
      opacity: 0,
      y: 40,
      duration: 1.2,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.work-footer',
        start: 'top 85%',
        toggleActions: 'play none none reverse'
      }
    });

    // Subtle parallax on background pattern (if exists)
    if (document.querySelector('.bg-pattern')) {
      gsap.to('.bg-pattern', {
        yPercent: -30,
        ease: 'none',
        scrollTrigger: {
          trigger: 'body',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      });
    }

  });
</script>
