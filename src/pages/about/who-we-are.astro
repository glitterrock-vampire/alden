---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Button from '../../components/Button.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="ALDEN | Who Are We" description="Learn about ALDEN Studio - our team, culture, and approach to creating exceptional digital experiences.">
  <Nav currentPage="who-we-are" />
  
  <!-- Hero Section -->
  <section class="hero">
    <!-- Hero Background -->
    <div class="page-video-bg">
      <div class="page-dark-overlay"></div>
    </div>
    
    <!-- Hero title -->
    <div class="hero-letter-wrap">
      <div class="hero-main-word">
        <span class="hero-letter" data-letter="W" data-index="0">W</span>
        <span class="hero-letter" data-letter="H" data-index="1">H</span>
        <span class="hero-letter" data-letter="O" data-index="2">O</span>
      </div>
    </div>
  </section>

  <!-- Studio Overview Section -->
  <section class="studio-overview">
    <div class="studio-content">
      <div class="studio-description">
        <h2 class="studio-title">Who Are We?</h2>
        
        <p class="studio-subtitle">ALDEN is a multidisciplinary studio where technology meets creativity, design meets functionality, and innovation meets purpose.</p>
        
        <p class="studio-text">We are a team of passionate creators, developers, designers, and photographers working at the intersection of digital innovation and visual storytelling. Our approach combines technical expertise with artistic vision to create experiences that are both beautiful and functional.</p>
        
        <p class="studio-text">Based in Jamaica but working globally, we bring diverse perspectives and technical excellence to every project we undertake.</p>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="team-section">
    <div class="section-container">
      <h2 class="section-title">Our Team</h2>
      
      <div class="team-grid">
        <div class="team-member">
          <div class="team-avatar">
            <div class="avatar-placeholder">A</div>
          </div>
          <h3 class="team-name">Alden Wong</h3>
          <p class="team-role">Founder & Creative Director</p>
          <p class="team-description">Leading vision and creative direction across all studio projects, bringing together technology, design, and photography expertise.</p>
        </div>
        
        <!-- Add more team members as they join -->
        <div class="team-member hiring">
          <div class="team-avatar">
            <div class="avatar-placeholder">+</div>
          </div>
          <h3 class="team-name">You?</h3>
          <p class="team-role">Join Our Team</p>
          <p class="team-description">We're always looking for talented individuals who share our passion for creating exceptional digital experiences.</p>
          <Button href="/core" variant="light" class="team-cta">Learn About Joining</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="values-section">
    <div class="section-container">
      <h2 class="section-title">Our Values</h2>
      
      <div class="values-grid">
        <div class="value-item">
          <h3 class="value-title">Innovation</h3>
          <p class="value-description">Pushing boundaries and exploring new possibilities in digital experiences and visual storytelling.</p>
        </div>
        
        <div class="value-item">
          <h3 class="value-title">Precision</h3>
          <p class="value-description">Every pixel, every line of code, every photograph crafted with attention to detail.</p>
        </div>
        
        <div class="value-item">
          <h3 class="value-title">Collaboration</h3>
          <p class="value-description">Working closely with clients to bring their vision to life through partnership.</p>
        </div>
        
        <div class="value-item">
          <h3 class="value-title">Excellence</h3>
          <p class="value-description">Committed to delivering exceptional quality in everything we create.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Culture Section -->
  <section class="culture-section">
    <div class="section-container">
      <h2 class="section-title">Our Culture</h2>
      
      <div class="culture-content">
        <div class="culture-text">
          <p class="studio-text">At ALDEN, we foster a culture of creativity, continuous learning, and mutual respect. We believe that great work comes from happy, motivated people who are passionate about their craft.</p>
          
          <p class="studio-text">Our studio environment encourages experimentation, embraces failure as part of the creative process, and celebrates both individual contributions and collective success.</p>
          
          <p class="studio-text">We're committed to work-life balance, professional development, and creating an inclusive space where diverse perspectives are valued and celebrated.</p>
        </div>
        
        <div class="culture-highlights">
          <div class="highlight-item">
            <h4>Remote-First</h4>
            <p>Flexible work environment with global collaboration</p>
          </div>
          <div class="highlight-item">
            <h4>Continuous Learning</h4>
            <p>Regular skill development and knowledge sharing</p>
          </div>
          <div class="highlight-item">
            <h4>Creative Freedom</h4>
            <p>Space to experiment and innovate</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="cta-section">
    <div class="section-container">
      <div class="cta-content">
        <h2 class="cta-title">Ready to Work With Us?</h2>
        <p class="cta-subtitle">Let's create something extraordinary together</p>
        <Button href="/contact" variant="light" class="cta-button">Get In Touch</Button>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Intersection Observer Animation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        const heroLetters = document.querySelectorAll('.hero-letter');
        heroLetters.forEach((letter, index) => {
          setTimeout(() => {
            letter.style.opacity = '1';
            letter.style.transform = 'translateX(0px) translateY(0px) scale(1)';
          }, 800 + index * 100);
        });
      }, 500);
    });
  </script>
</Layout>

<style>
  /* Hero Section Styles */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .page-dark-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }

  .hero-letter-wrap {
    position: absolute;
    bottom: 0;
    left: 0; 
    right: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 0 40px;
  }

  .hero-main-word {
    display: flex;
    gap: 12px;
  }

  .hero-letter {
    font-family: var(--font-koulen);
    line-height: 0.7em;
    color: var(--color-text-primary);
    font-size: 670px;
    display: inline-block;
    opacity: 0;
    transform: translateY(-230px);
    animation: hero-letter-in 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
  }

  .hero-letter:nth-child(1) { animation-delay: 0.8s; }
  .hero-letter:nth-child(2) { animation-delay: 0.9s; }
  .hero-letter:nth-child(3) { animation-delay: 1.0s; }

  @keyframes hero-letter-in { 
    to { 
      opacity: 1;
      transform: translateY(0); 
    } 
  }

  /* Responsive breakpoints */
  @media (min-width: 2000px) { 
    .hero-letter { font-size: 940px; }
  }
  @media (min-width: 1500px) and (max-width: 1999px) { 
    .hero-letter { font-size: 670px; }
  }
  @media (min-width: 1200px) and (max-width: 1499px) { 
    .hero-letter { font-size: 350px; }
  }
  @media (min-width: 810px) and (max-width: 1199px) { 
    .hero-letter { font-size: 189px; }
  }
  @media (max-width: 809px) { 
    .hero-letter { font-size: 120px; }
    .hero-letter-wrap { gap: 15px; }
  }

  /* Studio Overview Section */
  .studio-overview {
    padding: 120px 0;
    position: relative;
    z-index: 2;
  }

  .studio-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .studio-description {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .studio-title {
    font-family: var(--font-koulen);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 40px;
    color: var(--token-text-primary);
  }

  .studio-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 300;
    line-height: 1.4;
    margin-bottom: 30px;
    color: var(--token-text-secondary);
  }

  .studio-text {
    font-family: var(--font-roboto-mono);
    font-size: clamp(1.1rem, 2.5vw, 1.25rem);
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 25px;
    color: var(--token-text-secondary);
  }

  /* Section Container */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .section-title {
    font-family: var(--font-koulen);
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
    margin-bottom: 60px;
    color: var(--token-text-primary);
  }

  /* Team Section */
  .team-section {
    padding: 120px 0;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.02), transparent);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 60px;
    margin-top: 40px;
  }

  .team-member {
    text-align: center;
    padding: 40px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .team-member:hover {
    background: rgba(255,255,255,0.08);
    transform: translateY(-5px);
  }

  .team-avatar {
    width: 120px;
    height: 120px;
    margin: 0 auto 30px;
    border-radius: 50%;
    background: var(--token-accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-placeholder {
    font-family: var(--font-koulen);
    font-size: 48px;
    color: var(--token-bg-dark);
  }

  .team-name {
    font-family: var(--font-koulen);
    font-size: 24px;
    margin-bottom: 10px;
    color: var(--token-text-primary);
  }

  .team-role {
    font-family: var(--font-roboto-mono);
    font-size: 16px;
    color: var(--token-accent-gold);
    margin-bottom: 20px;
  }

  .team-description {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    line-height: 1.6;
    color: var(--token-text-secondary);
  }

  .team-cta {
    margin-top: 20px;
  }

  /* Values Section */
  .values-section {
    padding: 120px 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    margin-top: 40px;
  }

  .value-item {
    text-align: center;
    padding: 40px 30px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .value-item:hover {
    background: rgba(255,255,255,0.06);
    transform: translateY(-3px);
  }

  .value-title {
    font-family: var(--font-koulen);
    font-size: 20px;
    margin-bottom: 20px;
    color: var(--token-accent-gold);
  }

  .value-description {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    line-height: 1.6;
    color: var(--token-text-secondary);
  }

  /* Culture Section */
  .culture-section {
    padding: 120px 0;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.02), transparent);
  }

  .culture-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 80px;
    align-items: start;
  }

  .culture-highlights {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .highlight-item {
    padding: 30px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .highlight-item:hover {
    background: rgba(255,255,255,0.08);
  }

  .highlight-item h4 {
    font-family: var(--font-koulen);
    font-size: 18px;
    margin-bottom: 10px;
    color: var(--token-text-primary);
  }

  .highlight-item p {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    line-height: 1.6;
    color: var(--token-text-secondary);
  }

  /* CTA Section */
  .cta-section {
    padding: 120px 0;
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: var(--font-koulen);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 20px;
    color: var(--token-text-primary);
  }

  .cta-subtitle {
    font-family: var(--font-roboto-mono);
    font-size: 18px;
    margin-bottom: 40px;
    color: var(--token-text-secondary);
  }

  .cta-button {
    display: inline-block;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .hero-letter {
      font-size: 100px;
    }

    .hero-main-word {
      gap: 5px;
    }

    .studio-overview,
    .team-section,
    .values-section,
    .culture-section,
    .cta-section {
      padding: 80px 0;
    }

    .section-container,
    .studio-content {
      padding: 0 20px;
    }

    .team-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .values-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .culture-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .team-member,
    .value-item {
      padding: 30px 20px;
    }
  }
</style>
