---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="ALDEN SPRINGS | Smart Water Solutions" description="Smart irrigation and water harvesting systems. Coming 2027. Join our early access waitlist for sustainable water management solutions.">
  <Nav currentPage="springs" />
  
  <!-- Hero Section -->
  <section class="springs-hero">
    <!-- Hero Background -->
    <div class="page-video-bg">
      <div class="page-dark-overlay"></div>
    </div>
    
    <!-- Hero title -->
    <div class="hero-letter-wrap">
      <div class="hero-main-word">
        <span class="hero-letter" data-letter="S" data-index="0">S</span>
        <span class="hero-letter" data-letter="P" data-index="1">P</span>
        <span class="hero-letter" data-letter="R" data-index="2">R</span>
        <span class="hero-letter" data-letter="I" data-index="3">I</span>
        <span class="hero-letter" data-letter="N" data-index="4">N</span>
        <span class="hero-letter" data-letter="G" data-index="5">G</span>
        <span class="hero-letter" data-letter="S" data-index="6">S</span>
      </div>
    </div>
  </section>

  <!-- Coming Soon Content -->
  <section class="coming-soon">
    <div class="section-container">
      <div class="coming-soon-content">
        <div class="coming-soon-badge">
          <span class="badge-text">COMING 2027</span>
        </div>
        
        <h2 class="coming-soon-title">ALDEN SPRINGS</h2>
        
        <p class="coming-soon-subtitle">Smart Irrigation · Water Harvesting · Conservation</p>
        
        <p class="coming-soon-description">
          Water tricking & irrigation systems for sustainable farming and residential use. 
          Innovative water management solutions designed for Jamaica's unique climate and needs.
        </p>
        
        <div class="coming-soon-features">
          <div class="feature-item">
            <div class="feature-icon">S</div>
            <h3>Smart Systems</h3>
            <p>Automated irrigation and water monitoring</p>
          </div>
          
          <div class="feature-item">
            <div class="feature-icon">H</div>
            <h3>Harvesting</h3>
            <p>Rainwater collection and storage solutions</p>
          </div>
          
          <div class="feature-item">
            <div class="feature-icon">C</div>
            <h3>Conservation</h3>
            <p>Efficient water usage and recycling systems</p>
          </div>
        </div>
        
        <div class="coming-soon-cta">
          <h3>Join Early Access</h3>
          <p>Be the first to know when we launch. Get exclusive access to early bird pricing and priority installation.</p>
          
          <form class="early-access-form" action="/api/springs-waitlist" method="POST">
            <div class="form-row">
              <input type="text" name="name" placeholder="Full Name" required>
              <input type="email" name="email" placeholder="Email Address" required>
            </div>
            <div class="form-row">
              <input type="tel" name="phone" placeholder="Phone Number">
              <select name="interest" required>
                <option value="">Select Interest</option>
                <option value="residential">Residential</option>
                <option value="farm">Farm/Agricultural</option>
                <option value="commercial">Commercial</option>
                <option value="all">All Solutions</option>
              </select>
            </div>
            <Button type="submit" variant="light" class="submit-button">Join Early Access</Button>
          </form>
        </div>
        
        <div class="coming-soon-timeline">
          <h3>Development Timeline</h3>
          <div class="timeline-items">
            <div class="timeline-item">
              <div class="timeline-year">2025</div>
              <div class="timeline-desc">Research & Development</div>
            </div>
            <div class="timeline-item">
              <div class="timeline-year">2026</div>
              <div class="timeline-desc">Testing & Pilot Programs</div>
            </div>
            <div class="timeline-item">
              <div class="timeline-year">2027</div>
              <div class="timeline-desc">Full Launch</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about-section">
    <div class="section-container">
      <h2 class="section-title">About ALDEN SPRINGS</h2>
      
      <div class="about-content">
        <div class="about-text">
          <p>
            ALDEN SPRINGS is the latest venture in the ALDEN ecosystem, focusing on sustainable water management solutions for Jamaica. 
            Our mission is to address water scarcity challenges through innovative technology and smart irrigation systems.
          </p>
          <p>
            We're developing comprehensive water solutions that combine traditional wisdom with modern technology, 
            ensuring efficient water usage for both residential and agricultural applications.
          </p>
        </div>
        
        <div class="about-vision">
          <h3>Our Vision</h3>
          <p>Creating a water-secure Jamaica through innovative conservation, harvesting, and smart management systems.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section">
    <div class="section-container">
      <div class="contact-content">
        <h2 class="contact-title">Get in Touch</h2>
        <p class="contact-subtitle">Have questions about our water solutions? Want to partner with us?</p>
        
        <div class="contact-info">
          <div class="contact-item">
            <span class="contact-label">Email:</span>
            <span class="contact-value">water@alden.one</span>
          </div>
          <div class="contact-item">
            <span class="contact-label">Phone:</span>
            <span class="contact-value">+1 (876) XXX-XXXX</span>
          </div>
          <div class="contact-item">
            <span class="contact-label">Location:</span>
            <span class="contact-value">Kingston, Jamaica</span>
          </div>
        </div>
        
        <Button href="/contact" variant="light" class="contact-button">Contact Us</Button>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Animation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Animate hero letters
      const heroLetters = document.querySelectorAll('.hero-letter');
      heroLetters.forEach((letter, index) => {
        setTimeout(() => {
          letter.style.opacity = '1';
          letter.style.transform = 'translateX(0px) translateY(0px) scale(1)';
        }, 800 + index * 100);
      });

      // Handle form submission
      const form = document.querySelector('.early-access-form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          alert('Thank you for joining our early access list! We\'ll keep you updated on our progress.');
          form.reset();
        });
      }
    });
  </script>
</Layout>

<style>
  /* Hero Section Styles */
  .springs-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .page-dark-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }

  .hero-letter-wrap {
    position: absolute;
    bottom: 0;
    left: 40px; 
    right: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 20px;
    padding: 0 40px;
  }

  .hero-main-word {
    display: flex;
    gap: 12px;
    justify-content: flex-start;
  }

  .hero-letter {
    font-family: var(--font-koulen);
    line-height: 0.7em;
    color: var(--token-text-light);
    font-size: 670px;
    display: inline-block;
    opacity: 0;
    transform: translateY(-230px);
    animation: hero-letter-in 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
  }

  .hero-letter:nth-child(1) { animation-delay: 0.8s; }
  .hero-letter:nth-child(2) { animation-delay: 0.9s; }
  .hero-letter:nth-child(3) { animation-delay: 1.0s; }
  .hero-letter:nth-child(4) { animation-delay: 1.1s; }
  .hero-letter:nth-child(5) { animation-delay: 1.2s; }

  @keyframes hero-letter-in { 
    to { 
      opacity: 1;
      transform: translateY(0); 
    } 
  }

  /* Section Container */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Coming Soon Section */
  .coming-soon {
    padding: 120px 0;
    text-align: center;
    background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.8), transparent);
  }

  .coming-soon-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .coming-soon-badge {
    margin-bottom: 40px;
  }

  .badge-text {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--token-accent-gold);
    padding: 12px 24px;
    border: 1px solid var(--token-accent-gold);
    border-radius: 30px;
    display: inline-block;
    opacity: 0.8;
  }

  .coming-soon-title {
    font-family: var(--font-koulen);
    font-size: clamp(3rem, 6vw, 5rem);
    margin-bottom: 20px;
    color: var(--token-text-primary);
    letter-spacing: 2px;
  }

  .coming-soon-subtitle {
    font-family: var(--font-roboto-mono);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    color: var(--token-accent-gold);
    margin-bottom: 30px;
    letter-spacing: 1px;
  }

  .coming-soon-description {
    font-family: var(--font-roboto-mono);
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    line-height: 1.8;
    color: var(--token-text-secondary);
    margin-bottom: 60px;
  }

  .coming-soon-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    margin-bottom: 80px;
  }

  .feature-item {
    padding: 40px 30px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    transition: all 0.3s ease;
  }

  .feature-item:hover {
    background: rgba(255,255,255,0.06);
    transform: translateY(-5px);
  }

  .feature-icon {
    font-family: var(--font-koulen);
    font-size: 3rem;
    color: var(--token-accent-gold);
    margin-bottom: 20px;
    opacity: 0.8;
  }

  .feature-item h3 {
    font-family: var(--font-koulen);
    font-size: 1.5rem;
    margin-bottom: 16px;
    color: var(--token-text-primary);
  }

  .feature-item p {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    line-height: 1.6;
    color: var(--token-text-secondary);
  }

  /* Coming Soon CTA */
  .coming-soon-cta {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 50px 40px;
    margin-bottom: 80px;
  }

  .coming-soon-cta h3 {
    font-family: var(--font-koulen);
    font-size: 2rem;
    margin-bottom: 20px;
    color: var(--token-text-primary);
  }

  .coming-soon-cta p {
    font-family: var(--font-roboto-mono);
    font-size: 16px;
    line-height: 1.6;
    color: var(--token-text-secondary);
    margin-bottom: 40px;
  }

  /* Form Styles */
  .early-access-form {
    max-width: 600px;
    margin: 0 auto;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .early-access-form input,
  .early-access-form select {
    width: 100%;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 8px;
    padding: 16px;
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-text-primary);
    transition: all 0.3s ease;
  }

  .early-access-form input:focus,
  .early-access-form select:focus {
    outline: none;
    border-color: var(--token-accent-gold);
    background: rgba(255,255,255,0.15);
  }

  .submit-button {
    width: 100%;
    text-align: center;
  }

  /* Timeline */
  .coming-soon-timeline {
    margin-bottom: 60px;
  }

  .coming-soon-timeline h3 {
    font-family: var(--font-koulen);
    font-size: 1.5rem;
    margin-bottom: 30px;
    color: var(--token-text-primary);
  }

  .timeline-items {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .timeline-item {
    text-align: center;
    padding: 20px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    min-width: 150px;
  }

  .timeline-year {
    font-family: var(--font-koulen);
    font-size: 1.5rem;
    color: var(--token-accent-gold);
    margin-bottom: 10px;
  }

  .timeline-desc {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-text-secondary);
  }

  /* About Section */
  .about-section {
    padding: 80px 0;
    background: var(--token-bg-dark);
  }

  .section-title {
    font-family: var(--font-koulen);
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
    margin-bottom: 60px;
    color: var(--token-text-primary);
  }

  .about-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .about-text {
    margin-bottom: 40px;
  }

  .about-text p {
    font-family: var(--font-roboto-mono);
    font-size: 16px;
    line-height: 1.8;
    color: var(--token-text-secondary);
    margin-bottom: 20px;
  }

  .about-vision {
    padding: 30px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
  }

  .about-vision h3 {
    font-family: var(--font-koulen);
    font-size: 1.5rem;
    margin-bottom: 16px;
    color: var(--token-accent-gold);
  }

  .about-vision p {
    font-family: var(--font-roboto-mono);
    font-size: 16px;
    line-height: 1.6;
    color: var(--token-text-secondary);
  }

  /* Contact Section */
  .contact-section {
    padding: 80px 0;
    text-align: center;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.02), transparent);
  }

  .contact-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-title {
    font-family: var(--font-koulen);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 20px;
    color: var(--token-text-primary);
  }

  .contact-subtitle {
    font-family: var(--font-roboto-mono);
    font-size: 18px;
    margin-bottom: 40px;
    color: var(--token-text-secondary);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
  }

  .contact-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
  }

  .contact-label {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-text-secondary);
  }

  .contact-value {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    color: var(--token-accent-gold);
  }

  .contact-button {
    min-width: 200px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-letter {
      font-size: 120px;
    }

    .hero-main-word {
      gap: 5px;
    }

    .coming-soon,
    .about-section,
    .contact-section {
      padding: 60px 0;
    }

    .section-container {
      padding: 0 20px;
    }

    .coming-soon-features {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .coming-soon-cta {
      padding: 40px 30px;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .timeline-items {
      flex-direction: column;
      gap: 20px;
    }

    .contact-item {
      flex-direction: column;
      gap: 8px;
      text-align: left;
    }
  }
</style>
