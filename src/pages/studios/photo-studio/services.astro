  }

  .portfolio-link {
    text-align: center;
    margin-top: 60px;
  }

  .portfolio-button {
    padding: 20px 40px;
    font-size: 1rem;
    letter-spacing: 1px;
    border-radius: 10px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--token-text-primary);
    text-decoration: none;
