  }

  .portfolio-button:hover {
    background: rgba(255,255,255,0.2);
    transform: translateY(-2px);
  }

  /* Responsive for Photography Grid */
  @media (max-width: 768px) {
    .photography-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .photography-category {
