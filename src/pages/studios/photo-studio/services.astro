---

<Layout title="ALDEN Photo Studio | Services" description="Professional photography services including portraits, events, landscapes, and creative projects.">
  <Nav currentPage="photo-studio" />
  
  <!-- Hero Section -->
  <section class="hero">
    <!-- Hero Background -->
    <div class="page-video-bg">
      <div class="page-dark-overlay"></div>
    </div>
    
    <!-- Hero title -->
    <div class="hero-letter-wrap">
      <div class="hero-main-word hero-top-word">
        <span class="hero-letter" data-letter="P" data-index="0">P</span>
        <span class="hero-letter" data-letter="H" data-index="1">H</span>
        <span class="hero-letter" data-letter="O" data-index="2">O</span>
        <span class="hero-letter" data-letter="T" data-index="3">T</span>
        <span class="hero-letter" data-letter="O" data-index="4">O</span>
      </div>
      <div class="hero-main-word hero-bottom-word">
        <span class="hero-letter" data-letter="S" data-index="5">S</span>
        <span class="hero-letter" data-letter="E" data-index="6">E</span>
        <span class="hero-letter" data-letter="R" data-index="7">R</span>
        <span class="hero-letter" data-letter="V" data-index="8">V</span>
        <span class="hero-letter" data-letter="I" data-index="9">I</span>
        <span class="hero-letter" data-letter="C" data-index="10">C</span>
        <span class="hero-letter" data-letter="E" data-index="11">E</span>
        <span class="hero-letter" data-letter="S" data-index="12">S</span>
      </div>
    </div>
  </section>

  <!-- Services Header -->
  <section class="services-header dark-bg">
    <div class="section-container">
      <div class="header-content">
        <h2 class="page-title">ALDEN Photo Studio Services</h2>
        <p class="page-subtitle">Professional photography services tailored for your vision</p>
        <p class="page-description">From portraits to landscapes, events to creative projects, we capture moments that tell your story. Our photography combines technical excellence with artistic vision to create images that are both beautiful and meaningful.</p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="services-section">
    <div class="section-container">
      <h2 class="section-title">Photography Services</h2>
      
      <div class="photography-grid">
        <!-- Landscapes -->
        <div class="photography-category">
          <div class="category-header">
            <h3 class="category-title">Landscapes</h3>
            <p class="category-subtitle">Natural beauty and scenic environments</p>
          </div>
          <div class="category-details">
            <p class="category-description">Mountains · Oceans · Forests · Sunsets</p>
            <p class="category-info">Capturing the breathtaking beauty of Jamaica's natural landscapes, from majestic mountains to serene ocean views and lush forests.</p>
            <Button href="/studios/photo-studio/portfolio/landscapes" variant="light" class="category-cta">View Landscapes</Button>
          </div>
        </div>
        
        <!-- Portraits -->
        <div class="photography-category">
          <div class="category-header">
            <h3 class="category-title">Portraits</h3>
            <p class="category-subtitle">People and personality captured</p>
          </div>
          <div class="category-details">
            <p class="category-description">Headshots · Lifestyle · Events · Creative</p>
            <p class="category-info">Professional portrait photography that captures the essence of individuals, from corporate headshots to creative lifestyle sessions.</p>
            <Button href="/studios/photo-studio/portfolio/portraits" variant="light" class="category-cta">View Portraits</Button>
          </div>
        </div>
        
        <!-- Events -->
        <div class="photography-category">
          <div class="category-header">
            <h3 class="category-title">Events</h3>
            <p class="category-subtitle">Moments and celebrations documented</p>
          </div>
          <div class="category-details">
            <p class="category-description">Weddings · Corporate · Parties · Concerts</p>
            <p class="category-info">Comprehensive event photography that captures the emotions and special moments of your celebrations and gatherings.</p>
            <Button href="/studios/photo-studio/portfolio/events" variant="light" class="category-cta">View Events</Button>
          </div>
        </div>
      </div>
      
      <div class="portfolio-link">
        <Button href="/studios/photo-studio/portfolio" variant="light" class="portfolio-button">View Photography Portfolio</Button>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section class="portfolio-section">
    <div class="section-container">
      <h2 class="section-title">Our Portfolio</h2>
      <p class="section-subtitle">Explore our photography work and see how we capture moments that tell your story.</p>
      
      <div class="portfolio-grid">
        <div class="portfolio-item">
          <div class="portfolio-preview">
            <div class="preview-placeholder">Landscape Photography</div>
          </div>
          <div class="portfolio-info">
            <h3 class="portfolio-title">Jamaican Landscapes</h3>
            <p class="portfolio-description">Breathtaking natural beauty from mountains to oceans, showcasing Jamaica's diverse landscapes.</p>
            <Button href="/studios/photo-studio/portfolio" variant="light" class="portfolio-link">View Project</Button>
          </div>
        </div>
        
        <div class="portfolio-item">
          <div class="portfolio-preview">
            <div class="preview-placeholder">Portrait Session</div>
          </div>
          <div class="portfolio-info">
            <h3 class="portfolio-title">Professional Portraits</h3>
            <p class="portfolio-description">Corporate headshots and lifestyle portraits that capture personality and professionalism.</p>
            <Button href="/studios/photo-studio/portfolio" variant="light" class="portfolio-link">View Project</Button>
          </div>
        </div>
        
        <div class="portfolio-item">
          <div class="portfolio-preview">
            <div class="preview-placeholder">Event Coverage</div>
          </div>
          <div class="portfolio-info">
            <h3 class="portfolio-title">Wedding & Events</h3>
            <p class="portfolio-description">Memorable moments from weddings, corporate events, and celebrations beautifully documented.</p>
            <Button href="/studios/photo-studio/portfolio" variant="light" class="portfolio-link">View Project</Button>
          </div>
        </div>
      </div>
      
      <div class="portfolio-cta">
        <Button href="/studios/photo-studio/portfolio" variant="light" class="view-all-button">View All Projects</Button>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="process-section">
    <div class="section-container">
      <h2 class="section-title">Our Process</h2>
      
      <div class="process-grid">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3 class="step-title">Consultation</h3>
          <p class="step-description">We discuss your vision, requirements, and desired style to understand your needs.</p>
        </div>
        
        <div class="process-step">
          <div class="step-number">2</div>
          <h3 class="step-title">Planning</h3>
          <p class="step-description">We plan the shoot, including location, timing, and creative direction.</p>
        </div>
        
        <div class="process-step">
          <div class="step-number">3</div>
          <h3 class="step-title">Photoshoot</h3>
          <p class="step-description">We capture your moments with professional equipment and creative expertise.</p>
        </div>
        
        <div class="process-step">
          <div class="step-number">4</div>
          <h3 class="step-title">Post-Production</h3>
          <p class="step-description">We edit and deliver your photos with professional retouching and color correction.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Preview Section -->
  <section class="portfolio-preview">
    <div class="section-container">
      <h2 class="section-title">Recent Work</h2>
      
      <div class="portfolio-grid">
        <div class="portfolio-item">
          <div class="portfolio-placeholder">
            <span class="placeholder-text">Portrait Session</span>
          </div>
        </div>
        <div class="portfolio-item">
          <div class="portfolio-placeholder">
            <span class="placeholder-text">Event Coverage</span>
          </div>
        </div>
        <div class="portfolio-item">
          <div class="portfolio-placeholder">
            <span class="placeholder-text">Landscape</span>
          </div>
        </div>
        <div class="portfolio-item">
          <div class="portfolio-placeholder">
            <span class="placeholder-text">Creative Project</span>
          </div>
        </div>
      </div>
      
      <div class="portfolio-cta">
        <Button href="/studios/photo-studio/portfolio" variant="light" class="cta-button">View Full Portfolio</Button>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="section-container">
      <div class="cta-content">
        <h2 class="cta-title">Ready to Capture Your Moments?</h2>
        <p class="cta-subtitle">Let's create beautiful memories together</p>
        <div class="cta-buttons">
          <Button href="/contact" variant="light" class="cta-button primary">Book Photoshoot</Button>
          <Button href="/studios/photo-studio/portfolio" variant="light" class="cta-button secondary">View Portfolio</Button>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Intersection Observer Animation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        const heroLetters = document.querySelectorAll('.hero-letter');
        heroLetters.forEach((letter, index) => {
          setTimeout(() => {
            letter.style.opacity = '1';
            letter.style.transform = 'translateX(0px) translateY(0px) scale(1)';
          }, 800 + index * 100);
        });
      }, 500);

      // Animate service cards on scroll
      const serviceObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target;
            const index = parseInt(card.dataset.serviceIndex);
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, index * 100);
            serviceObserver.unobserve(card);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      document.querySelectorAll('.service-card').forEach(card => {
        serviceObserver.observe(card);
      });
    });
  </script>
</Layout>

<style>
  /* Hero Section Styles */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .page-dark-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }

  .hero-letter-wrap {
    position: absolute;
    bottom: 0;
    left: 40px; 
    right: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 20px;
    padding: 0 40px;
  }

  .hero-main-word {
    display: flex;
    gap: 12px;
    justify-content: flex-start;
  }

  .hero-top-word .hero-letter {
    font-size: 150px; /* Much smaller for PHOTO */
  }

  .hero-bottom-word .hero-letter {
    font-size: 380px; /* SERVICES at 380px */
  }

  .hero-letter {
    font-family: var(--font-koulen);
    line-height: 0.7em;
    color: var(--color-text-primary);
    display: inline-block;
    opacity: 0;
    transform: translateY(-230px);
    animation: hero-letter-in 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
  }

  .hero-letter:nth-child(1) { animation-delay: 0.8s; }
  .hero-letter:nth-child(2) { animation-delay: 0.9s; }
  .hero-letter:nth-child(3) { animation-delay: 1.0s; }
  .hero-letter:nth-child(4) { animation-delay: 1.1s; }
  .hero-letter:nth-child(5) { animation-delay: 1.2s; }
  .hero-letter:nth-child(6) { animation-delay: 1.3s; }
  .hero-letter:nth-child(7) { animation-delay: 1.4s; }
  .hero-letter:nth-child(8) { animation-delay: 1.5s; }
  .hero-letter:nth-child(9) { animation-delay: 1.6s; }
  .hero-letter:nth-child(10) { animation-delay: 1.7s; }
  .hero-letter:nth-child(11) { animation-delay: 1.8s; }
  .hero-letter:nth-child(12) { animation-delay: 1.9s; }
  .hero-letter:nth-child(13) { animation-delay: 2.0s; }

  @keyframes hero-letter-in { 
    to { 
      opacity: 1;
      transform: translateY(0); 
    } 
  }

  /* Responsive breakpoints */
  @media (min-width: 2000px) { 
    .hero-top-word .hero-letter { font-size: 240px; }
    .hero-bottom-word .hero-letter { font-size: 608px; }
  }
  @media (min-width: 1500px) and (max-width: 1999px) { 
    .hero-top-word .hero-letter { font-size: 180px; }
    .hero-bottom-word .hero-letter { font-size: 456px; }
  }
  @media (min-width: 1200px) and (max-width: 1499px) { 
    .hero-top-word .hero-letter { font-size: 140px; }
    .hero-bottom-word .hero-letter { font-size: 352px; }
  }
  @media (min-width: 810px) and (max-width: 1199px) { 
    .hero-top-word .hero-letter { font-size: 100px; }
    .hero-bottom-word .hero-letter { font-size: 252px; }
  }
  @media (max-width: 809px) { 
    .hero-top-word .hero-letter { font-size: 60px; }
    .hero-bottom-word .hero-letter { font-size: 152px; }
    .hero-letter-wrap { gap: 15px; }
  }

  /* Section Container */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Services Header */
  .services-header {
    padding: 120px 0 80px;
    text-align: center;
    background: var(--token-bg-dark);
  }

  .services-header.dark-bg {
    background: var(--token-bg-dark);
  }

  .header-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-family: var(--font-koulen);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    margin-bottom: 30px;
    color: var(--token-text-primary);
  }

  .page-subtitle {
    font-family: var(--font-roboto-mono);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    color: var(--token-accent-gold);
    margin-bottom: 20px;
  }

  .page-description {
    font-family: var(--font-roboto-mono);
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    line-height: 1.6;
    color: var(--token-text-secondary);
  }

  /* Services Section */
  .services-section {
    padding: 80px 0;
    background: var(--token-bg-dark);
  }

  /* Photography Grid Styles */
  .photography-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 60px;
    margin-bottom: 80px;
  }

  .photography-category {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
