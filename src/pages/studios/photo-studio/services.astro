  }

  .category-description {
    font-family: var(--font-roboto-mono);
    font-size: 1rem;
    color: var(--token-text-primary);
    font-weight: 500;
    letter-spacing: 1px;
    margin: 0;
  }

  .category-info {
    font-family: var(--font-roboto-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--token-text-secondary);
    margin: 0;
    opacity: 0.8;
  }

  .category-cta {
