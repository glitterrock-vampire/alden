    }
    
    .category-title {
      font-size: 2rem;
    }
    
    .category-subtitle {
      font-size: 1rem;
    }
    
    .portfolio-link {
      margin-top: 40px;
    }
  }

  /* Portfolio Section */
  .portfolio-section {
    padding: 80px 0;
    background: var(--token-bg-dark);
  }

  .section-subtitle {
    font-family: var(--font-roboto-mono);
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    line-height: 1.6;
    color: var(--token-text-secondary);
    text-align: center;
    max-width: 600px;
