---
// src/pages/work.astro
// Updated for deployment
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

interface Project {
  id: number;
  title: string;
  category: string;
  href: string;
  image: string;
  imageW: number;
  imageH: number;
  comingSoon?: boolean;
  liveUrl?: string;
}

const WORK_LETTERS = ["W", "E", "B"];
const STUDIO_LETTERS = ["S", "T", "U", "D", "I", "O"];

const projects: Project[] = [
  { id:1, title:"CDT JAMAICA", category:"DIGITAL PLATFORM", href:"https://cdtjamaica.org", image:"https://framerusercontent.com/images/o6w4CVRNseGWbrL67Z02tHFMU.png", imageW:1628, imageH:1119, liveUrl:"https://cdtjamaica.org" },
  { id:2, title:"TOTALLY BAKED", category:"E-COMMERCE", href:"https://totally-baked-ja.vercel.app", image:"https://framerusercontent.com/images/XbAyT67MOmZ9iWY72g8FEkEZZFM.png", imageW:2718, imageH:1810, liveUrl:"https://totally-baked-ja.vercel.app" },
  { id:3, title:"ZENITH TEAS", category:"TEA MANAGEMENT", href:"https://zenith-taupe.vercel.app", image:"https://framerusercontent.com/images/jGIDW70qyfBuP6v8UKUwumU8HGo.png", imageW:1628, imageH:1119, liveUrl:"https://zenith-taupe.vercel.app" },
  { id:4, title:"GLOWING LANDING", category:"LANDING PAGE", href:"https://glowing-landing-page.netlify.app", image:"https://framerusercontent.com/images/Dqg69EBbfiJJHyD2a4T7Ki7uPuc.png", imageW:1628, imageH:1119, liveUrl:"https://glowing-landing-page.netlify.app" },
  { id:5, title:"BLACKBOX SYSTEM", category:"IOT SYSTEM", href:"https://blackbox-online.vercel.app", image:"https://framerusercontent.com/images/fKFKHb1VZsz50W8Ctq7RIZW4SRw.png", imageW:1628, imageH:1119, liveUrl:"https://blackbox-online.vercel.app" },
  { id:6, title:"DAVID P BLAKE", category:"PERSONAL PORTFOLIO", href:"https://davidpblake.org", image:"https://framerusercontent.com/images/placeholder.png", imageW:1628, imageH:1119, liveUrl:"https://davidpblake.org" },
];
---

<Layout
  title="Web Portfolio | ALDEN Web Studio"
  description="Selected web development work by ALDEN, featuring digital platforms, e-commerce solutions, and innovative web applications."
>
  <Nav currentPage="portfolio" />
  
  <div class="grain-overlay"></div>

  <!-- Video Background -->
  <div class="page-video-bg">
    <div class="page-dark-overlay"></div>
    <div class="page-video-wrap">
      <video
        src="https://framerusercontent.com/assets/WTjKqrn8HNXvDANMM6KjIZoIHI.mp4"
        muted playsinline preload="auto"
        class="page-video"
        id="scrollVideo"
      ></video>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-letter-wrap">
      <div class="hero-word hero-word-top">
        {WORK_LETTERS.map((letter, i) => (
          <span class="hero-letter" data-letter={letter} data-index={i} key={i}>
            {letter}
          </span>
        ))}
      </div>
      <div class="hero-word hero-word-bottom">
        {STUDIO_LETTERS.map((letter, i) => (
          <span class="hero-letter" data-letter={letter} data-index={i + 3} key={i}>
            {letter}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="portfolio-section">
    <div class="container">
      <div class="portfolio-grid">
        {projects.map((project) => (
          <div class="portfolio-card" key={project.id}>
            <div class="portfolio-card-image">
              {project.liveUrl ? (
                <iframe
                  src={project.liveUrl}
                  title={project.title}
                  class="portfolio-card-iframe"
                  loading="lazy"
                  sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                ></iframe>
              ) : (
                <img
                  src={project.image}
                  alt={project.title}
                  class="portfolio-card-img"
                  loading="lazy"
                />
              )}
            </div>
            <div class="portfolio-card-content">
              <h3 class="portfolio-card-title">{project.title}</h3>
              <span class="portfolio-card-category">{project.category}</span>
              {project.liveUrl && (
                <a 
                  href={project.liveUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="portfolio-card-link"
                >
                  View Live Site →
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,400;0,500;1,400&display=swap');

  :root {
    --cream: #e7e5df;
    --gold: #FFD700;
    --gold-rgb: 255, 215, 0;
    --ff-disp: 'Koulen', sans-serif;
    --ff-mono: 'Roboto Mono', monospace;
    --ff-body: 'Albert Sans', sans-serif;
  }

  /* Grain Overlay */
  .grain-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
    opacity: 0.015;
    background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0);
    background-size: 50px 50px;
    animation: grainMove 8s steps(10) infinite;
    mix-blend-mode: overlay;
  }

  @keyframes grainMove {
    0%, 100% { transform: translate(0, 0); background-position: 0 0; }
    10% { transform: translate(-5px, -10px); background-position: 5px 5px; }
    20% { transform: translate(-10px, 5px); background-position: 10px 10px; }
    30% { transform: translate(5px, -5px); background-position: 15px 15px; }
    40% { transform: translate(-15px, -15px); background-position: 20px 20px; }
    50% { transform: translate(10px, 10px); background-position: 25px 25px; }
    60% { transform: translate(-20px, 5px); background-position: 30px 30px; }
    70% { transform: translate(15px, -10px); background-position: 35px 35px; }
    80% { transform: translate(-5px, 20px); background-position: 40px 40px; }
    90% { transform: translate(25px, -25px); background-position: 45px 45px; }
  }

  /* Video Background */
  .page-video-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  .page-dark-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #000;
    pointer-events: none;
  }

  .page-video-wrap {
    position: absolute;
    top: -10%;
    left: -10%;
    width: 120%;
    height: 120%;
    z-index: 1;
    filter: brightness(0.85) blur(12px);
  }

  .page-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hero Section */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  
  .hero-letter-wrap {
    position: absolute;
    bottom: 0;
    left: 40px; 
    right: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 20px;
    padding: 0 40px;
    z-index: 2;
  }

  .hero-word {
    display: flex;
    gap: 12px;
    justify-content: flex-start;
  }

  .hero-word-top .hero-letter {
    font-size: 150px;
  }

  .hero-word-bottom .hero-letter {
    font-size: 380px;
  }

  .hero-letter {
    font-family: var(--ff-disp);
    line-height: 0.7em;
    color: var(--cream);
    display: inline-block;
    opacity: 0;
    transform: translateY(-230px);
    animation: letterReveal 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
  }

  /* Responsive breakpoints */
  @media (min-width: 2000px) { 
    .hero-word-top .hero-letter { font-size: 240px; }
    .hero-word-bottom .hero-letter { font-size: 608px; }
  }
  @media (min-width: 1500px) and (max-width: 1999px) { 
    .hero-word-top .hero-letter { font-size: 180px; }
    .hero-word-bottom .hero-letter { font-size: 456px; }
  }
  @media (min-width: 1200px) and (max-width: 1499px) { 
    .hero-word-top .hero-letter { font-size: 140px; }
    .hero-word-bottom .hero-letter { font-size: 352px; }
  }
  @media (min-width: 810px) and (max-width: 1199px) { 
    .hero-word-top .hero-letter { font-size: 100px; }
    .hero-word-bottom .hero-letter { font-size: 250px; }
  }
  @media (max-width: 809px) { 
    .hero-word-top .hero-letter { font-size: 70px; }
    .hero-word-bottom .hero-letter { font-size: 180px; }
    .hero-letter-wrap { 
      left: 20px; 
      padding: 0 20px; 
      gap: 10px; 
    }
  }

  .hero-letter:nth-child(1) { animation-delay: 0.8s; }
  .hero-letter:nth-child(2) { animation-delay: 0.85s; }
  .hero-letter:nth-child(3) { animation-delay: 0.9s; }
  .hero-letter:nth-child(4) { animation-delay: 0.95s; }
  .hero-letter:nth-child(5) { animation-delay: 1.0s; }
  .hero-letter:nth-child(6) { animation-delay: 1.05s; }
  .hero-letter:nth-child(7) { animation-delay: 1.1s; }
  .hero-letter:nth-child(8) { animation-delay: 1.15s; }
  .hero-letter:nth-child(9) { animation-delay: 1.2s; }

  @keyframes letterReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Portfolio Section */
  .portfolio-section {
    position: relative;
    z-index: 5;
    padding: 4rem 0 6rem;
    background: transparent;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 2.5rem;
  }

  /* Portfolio Card */
  .portfolio-card {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 215, 0, 0.2);
    border-radius: 1rem;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .portfolio-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 215, 0, 0.5);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .portfolio-card-image {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: #1a1a1a;
  }

  .portfolio-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .portfolio-card:hover .portfolio-card-img {
    transform: scale(1.05);
  }

  .portfolio-card-iframe {
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
  }

  .portfolio-card-content {
    padding: 1.5rem;
    text-align: center;
  }

  .portfolio-card-title {
    font-family: var(--ff-mono);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--gold);
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .portfolio-card-category {
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    color: rgba(255, 215, 0, 0.7);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 1rem;
  }

  .portfolio-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    color: var(--gold);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 215, 0, 0.3);
    border-radius: 2rem;
    transition: all 0.3s ease;
  }

  .portfolio-card-link:hover {
    background: rgba(255, 215, 0, 0.1);
    border-color: var(--gold);
    gap: 0.75rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .portfolio-grid {
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
    }
    
    .container {
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .portfolio-section {
      padding: 2rem 0 4rem;
    }
    
    .portfolio-card-image {
      height: 200px;
    }
    
    .portfolio-card-content {
      padding: 1rem;
    }
    
    .portfolio-card-title {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
    
    .hero-letter-wrap {
      bottom: 5%;
    }
  }
</style>

<script>
(function initVideoScroll() {
  const video = document.getElementById('scrollVideo');
  if (!video) return;

  let videoDuration = 0;
  let isReady = false;
  let ticking = false;

  video.addEventListener('loadedmetadata', () => {
    videoDuration = video.duration;
    isReady = true;
    video.currentTime = 0;
  });

  video.load();

  function updateVideoFrame() {
    if (!isReady || videoDuration <= 0) return;

    const scrollY = window.scrollY;
    const hero = document.querySelector('.hero');
    const portfolio = document.querySelector('.portfolio-section');
    
    if (!hero || !portfolio) return;

    const heroBottom = hero.offsetTop + hero.offsetHeight;
    const portfolioBottom = portfolio.offsetTop + portfolio.offsetHeight;
    const maxScroll = portfolioBottom - window.innerHeight;
    
    let progress = 0;
    
    if (scrollY <= heroBottom) {
      // Scroll from top to hero bottom: 0 to 0.15
      progress = (scrollY / heroBottom) * 0.15;
    } else if (scrollY >= maxScroll) {
      // Past portfolio: 0.85 to 1
      progress = 0.85 + ((scrollY - maxScroll) / (window.innerHeight * 2));
      progress = Math.min(1, progress);
    } else {
      // Scrolling through portfolio: 0.15 to 0.85
      const portfolioScroll = scrollY - heroBottom;
      const portfolioRange = maxScroll - heroBottom;
      progress = 0.15 + (portfolioScroll / portfolioRange) * 0.7;
    }
    
    progress = Math.max(0, Math.min(1, progress));
    const targetTime = progress * videoDuration;
    
    if (Math.abs(video.currentTime - targetTime) > 0.03) {
      video.currentTime = targetTime;
    }
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateVideoFrame();
        ticking = false;
      });
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  setTimeout(updateVideoFrame, 500);
})();
</script>