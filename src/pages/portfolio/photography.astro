---
// src/pages/portfolio/photography.astro
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

interface PhotoProject {
  id: number;
  title: string;
  category: string;
  href: string;
  image: string;
  imageW: number;
  imageH: number;
  comingSoon?: boolean;
  liveUrl?: string;
}

// PHOTO letters for animated hero text
const PHOTO_LETTERS = ["P", "H", "O", "T", "O"];

const photoProjects: PhotoProject[] = [
  { id:1, title:"JAMAICA LANDSCAPES",           category:"NATURE PHOTOGRAPHY",          href:"https://example.com",         image:"https://framerusercontent.com/images/o6w4CVRNseGWbrL67Z02tHFMU.png",   imageW:1628, imageH:1119, comingSoon:true },
  { id:2, title:"PORTRAIT SESSIONS",         category:"PORTRAIT PHOTOGRAPHY",      href:"https://example.com",       image:"https://framerusercontent.com/images/XbAyT67MOmZ9iWY72g8FEkEZZFM.png", imageW:2718, imageH:1810, comingSoon:true },
  { id:3, title:"URBAN EXPLORATION",                category:"STREET PHOTOGRAPHY",   href:"https://example.com",               image:"https://framerusercontent.com/images/jGIDW70qyfBuP6v8UKUwumU8HGo.png", imageW:1628, imageH:1119, comingSoon:true },
  { id:4, title:"WEDDING STORIES",            category:"EVENT PHOTOGRAPHY",    href:"https://example.com",           image:"https://framerusercontent.com/images/Dqg69EBbfiJJHyD2a4T7Ki7uPuc.png", imageW:1628, imageH:1119, comingSoon:true },
  { id:5, title:"PRODUCT PHOTOGRAPHY",           category:"COMMERCIAL",     href:"https://example.com",           image:"https://framerusercontent.com/images/fKFKHb1VZsz50W8Ctq7RIZW4SRw.png", imageW:1628, imageH:1119, comingSoon:true },
];
---

<Layout
  title="Photography Portfolio | ALDEN Photo Studio"
  description="Photography work by ALDEN Photo Studio, capturing moments through professional photography services."
>
  <Nav currentPage="portfolio" />
  
  <!-- Animated Grain Overlay -->
  <div class="grain-overlay"></div>

  <!-- Hero Section -->
  <section class="hero" id="hero">
    <!-- Hero Background -->
    <div class="page-video-bg" id="pageVideoBg">
      <div class="page-dark-overlay"></div>
      
      <div class="page-video-wrap" id="pageVideoWrap">
        <video
          src="https://framerusercontent.com/assets/WTjKqrn8HNXvDANMM6KjIZoIHI.mp4"
          muted playsinline preload="auto"
          class="page-video"
        ></video>
      </div>
    </div>

    <!-- Giant "PHOTO" letters -->
    <div class="hero-letter-wrap">
      {PHOTO_LETTERS.map((letter, index) => (
        <span class="hero-letter" data-letter={letter} data-index={index}>
          {letter}
        </span>
      ))}
    </div>
  </section>

  <!-- Photography Portfolio Section -->
  <section class="cream-section" style="padding-top: 120px;">

    <!-- Horizontal scroll gallery -->
    <div class="hscroll-outer" id="hscrollOuter">
      <div class="hscroll-sticky">
        <div class="hscroll-track" id="hscrollTrack">
          {photoProjects.map((p) => (
            <div
              class={`card${p.comingSoon ? " card--soon" : ""}`}
              data-project-id={p.id}
              aria-label={p.title}
            >
              <div class="card-bg">
                <img
                  src={`${p.image}?scale-down-to=1024&width=${p.imageW}&height=${p.imageH}`}
                  width={p.imageW} height={p.imageH}
                  loading={p.id <= 3 ? "eager" : "lazy"}
                  alt={`${p.title} project`}
                  class="card-bg-img"
                />
              </div>
              <div class="card-labels">
                <span class={`card-title-text`}>{p.title}</span>
                <span class="card-category-text">{p.category}</span>
              </div>
              {p.comingSoon && <div class="card-soon">COMING SOON</div>}
            </div>
          ))}
          <!-- Spacer tile for better scroll visibility of last item -->
          <div class="card-spacer"></div>
        </div>
      </div>
    </div>

    </section>

  <Footer />
</Layout>

<style is:global>
  /* Albert Sans font */
  @import url('https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,400;0,500;1,400&display=swap');

  /* Design tokens */
  :root {
    --cream:     #e7e5df;
    --cream-50:  #e7e5df80;
    --green:      #4caf50;
    --green-dk:   #2e7d32;
    --green-warm: rgb(76, 175, 80);
    --dark:      #ffffff;
    --black:     #000000;
    --ff-disp:   'Koulen', sans-serif;
    --ff-mono:   'Roboto Mono', monospace;
    --ff-body:   'Albert Sans', sans-serif;
    --ff-cjk:    "HanyiSentyFoundation Regular", "PingFang SC", "Noto Serif CJK SC", serif;
    
    /* Footer background variables */
    --token-bg-light: #ffffff;
    --token-text-light: #ffffff;
    --token-text-dark: #333333;
    --token-accent-green: #4caf50;
  }

  /* Disable Layout's blanket transition on animated elements */
  .hero-bg,
  .hero-video-wrap,
  .hero-blur-layer,
  .hero-letter {
    transition: none !important;
  }

  .title-featured-stack,
  .title-projects {
    opacity: 0.001;
  }
  .footer-greet-line,
  .footer-chinese {
    opacity: 1 !important;
  }

  /* Animated Grain Overlay */
  .grain-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
    opacity: 0.01;
    background-image: 
      radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0),
      radial-gradient(circle at 2px 2px, rgba(255,255,255,0.2) 1px, transparent 0),
      radial-gradient(circle at 3px 3px, rgba(255,255,255,0.1) 1px, transparent 0);
    background-size: 50px 50px, 30px 30px, 20px 20px;
    background-position: 0 0, 10px 10px, 20px 20px;
    animation: grain-move 8s steps(10) infinite;
    filter: blur(0.5px);
    mix-blend-mode: overlay;
  }

  @keyframes grain-move {
    0%, 100% {
      transform: translate(0, 0);
      background-position: 0 0, 10px 10px, 20px 20px;
    }
    10% {
      transform: translate(-5px, -10px);
      background-position: 5px 5px, 15px 15px, 25px 25px;
    }
    20% {
      transform: translate(-10px, 5px);
      background-position: 10px 10px, 20px 20px, 30px 30px;
    }
    30% {
      transform: translate(5px, -5px);
      background-position: 15px 15px, 25px 25px, 35px 35px;
    }
    40% {
      transform: translate(-15px, -15px);
      background-position: 20px 20px, 30px 30px, 40px 40px;
    }
    50% {
      transform: translate(10px, 10px);
      background-position: 25px 25px, 35px 35px, 45px 45px;
    }
    60% {
      transform: translate(-20px, 5px);
      background-position: 30px 30px, 40px 40px, 50px 50px;
    }
    70% {
      transform: translate(15px, -10px);
      background-position: 35px 35px, 45px 45px, 55px 55px;
    }
    80% {
      transform: translate(-5px, 20px);
      background-position: 40px 40px, 50px 50px, 60px 60px;
    }
    90% {
      transform: translate(25px, -25px);
      background-position: 45px 45px, 55px 55px, 65px 65px;
    }
  }
</style>

<style>
/* Full Page Video Background */
.page-video-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  pointer-events: none;
}

.page-dark-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
  background: linear-gradient(#0000 0%, #000 34.9539%);
  pointer-events: none;
}

.page-video-wrap {
  position: absolute;
  top: -50px;
  left: -10%;
  width: 120%;
  height: 120%;
  z-index: 1;
  filter: brightness(0.95) blur(12px) saturate(0.7);
  will-change: transform;
  transform-origin: center center;
  transform: scale(1.01);
  animation: page-video-in 1.2s cubic-bezier(0.58,-0.13,0.17,1.02) 2.6s forwards;
  clip-path: inset(50px round 0px);
}

@keyframes page-video-in { to { transform: scale(1); } }

.page-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Hero */
.hero {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 600px;
  padding-top: 200px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  background: transparent;
}

@media (--mobile) {
  .hero {
    padding-top: 150px;
  }
}

/* Hero letters */
.hero-letter-wrap {
  position: absolute;
  bottom: 0;
  left: 0; right: 0;
  z-index: 3;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  gap: 12px;
  padding: 0 40px;
}

.hero-letter {
  font-family: var(--ff-disp);
  line-height: 0.7em;
  color: var(--cream);
  white-space: nowrap;
  will-change: transform;
  display: inline-block;
  opacity: 0;
  transform: translateY(-230px);
  animation: hero-letter-in 0.9s cubic-bezier(0.77,0.02,0.38,1) forwards;
  font-size: 670px;
}

/* Staggered animation delays */
.hero-letter:nth-child(1) { animation-delay: 0.8s; }
.hero-letter:nth-child(2) { animation-delay: 0.9s; }
.hero-letter:nth-child(3) { animation-delay: 1.0s; }
.hero-letter:nth-child(4) { animation-delay: 1.1s; }
.hero-letter:nth-child(5) { animation-delay: 1.2s; }

@keyframes hero-letter-in { 
  to { 
    opacity: 1;
    transform: translateY(0); 
  } 
}

@media (min-width: 2000px) { .hero-letter { font-size: 940px; } }
@media (min-width: 1500px) and (max-width: 1999px) { .hero-letter { font-size: 670px; } }
@media (min-width: 1200px) and (max-width: 1499px) { .hero-letter { font-size: 350px; } }
@media (min-width: 810px)  and (max-width: 1199px) { .hero-letter { font-size: 189px; } }
@media (max-width: 809px)  { .hero-letter { font-size: 120px; } }

/* Portfolio Section */
.cream-section {
  background-color: transparent;
  position: relative;
  z-index: 2;
  padding: 50px 24px 0;
}

/* Horizontal scroll */
.hscroll-outer {
  width: 100%;
  overflow: visible;
  position: relative;
}

.hscroll-sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-x: auto;
  overflow-y: hidden;
  display: flex;
  align-items: center;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.hscroll-sticky::-webkit-scrollbar {
  display: none;
}

.hscroll-track {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 40px;
  gap: 16px;
  min-width: max-content;
}

/* Project cards */
.card {
  --cw: 560px;
  --ch: 350px;
  flex: none;
  width: var(--cw);
  height: var(--ch);
  position: relative;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  transition: transform 0.5s cubic-bezier(0.22,1,0.36,1) !important;
}

.card:hover { transform: scale(1.02); }
.card--soon { cursor: not-allowed; }

/* Responsive tile sizes */
@media (max-width: 1499px) {
  .card { --cw: 480px; --ch: 300px; }
  .card-spacer { --cw: 480px; --ch: 300px; }
}

@media (max-width: 1199px) {
  .card { --cw: 400px; --ch: 250px; }
  .card-spacer { --cw: 400px; --ch: 250px; }
}

/* Spacer tiles */
.card-spacer {
  --cw: 560px;
  --ch: 350px;
  flex: none;
  width: var(--cw);
  height: var(--ch);
  position: relative;
  pointer-events: none;
  visibility: hidden;
}

.card-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.85);
  transition: filter 0.45s cubic-bezier(0.22,1,0.36,1),
              opacity 0.45s cubic-bezier(0.22,1,0.36,1) !important;
}

.card-bg-img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: none !important;
}

.card:hover .card-bg {
  filter: blur(10px) brightness(0.5);
  opacity: 0.4;
}

.card--soon .card-bg-img { filter: brightness(0.35) grayscale(0.6); }

/* Labels - Green theme for photography */
.card-labels {
  z-index: 5;
  position: absolute;
  bottom: -40px; left: 0; right: 0;
  padding: 0 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 21px;
  pointer-events: none;
  font-family: var(--ff-mono);
  font-size: 14px;
  line-height: 1.4em;
  color: #4caf50 !important;
  white-space: pre;
}

.card-title-text {
  font-family: var(--ff-mono);
  font-size: 14px;
  line-height: 1.4em;
  color: #4caf50 !important;
  white-space: pre;
  transition: color 0.3s ease !important;
}

.card:hover .card-title-text {
  color: #66bb6a !important;
}

.card-category-text {
  font-family: var(--ff-mono);
  font-size: 14px;
  line-height: 1.4em;
  color: #4caf50 !important;
  opacity: 1;
  white-space: pre;
  transition: color 0.3s ease !important;
}

.card:hover .card-category-text {
  color: #66bb6a !important;
}

.card-soon {
  position: absolute;
  bottom: 16px; right: 16px;
  z-index: 6;
  font-family: var(--ff-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  color: #4caf50 !important;
  border: 1px solid rgba(76,175,80,0.35);
  padding: 4px 10px;
  border-radius: 2px;
  background: rgba(231,229,223,0.75);
  backdrop-filter: blur(4px);
}

/* Responsive */
@media (max-width: 1499px) { 
  .hscroll-track { padding: 0 40px; gap: 16px; }
}

@media (max-width: 1199px) {
  .hscroll-track { padding: 0 40px; gap: 16px; }
}

@media (max-width: 809px) {
  .cream-section  { padding: 32px 16px 0; }
  .hscroll-track  { padding: 0 16px; gap: 12px; }
  .card           { --cw: 280px; --ch: 200px; }
}
</style>

<script>
/* Scroll-based video control */
(function initVideoScroll() {
  const pageVideoBg = document.getElementById('pageVideoBg');
  const videoWrap   = document.getElementById('pageVideoWrap');
  const video       = document.querySelector('.page-video');
  if (!pageVideoBg || !videoWrap || !video) return;

  let ticking   = false;
  let animated  = false;
  let lastSY    = 0;
  let videoLoaded = false;
  let lastVideoTime = 0;
  let seekTimeout = null;
  let lastTargetTime = 0;
  let frameCount = 0;
  let lastFrameTime = performance.now();
  let fps = 60;

  // Load video and set initial state
  video.load().then(() => {
    videoLoaded = true;
    video.currentTime = 0;
    video.play().catch(() => {
      // Autoplay might be blocked, that's fine
    });
  }).catch(console.error);

  // Horizontal scroll control
  const hscrollOuter = document.getElementById('hscrollOuter');
  const hscrollTrack = document.getElementById('hscrollTrack');
  
  if (hscrollOuter && hscrollTrack) {
    const update = () => {
      const sy = window.scrollY;
      const outer = hscrollOuter;
      const outerTop = outer.offsetTop;
      const outerH = outer.offsetHeight;
      const track = hscrollTrack;
      
      // Wait until user scrolls past the entire hero section before starting horizontal scroll
      const heroSection = document.querySelector('.hero');
      const heroHeight = heroSection ? heroSection.offsetHeight : 400;
      
      if (sy < outerTop + heroHeight + 100) {
        track.style.transform = 'translate3d(0, 0, 0)';
        return;
      }
      
      const progress = (sy - outerTop) / (outerH - window.innerHeight);
      const clamped  = Math.max(0, Math.min(1, progress));
      const maxTX    = track.scrollWidth - window.innerWidth;
      // Slow down scroll speed by using a factor (0.7 = 30% slower)
      const scrollFactor = 0.7;
      track.style.transform = `translate3d(${-clamped * maxTX * scrollFactor}px, 0, 0)`;
    };

    window.addEventListener('scroll', update, { passive: true });
    update();
  }
})();
</script>
