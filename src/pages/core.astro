---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const pageData = {
  offerings: [
    {
      id: 'strategy',
      title: 'STRATEGY',
      description: 'Crafting comprehensive design strategies that align with business objectives and user needs. From research to implementation, I ensure every design decision serves a purpose.',
      related: ['UX Research', 'Product Planning']
    },
    {
      id: 'design',
      title: 'DESIGN',
      description: 'Creating intuitive, beautiful interfaces that balance aesthetics with functionality. Every pixel, every interaction is thoughtfully designed to enhance the user experience.',
      related: ['UI/UX Design', 'Interaction Design']
    },
    {
      id: 'development',
      title: 'DEVELOPMENT',
      description: 'Bringing designs to life with clean, efficient code. I specialize in modern web technologies and frameworks to create performant, scalable solutions.',
      related: ['Frontend Development', 'React/Vue/Astro', 'Performance Optimization']
    },
    {
      id: 'leadership',
      title: 'LEADERSHIP',
      description: 'Guiding teams and projects to success. From mentoring junior designers to leading cross-functional initiatives, I help organizations achieve their design goals.',
      related: ['Team Leadership', 'Design Systems', 'Mentorship']
    }
  ]
};
---

<Layout title="ALDEN | Core" description="Learn more about Andre Walters, the core of ALDEN and software engineer based in Jamaica.">
  <Nav currentPage="core" />

  <script>
    document.addEventListener('DOMContentLoaded', () => {

      // ── Hero letters drop in one by one ───────────────────────────────────
      setTimeout(() => {
        document.querySelectorAll('.hero-letter').forEach((letter, index) => {
          setTimeout(() => {
            const el = letter as HTMLElement;
            el.style.opacity = '1';
            el.style.transform = 'translateY(0px)';
          }, index * 150);
        });
      }, 400);

      // ── Scroll reveal — only [data-animate] elements ──────────────────────
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            // stop watching once revealed
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));

      // ── Footer ────────────────────────────────────────────────────────────
      const footerObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          setTimeout(() => {
            document.getElementById('footerCome')?.classList.add('visible');
            setTimeout(() => document.getElementById('footerSay')?.classList.add('visible'), 100);
            setTimeout(() => document.getElementById('footerHello')?.classList.add('visible'), 200);
            setTimeout(() => document.querySelector('.footer-chinese-wrap')?.classList.add('visible'), 300);
          }, 300);
          footerObserver.unobserve(entry.target);
        });
      }, { threshold: 0.2 });

      const footer = document.querySelector('.footer');
      if (footer) footerObserver.observe(footer);
    });
  </script>

  <style>
    /* ── Tokens ──────────────────────────────────────────────────────────── */
    :root {
      --color-bg:               #000000;
      --color-bg-light:         #e7e5df;
      --color-text-primary:     #e7e5df;
      --color-accent-gold:      #ccbb87;
      --color-accent-gold-dark: #8a7432;
      --color-white:            #ffffff;

      --font-koulen:      'Koulen', cursive;
      --font-roboto-mono: 'Roboto Mono', monospace;
      --font-pinyon:      'Pinyon Script', cursive;
      --font-hanyi:       'Georgia', serif;
      --token-text-light: var(--color-text-primary);

      --space-md: 16px; --space-lg: 24px; --space-xl: 32px;

      --transition-fast: 0.3s cubic-bezier(0.55, 0.45, 0.16, 1);
      --transition-base: 0.6s cubic-bezier(0.55, 0.45, 0.16, 1);

      --nav-height: 80px;
    }

    /* ── Reset ───────────────────────────────────────────────────────────── */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html {
      font-size: 87.5%;
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      scrollbar-width: none;
    }
    html::-webkit-scrollbar { display: none; }

    body {
      font-family: var(--font-roboto-mono);
      color: var(--color-text-primary);
      /*
        background-attachment: fixed makes the image stay put while you scroll
        background-position: center top keeps the full image visible from the top
      */
      background-image: url('/images/5BC0F55F-2624-4CB5-8C13-D1B70DD77DB3.PNG');
      background-size: cover;
      background-repeat: no-repeat;
      background-attachment: fixed;
      background-position: center top;
      line-height: 1.4;
      overflow-x: hidden;
      /* No padding-top — hero section fills viewport naturally */
    }

    h1,h2,h3,h4,h5,h6 { font-family: var(--font-koulen); font-weight: 400; line-height: 0.9em; letter-spacing: 0.02em; }
    p   { font-family: var(--font-roboto-mono); font-size: 14px; line-height: 1.4; }
    a   { color: inherit; text-decoration: none; transition: color var(--transition-fast); }
    img { display: block; max-width: 100%; height: auto; }

    ::selection      { background: var(--color-accent-gold); color: var(--color-bg); }
    ::-moz-selection { background: var(--color-accent-gold); color: var(--color-bg); }

    /*
      Dim overlay so text stays readable against the photo.
      Using ::before on body keeps the image fully visible behind it.
    */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.50);
      pointer-events: none;
      z-index: 0;
    }

    /* Everything above the overlay */
    main { position: relative; z-index: 1; }

    /* ── Hero ────────────────────────────────────────────────────────────── */
    .hero {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 560px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: 40px;
      overflow: hidden;
    }

    .hero-letter-wrap {
      position: absolute;
      top: 75%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      z-index: 3;
    }

    .hero-main-word { display: flex; gap: 4px; }

    .hero-letter {
      font-family: var(--font-koulen);
      font-size: 560px;
      line-height: 0.82;
      color: var(--token-text-light);
      white-space: nowrap;
      display: inline-block;
      /* starts invisible, JS sets opacity/transform */
      opacity: 0;
      transform: translateY(-200px);
      transition: opacity 0.6s ease-in-out, transform 0.6s ease-in-out;
    }

    @media (min-width: 2000px)                         { .hero-letter { font-size: 940px; } }
    @media (min-width: 1500px) and (max-width: 1999px) { .hero-letter { font-size: 670px; } }
    @media (min-width: 1200px) and (max-width: 1499px) { .hero-letter { font-size: 470px; } }
    @media (min-width: 810px)  and (max-width: 1199px) { .hero-letter { font-size: 300px; } }
    @media (max-width: 809px)                          { .hero-letter { font-size: 96px;  } }

    /* ── About Section ───────────────────────────────────────────────────── */
    .about-section {
      color: var(--color-text-primary);
      padding: 100px var(--space-lg) 60px;
    }

    .about-content {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0; /* gaps handled per-row with padding */
    }

    /* ── Name / title ────────────────────────────────────────────────────── */
    .about-description {
      text-align: center;
      padding-bottom: 64px;
    }

    .about-lead {
      font-family: var(--font-koulen);
      font-size: clamp(64px, 10vw, 130px);
      line-height: 0.9;
      color: var(--color-text-primary);
      margin-bottom: 16px;
      text-shadow: 0 2px 30px rgba(0,0,0,1);
    }

    .about-subline {
      font-family: var(--font-roboto-mono);
      font-size: clamp(14px, 1.8vw, 22px);
      color: var(--color-accent-gold);
      text-shadow: 0 0 20px rgba(0,0,0,0.9);
    }

    /* ── Two-column bio rows ─────────────────────────────────────────────── */
    .bio-row {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 48px;
      align-items: start;
      padding: 48px 0;
      border-top: 1px solid rgba(231, 229, 223, 0.1);
    }

    .bio-row:last-child { border-bottom: 1px solid rgba(231, 229, 223, 0.1); }

    .bio-label {
      padding-top: 3px;
    }

    .bio-label h2 {
      font-family: var(--font-koulen);
      font-size: 20px;
      color: var(--color-accent-gold);
      letter-spacing: 0.06em;
      line-height: 1.3;
    }

    /* ── Bio text ────────────────────────────────────────────────────────── */
    .bio-text p {
      font-family: var(--font-roboto-mono);
      font-size: 15px;
      line-height: 1.8;
      color: var(--color-text-primary);
      margin-bottom: 12px;
      text-shadow: 0 1px 12px rgba(0,0,0,0.75);
    }
    .bio-text p:last-child { margin-bottom: 0; }

    .bio-text h3 {
      font-family: var(--font-koulen);
      font-size: 22px;
      color: var(--color-text-primary);
      margin: 22px 0 6px;
      text-shadow: 0 1px 15px rgba(0,0,0,0.8);
    }
    .bio-text h3:first-child { margin-top: 0; }

    .bio-text ul  { margin: 8px 0 12px; padding-left: 18px; }
    .bio-text li  {
      font-family: var(--font-roboto-mono);
      font-size: 14px;
      line-height: 1.7;
      color: var(--color-text-primary);
      margin-bottom: 4px;
      text-shadow: 0 1px 10px rgba(0,0,0,0.7);
    }

    .bio-text strong { color: var(--color-accent-gold); font-weight: 400; }

    /* ── Scroll-reveal ───────────────────────────────────────────────────── */
    /*
      IMPORTANT: Only elements with [data-animate] start hidden.
      Do NOT add this attribute to the outer section or wrapper divs —
      only to the individual rows/cards you want to animate in.
    */
    [data-animate] {
      opacity: 0;
      transform: translateY(32px);
      transition:
        opacity  0.7s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    [data-animate].visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Stagger expertise cards */
    .expertise-grid [data-animate]:nth-child(1) { transition-delay: 0.00s; }
    .expertise-grid [data-animate]:nth-child(2) { transition-delay: 0.08s; }
    .expertise-grid [data-animate]:nth-child(3) { transition-delay: 0.16s; }
    .expertise-grid [data-animate]:nth-child(4) { transition-delay: 0.24s; }

    /* ── Expertise ───────────────────────────────────────────────────────── */
    .expertise {
      color: var(--color-text-primary);
      padding: 80px var(--space-lg) 100px;
    }

    .expertise-container { max-width: 1200px; margin: 0 auto; }

    .expertise-header { text-align: center; margin-bottom: 56px; }

    .expertise-title {
      font-family: var(--font-koulen);
      font-size: clamp(44px, 6vw, 76px);
      line-height: 0.9;
      text-shadow: 0 0 20px rgba(0,0,0,0.8);
    }

    .expertise-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 28px;
    }

    .card {
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255,255,255,0.13);
      border-radius: 6px;
      padding: 34px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
    }
    .card:hover {
      transform: translateY(-4px);
      border-color: var(--color-accent-gold);
      box-shadow: 0 10px 28px rgba(204,187,135,0.14);
    }

    .card-number {
      font-family: var(--font-roboto-mono);
      font-size: 11px;
      color: var(--color-accent-gold);
      letter-spacing: 0.1em;
      margin-bottom: 10px;
      opacity: 0.75;
    }

    .card-title {
      font-family: var(--font-koulen);
      font-size: 28px;
      color: var(--color-text-primary);
      margin: 0;
      line-height: 1;
    }

    .card-divider {
      width: 100%;
      height: 1px;
      background: rgba(255,255,255,0.1);
      margin: 14px 0;
    }

    .card-subtitle {
      font-family: var(--font-roboto-mono);
      font-size: 13px;
      color: var(--color-text-primary);
      opacity: 0.68;
      line-height: 1.6;
      margin: 0;
    }

    .card-related {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid rgba(255,255,255,0.07);
    }

    .related-title {
      font-family: var(--font-koulen);
      font-size: 11px;
      color: var(--color-accent-gold);
      letter-spacing: 0.1em;
      margin: 0 0 7px;
    }

    .related-tags { display: flex; flex-wrap: wrap; gap: 5px; }

    .tag {
      background: rgba(204,187,135,0.1);
      color: var(--color-text-primary);
      padding: 2px 7px;
      border-radius: 3px;
      font-family: var(--font-roboto-mono);
      font-size: 11px;
      opacity: 0.82;
    }

    /* ── CTA ─────────────────────────────────────────────────────────────── */
    .cta {
      color: var(--color-text-primary);
      padding: 80px 0;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cta::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(circle at center, rgba(204,187,135,0.06) 0%, transparent 65%);
      animation: rotate 30s linear infinite;
      pointer-events: none;
    }
    @keyframes rotate { to { transform: rotate(360deg); } }

    .cta-container {
      max-width: 820px;
      margin: 0 auto;
      padding: 0 var(--space-lg);
      position: relative;
      z-index: 2;
    }

    .cta-title {
      font-family: var(--font-koulen);
      font-size: clamp(44px, 7vw, 100px);
      line-height: 0.9;
      margin-bottom: 20px;
      text-shadow: 0 0 24px rgba(0,0,0,0.7);
    }

    .cta-subtitle {
      font-family: var(--font-roboto-mono);
      font-size: 15px;
      line-height: 1.7;
      opacity: 0.68;
      margin: 0 0 40px;
    }

    /* ── Footer animations ───────────────────────────────────────────────── */
    .footer #footerCome, .footer #footerSay,
    .footer #footerHello, .footer .chinese-char {
      opacity: 0;
      transform: translateY(20px) scale(0.9);
      transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .footer #footerCome.visible,
    .footer #footerSay.visible,
    .footer #footerHello.visible,
    .footer .chinese-char.visible { opacity: 1; transform: translateY(0) scale(1); }
    .footer #footerSay.visible   { transition-delay: 0.1s; }
    .footer #footerHello.visible { transition-delay: 0.2s; }

    /* ── Responsive ──────────────────────────────────────────────────────── */
    @media (max-width: 809.98px) {
      .about-section { padding: 60px var(--space-md) 40px; }
      .bio-row { grid-template-columns: 1fr; gap: 14px; padding: 36px 0; }
      .about-lead { font-size: 50px; }
      .expertise { padding: 60px var(--space-md) 80px; }
      .expertise-grid { grid-template-columns: 1fr; gap: 18px; }
      .card { padding: 24px; }
      .cta-title { font-size: 48px; }
    }

    @media print {
      .nav, .footer { display: none !important; }
      body { background: white !important; color: black; }
    }
  </style>

  <main>

    <!-- ─── HERO ──────────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-letter-wrap">
        <div class="hero-main-word">
          <span class="hero-letter">C</span>
          <span class="hero-letter">O</span>
          <span class="hero-letter">R</span>
          <span class="hero-letter">E</span>
        </div>
      </div>
    </section>

    <!-- ─── ABOUT ─────────────────────────────────────────────────────────── -->
    <section class="about-section">
      <div class="about-content">

        <!-- Always visible — no data-animate on the name block -->
        <div class="about-description">
          <p class="about-lead">Andre Walters</p>
          <p class="about-subline">Software Developer & Electronics Engineer</p>
        </div>

        <!-- Profile -->
        <div class="bio-row" data-animate>
          <div class="bio-label"><h2>Profile</h2></div>
          <div class="bio-text">
            <p>Andre Walters is a software developer and electronics engineer based in Jamaica.</p>
            <p>His work spans full-stack development, digital product design, and hardware-software integrations, with experience building scalable systems using React, Angular, Node.js, and modern cloud architectures.</p>
            <p>Andre previously contributed to enterprise platforms at Jamaica Public Service Company, helping evolve systems including the MyJPS Mobile App and internal customer experience platforms.</p>
            <p>He holds a Bachelor of Science in Electronics Engineering from The University of the West Indies, Mona, and is currently pursuing a Master's in Computer-Based Management Information Systems.</p>
            <p>His approach blends engineering discipline with a creative perspective to design systems that are intuitive, resilient, and purposeful.</p>
            <p>When he's not coding, he's probably off-grid exploring waterfalls or soaking in the natural rhythm of Jamaica's rivers and beaches.</p>
          </div>
        </div>

        <!-- Experience -->
        <div class="bio-row" data-animate>
          <div class="bio-label"><h2>Experience</h2></div>
          <div class="bio-text">
            <h3>Software Developer</h3>
            <p><strong>Jamaica Public Service Company</strong> — Previous Role</p>
            <p>Contributed to enterprise platforms at JPS, helping evolve systems including the MyJPS Mobile App and internal customer experience platforms between 2021–2024.</p>
            <ul>
              <li>Full-stack development using React, Angular, and Node.js</li>
              <li>Modern cloud architectures and scalable system design</li>
              <li>Digital product design and user experience optimization</li>
              <li>Hardware-software integrations and IoT solutions</li>
            </ul>
            <h3>Senior Frontend Developer</h3>
            <p>Led development of complex web applications with a focus on performance, accessibility, and user experience.</p>
            <h3>Technical Consultant</h3>
            <p>Provided strategic guidance on technology implementation and digital transformation initiatives.</p>
          </div>
        </div>

        <!-- Education -->
        <div class="bio-row" data-animate>
          <div class="bio-label"><h2>Education</h2></div>
          <div class="bio-text">
            <h3>Master's in Computer-Based Management Information Systems</h3>
            <p><strong>Currently Pursuing</strong></p>
            <h3>Bachelor of Science in Electronics Engineering</h3>
            <p><strong>The University of the West Indies, Mona</strong></p>
          </div>
        </div>

        <!-- Achievements -->
        <div class="bio-row" data-animate>
          <div class="bio-label"><h2>Achievements</h2></div>
          <div class="bio-text">
            <h3>Technical Excellence</h3>
            <p>Helped evolve and modernize critical features in the MyJPS Mobile App and Harmony Customer Experience Platform, recognized for blending a sharp creative eye with technical resilience.</p>
            <h3>Design Innovation</h3>
            <p>Bridges engineering discipline with a creative perspective to deliver intuitive, user-centered digital experiences.</p>
            <h3>Community Impact</h3>
            <p>Contributions to open-source projects and tech community initiatives across the Caribbean region.</p>
          </div>
        </div>

        <!-- Interests -->
        <div class="bio-row" data-animate>
          <div class="bio-label"><h2>Interests</h2></div>
          <div class="bio-text">
            <h3>Emerging Technologies</h3>
            <p>Passionate about hardware-software integrations and IoT solutions that bridge the physical and digital worlds.</p>
            <h3>Digital Art & Design</h3>
            <p>Creative expression through digital mediums and interactive installations, applying engineering discipline to creative challenges.</p>
            <h3>Community Building</h3>
            <p>Fostering tech communities and knowledge sharing in the Caribbean region.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ─── EXPERTISE ─────────────────────────────────────────────────────── -->
    <section class="expertise">
      <div class="expertise-container">
        <div class="expertise-header">
          <h2 class="expertise-title">EXPERTISE</h2>
        </div>
        <div class="expertise-grid">
          {pageData.offerings.map((offering, index) => (
            <div class="card" data-animate>
              <div class="card-number">0{index + 1}</div>
              <h3 class="card-title">{offering.title}</h3>
              <div class="card-divider"></div>
              <p class="card-subtitle">{offering.description}</p>
              <div class="card-related">
                <h4 class="related-title">Related</h4>
                <div class="related-tags">
                  {offering.related.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    
  </main>

  <Footer />

</Layout>