---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

// Define constants for better maintainability
const HERO_LETTERS = ['A', 'L', 'D', 'E', 'N'];
const EXPERTISE_ITEMS = [
  'Software Development',
  'UI / VISUAL DESIGN',
  'USER EXPERIENCE DESIGN',
  'enterprise design thinking',
  'RESEARCH / STRATEGY',
  'BRAND MANAGEMENT'
];

// Featured projects with live URLs
const FEATURED_PROJECTS = [
  {
    title: "CDT JAMAICA",
    category: "DIGITAL PLATFORM",
    href: "https://cdtjamaica.org",
    liveUrl: "https://cdtjamaica.org",
    image: "https://framerusercontent.com/images/o6w4CVRNseGWbrL67Z02tHFMU.png",
    imageW: 1628,
    imageH: 1119
  },
  {
    title: "TOTALLY BAKED",
    category: "E-COMMERCE",
    href: "https://totally-baked-ja.vercel.app",
    liveUrl: "https://totally-baked-ja.vercel.app",
    image: "https://framerusercontent.com/images/XbAyT67MOmZ9iWY72g8FEkEZZFM.png",
    imageW: 2718,
    imageH: 1810
  },
  {
    title: "ZENITH TEAS",
    category: "TEA MANAGEMENT",
    href: "https://zenith-taupe.vercel.app",
    liveUrl: "https://zenith-taupe.vercel.app",
    image: "https://framerusercontent.com/images/TujYt1WY1IHHodeZrmAt5UobWY.png",
    imageW: 1792,
    imageH: 2490
  }
];
---

<Layout title="ALDEN | Sr Visual Designer">
  <Nav currentPage="home" />
  
  <!-- Animated Grain Overlay -->
  <div class="grain-overlay"></div>
  
  <!-- ─── FULL PAGE VIDEO BACKGROUND ──────────────────────────────────────── -->
  <div class="page-video-bg" id="pageVideoBg">
    <div class="page-dark-overlay"></div>
    
    <div class="page-video-wrap" id="pageVideoWrap">
      <video
        src="https://framerusercontent.com/assets/WTjKqrn8HNXvDANMM6KjIZoIHI.mp4"
        muted playsinline preload="auto"
        class="page-video"
      ></video>
    </div>
  </div>
  
  <main class="main">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-alden-logo">
        {HERO_LETTERS.map((letter, index) => (
          <div class="alden-letter" data-letter={letter} data-index={index}>
            {letter}
          </div>
        ))}
      </div>
      
      <div class="hero-content">
        <div class="hero-description">
          <div class="hero-role">
            <h2 class="hero-role-visual" data-animate-hero="visual" data-delay="0.6">Technology</h2>
            <h2 class="hero-role-swimmer" data-animate-hero="swimmer" data-delay="0.7">Visual Design</h2>
            <h2 class="hero-role-and" data-animate-hero="and" data-delay="0.8">Brand Systems</h2>
            <h2 class="hero-role-porsche" data-animate-hero="porsche" data-delay="0.9">
              <span class="fancy-creative">Creative</span> Production
            </h2>
          </div>
        </div>
        
        <div class="hero-scroll" data-animate-hero="scroll" data-delay="1.2">
          <span class="scroll-instruction">[SCROLL DOWN] 請下去 [DOWN]</span>
          <span class="scroll-text">[NICE TO MEET YOU]</span>
          <span class="scroll-chinese">「很高興見到你」</span>
        </div>
      </div>
      
      <div class="hero-background">
        <div class="hero-overlay"></div>
        <video class="hero-video" src="/videos/hero-background.mp4" autoplay loop muted playsinline></video>
      </div>
    </section>
    
    <!-- Featured Work Section -->
    <section class="featured-work">
      <div class="featured-work-container">
        <h2 class="featured-work-title" data-animate-hero="featured-title" data-delay="1.2">FEATURED PROJECTS</h2>
        
        <!-- Horizontal scroll gallery (larger tiles) -->
        <div class="hscroll-outer" id="hscrollOuter">
          <div class="hscroll-sticky">
            <div class="hscroll-track" id="hscrollTrack">
              {FEATURED_PROJECTS.map((project, index) => (
                <div class="work-card" aria-label={`${project.title} Project`} data-animate-hero={`tile-${index + 1}`} data-delay={1.6 + (index * 0.4)}>
                  <div class="work-card-bg">
                    {project.liveUrl ? (
                      <iframe
                        src={project.liveUrl}
                        title={`${project.title} Live Preview`}
                        loading="lazy"
                        class="work-card-live-preview"
                        sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                        referrerpolicy="no-referrer"
                        allowfullscreen
                      ></iframe>
                    ) : (
                      <img
                        src={`${project.image}?scale-down-to=1024&width=${project.imageW}&height=${project.imageH}`}
                        width={project.imageW} height={project.imageH}
                        loading="eager"
                        alt={`${project.title} project`}
                        class="work-card-bg-img"
                      />
                    )}
                  </div>
                  <div class="work-card-labels">
                    <span class="work-card-title-text">{project.title}</span>
                    <span class="work-card-category-text">{project.category}</span>
                  </div>
                  {project.liveUrl && (
                    <a href={project.liveUrl} target="_blank" class="work-card-live-link">
                      <span class="live-link-text">VIEW LIVE SITE →</span>
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
        
        <a href="/work" class="work-divider-link" data-animate>
          <div class="work-divider">
            <div class="divider-line"></div>
            <div class="divider-text">View Full Work</div>
            <div class="divider-line"></div>
          </div>
        </a>
      </div>
    </section>
    
    <!-- Info Section -->
    <section class="info">
      <div class="info-hero">
        <div class="info-left">
          <h2 class="info-hero-in">INFO</h2>
        </div>
      </div>
      
      <div class="info-content">
        <h3 class="info-title">
          A <span class="title-bracket">[</span>multidisciplinary<span class="title-bracket">]</span> 
          perspective informed by <span class="title-name">technology</span>, 
          <span class="title-name">design</span>, and <span class="title-name">brand strategy</span>.
        </h3>
        
        <div class="info-text">
          <p>A multidisciplinary perspective informed by technology, design, and brand strategy.</p>
          <p>A strategic approach led by clarity, precision, and intent.</p>
          <p>Every digital experience is engineered to be intuitive, scalable, and enduring.</p>
        </div>
        
      </div>
      
      <div class="info-divider">
        <div class="divider-line"></div>
        <div class="divider-text">﹁<br />技<br />術<br />﹂</div>
        <div class="divider-line"></div>
      </div>
      
      <div class="info-expertise">
        <div class="expertise-right">
          <h4 class="expertise-title">
            <span class="expertise-quiet">Quietly</span> <span class="expertise-powerful">powerful</span>
            Digital Experiences
          </h4>
          <p class="expertise-description">
            Design to me is a bridge between emotion and function. My goal has always been to 
            elevate everyday interactions into something more meaningful and crucially, quietly 
            threading in moments of joy that catch us by surprise and stay with us for years to come.
          </p>
          <Button href="/info" variant="light" chineseText="all caqps" class="hover-lift" style="color: #2f2f2f !important; text-shadow: 0 0 8px rgba(255,255,255,0.8) !important; background: rgba(255,255,255,0.1) !important; padding: 20px 32px !important; border: 1px solid rgba(47,47,47,0.3) !important; mix-blend-mode: normal !important; font-size: 18px !important; letter-spacing: 1px !important; line-height: 1.6 !important; min-height: 60px !important;">
            all caqps
          </Button>
        </div>
        
        <div class="expertise-list" data-animate>
          <span class="list-label">[EXPERTISE AND SERVICES]</span>
          <div class="list-items">
            {EXPERTISE_ITEMS.map((item, index) => (
              <div class="list-item" style={`--delay: ${index * 0.1}s`}>{item}</div>
            ))}
          </div>
        </div>
      </div>
    </section>
    
    <Footer />
  </main>
</Layout>

<style is:global>
/* ===== CSS VARIABLES ===== */
:root {
  --font-koulen: 'Koulen', sans-serif;
  --font-roboto-mono: 'Roboto Mono', monospace;
  --font-albert-sans: 'Albert Sans', sans-serif;
  
  --token-bg-dark: #0a0a0a;
  --token-text-light: #ffffff;
  --token-text-dark: #333333;
  --token-accent-gold: #d4af37;
  
  --container-padding: 24px;
  --container-padding-mobile: 16px;
  --container-max-width: 2500px;
}

/* ===== BREAKPOINTS ===== */
/* @custom-media --mobile (max-width: 809.98px);
@custom-media --tablet (min-width: 810px) and (max-width: 1199.98px);
@custom-media --desktop-small (min-width: 1200px) and (max-width: 1499.98px);
@custom-media --desktop-medium (min-width: 1500px) and (max-width: 1999.98px);
@custom-media --desktop-large (min-width: 2000px); */

/* ===== BASE STYLES ===== */
.main {
  width: 100%;
  max-width: var(--container-max-width);
  margin: 0 auto;
  background: transparent;
  position: relative;
}

/* Background pattern removed */

/* ===== ANIMATED GRAIN OVERLAY ===== */
.grain-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
  opacity: 0.01;
  background-image: 
    radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0),
    radial-gradient(circle at 2px 2px, rgba(255,255,255,0.2) 1px, transparent 0),
    radial-gradient(circle at 3px 3px, rgba(255,255,255,0.1) 1px, transparent 0);
  background-size: 50px 50px, 30px 30px, 20px 20px;
  background-position: 0 0, 10px 10px, 20px 20px;
  animation: grain-move 8s steps(10) infinite;
  filter: blur(0.5px);
  mix-blend-mode: overlay;
}

@keyframes grain-move {
  0%, 100% {
    transform: translate(0, 0);
    background-position: 0 0, 10px 10px, 20px 20px;
  }
  10% {
    transform: translate(-5px, -10px);
    background-position: 5px 5px, 15px 15px, 25px 25px;
  }
  20% {
    transform: translate(-10px, 5px);
    background-position: 10px 10px, 20px 20px, 30px 30px;
  }
  30% {
    transform: translate(5px, -5px);
    background-position: 15px 15px, 25px 25px, 35px 35px;
  }
  40% {
    transform: translate(-15px, -15px);
    background-position: 20px 20px, 30px 30px, 40px 40px;
  }
  50% {
    transform: translate(10px, 10px);
    background-position: 25px 25px, 35px 35px, 45px 45px;
  }
  60% {
    transform: translate(-20px, 5px);
    background-position: 30px 30px, 40px 40px, 50px 50px;
  }
  70% {
    transform: translate(15px, -10px);
    background-position: 35px 35px, 45px 45px, 55px 55px;
  }
  80% {
    transform: translate(-5px, 20px);
    background-position: 40px 40px, 50px 50px, 60px 60px;
  }
  90% {
    transform: translate(25px, -25px);
    background-position: 45px 45px, 55px 55px, 65px 65px;
  }
}

/* ===== TYPOGRAPHY UTILITIES ===== */
.fancy-creative {
  font-family: 'Pinyon Script', cursive;
  color: var(--token-accent-gold);
  letter-spacing: 0.2em;
  font-size: 0.7em;
}

.chinese-text {
  font-family: 'HanyiSentyFoundation Regular', sans-serif;
  color: var(--token-accent-gold);
}

/* ===== HERO SECTION ===== */
.hero {
  position: relative;
  min-height: 100vh;
  padding-top: 200px;
  padding-bottom: 2020px;
  overflow: visible;
  background: transparent;
}

@media (--mobile) {
  .hero {
    padding-top: 150px;
  }
}

.hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* Alden Logo Letters */
.hero-alden-logo {
  position: absolute;
  top: 32%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  z-index: 5;
  cursor: pointer;
  
  @media (max-width: 809px) {
    top: 20%;
    gap: 5px;
    flex-wrap: wrap;
  }
}

.alden-letter {
  font-family: var(--font-koulen);
  font-size: 600px;
  line-height: 0.8;
  color: var(--token-text-light);
  opacity: 0.001;
  will-change: transform, opacity;
  transition: all 0.8s cubic-bezier(0.55, 0.45, 0.16, 1);
  
  @media (min-width: 2000px) { font-size: 940px; }
  @media (min-width: 1500px) and (max-width: 1999px) { font-size: 670px; }
  @media (min-width: 1200px) and (max-width: 1499px) { font-size: 470px; }
  @media (min-width: 810px) and (max-width: 1199px) { font-size: 350px; }
  @media (max-width: 809px) { 
    font-size: 120px;
    transform: none;
  }
  
  &:nth-child(odd) { transform: translateX(-100px); }
  &:nth-child(even) { transform: translateX(100px); }
  
  @media (max-width: 809px) {
    &:nth-child(odd),
    &:nth-child(even) {
      transform: none;
    }
  }
}

/* Hero Content */
.hero-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 1100px var(--container-padding) 100px;
  z-index: 2;
  box-sizing: border-box;
  gap: 20px;
  
  @media (max-width: 809px) {
    padding: 750px var(--container-padding-mobile) 80px;
    align-items: stretch;
  }
}

/* Hero Role Headings */
.hero-role {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 120px;
  transform: translateX(50px);
  gap: 20px;
  
  @media (min-width: 1200px) and (max-width: 1499px) { margin-bottom: 156px; }
  @media (min-width: 810px) and (max-width: 1199px) { margin-bottom: 132px; }
  @media (max-width: 809px) { 
    margin-bottom: 40px;
    gap: 10px;
  }
}

.hero-role-visual,
.hero-role-swimmer,
.hero-role-and,
.hero-role-porsche {
  font-size: 80px;
  font-family: var(--font-koulen);
  color: var(--token-text-light);
  display: block;
  text-align: left;
  
  @media (min-width: 2000px) { font-size: 244px; }
  @media (min-width: 1500px) and (max-width: 1999px) { font-size: 182px; }
  @media (min-width: 1200px) and (max-width: 1499px) { font-size: 142px; }
  @media (min-width: 810px) and (max-width: 1199px) { font-size: 92px; }
  @media (max-width: 809px) { font-size: 39px; }
}

/* Hero Bio */
.hero-bio {
  width: 28%;
  margin: 0 auto 40px auto;
  text-align: center;
  
  @media (min-width: 2000px) { width: 21%; }
  @media (min-width: 1500px) and (max-width: 1999px) { width: 32%; }
  @media (min-width: 1200px) and (max-width: 1499px) { width: 32%; }
  @media (min-width: 810px) and (max-width: 1199px) { width: 49%; }
  @media (max-width: 809px) { 
    width: 100%; 
    margin: 0 0 20px 0;
    text-align: left;
  }
}

.hero-job-title,
.hero-location {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  color: var(--token-accent-gold);
  display: block;
  margin: 0.5em 0;
}

.hero-job-title {
  font-weight: 600;
}

.hero-location {
  text-align: justify;
  line-height: 1.4;
  margin-top: 0.5em;
}

/* Hero Scroll */
.hero-scroll {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  max-width: calc(100% - 48px);
  padding: 0 var(--container-padding);
  z-index: 2;
  margin-top: auto;
  
  @media (--mobile) {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 0 var(--container-padding-mobile);
  }
}

.scroll-text,
.scroll-chinese,
.scroll-instruction {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 0.83;
  color: var(--token-text-light);
}

.scroll-chinese {
  font-family: 'HanyiSentyFoundation Regular', sans-serif;
  letter-spacing: -0.07em;
}

/* Hero Background & Video */
.hero-background {
  position: absolute;
  top: -79px;
  left: 0;
  width: 100%;
  min-height: calc(100vh + 2150px);
  z-index: 1;
  pointer-events: none;
  
  @media (--desktop-large) { height: 360vh; }
  @media (--desktop-small) { 
    height: 350vh;
    top: -200px;
  }
  @media (--tablet) { 
    height: 320vh;
    top: -70px;
  }
  @media (--mobile) { 
    height: 330vh;
    top: -10px;
  }
}

.hero-video {
  position: absolute;
  top: -708px;
  left: -1.5%;
  width: 103%;
  height: 111%;
  object-fit: cover;
  filter: brightness(1.01);
  z-index: 1;
  transform: scale(1.1);
  
  @media (--desktop-large) { top: -1000px; }
  @media (--desktop-small) { top: -658px; }
  @media (--tablet) { 
    top: -500px;
    height: 120%;
  }
  @media (--mobile) { 
    top: 0;
    transform: scale(1.5);
  }
}

@keyframes scaleIn {
  to { transform: scale(1); }
}

/* ═══════════════════════════════════════════════════════════════════
   FULL PAGE VIDEO BACKGROUND
═══════════════════════════════════════════════════════════════════ */
.page-video-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  pointer-events: none;
}

.page-dark-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
  background: linear-gradient(#0000 0%, #000 34.9539%);
  pointer-events: none;
}

.page-video-wrap {
  position: absolute;
  top: -50px;
  left: -10%;
  width: 120%;
  height: 120%;
  z-index: 1;
  filter: brightness(0.95) blur(12px) saturate(0.7);
  will-change: transform;
  transform-origin: center center;
  transform: scale(1.01);
  animation: page-video-in 1.2s cubic-bezier(0.58,-0.13,0.17,1.02) 2.6s forwards;
  clip-path: inset(50px round 0px);
}

@keyframes page-video-in { to { transform: scale(1); } }

.page-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Work Section Separator */
.work-separator {
  text-align: center;
  margin: 80px 0 60px;
  position: relative;
}

.work-separator-text {
  font-family: var(--font-koulen);
  font-size: 24px;
  color: var(--token-text-light);
  opacity: 0.6;
  letter-spacing: 0.1em;
  line-height: 1.2;
}

/* Featured Work Section */
.featured-work {
  background: transparent;
  position: relative;
  padding: 80px 0 0;
}

.featured-work-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 40px;
  text-align: center;
  
  @media (max-width: 809px) {
    padding: 0 20px;
  }
}

.featured-work-title {
  font-family: var(--font-koulen);
  font-size: 180px;
  line-height: 0.6;
  color: #ffffff;
  margin-bottom: 0;
  letter-spacing: -0.02em;
  text-align: center;
  white-space: nowrap;
  text-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
  mix-blend-mode: screen;
  
  @media (min-width: 1200px) and (max-width: 1499px) { 
    font-size: 150px; 
    margin-bottom: 0;
  }
  @media (min-width: 810px) and (max-width: 1199px) { 
    font-size: 120px; 
    margin-bottom: 0;
  }
  @media (max-width: 809px) { 
    font-size: 90px; 
    margin-bottom: 0;
  }
}

/* Work Gallery (horizontal scroll with larger tiles) */
.hscroll-outer {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 200px;
}

.hscroll-sticky {
  position: relative;
  height: auto;
  overflow: visible;
  display: flex;
  align-items: center;
}

.hscroll-track {
  position: relative;
  display: flex;
  gap: 30px;
  
  @media (max-width: 809px) {
    gap: 20px;
  }
}

/* ── Project cards (matching work page style) */
.work-card {
  --cw: 685px;
  --ch: 528px;
  flex: none;
  width: var(--cw);
  height: var(--ch);
  position: relative;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  /* Override Layout's blanket transition, use our own */
  transition: transform 0.5s cubic-bezier(0.22,1,0.36,1) !important;
}
.work-card:hover { transform: scale(1.02); }

/* Portrait cards */
.work-card:nth-child(5),
.work-card:nth-child(7) { --cw: 380px; --ch: 580px; }

.work-card-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.85);
  transition: filter 0.45s cubic-bezier(0.22,1,0.36,1),
              opacity 0.45s cubic-bezier(0.22,1,0.36,1) !important;
}

.work-card-live-preview {
  width: 100%;
  height: 100%;
  border: none;
  border-radius: 12px;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  object-fit: cover;
}

.work-card-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: none !important;
}
.work-card:hover .work-card-bg {
  filter: blur(10px) brightness(0.5);
  opacity: 0.4;
}

.work-card-live-link {
  position: absolute;
  bottom: 16px;
  right: 16px;
  z-index: 3;
  background: rgba(255, 215, 0, 0.9);
  color: #000;
  padding: 8px 16px;
