---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

// Define constants for better maintainability
const HERO_LETTERS = ['A', 'L', 'D', 'E', 'N'];
const EXPERTISE_ITEMS = [
  'Art direction',
  'UI / VISUAL DESIGN',
  'USER EXPERIENCE DESIGN',
  'enterprise design thinking',
  'RESEARCH / STRATEGY',
  'BRAND IDENTITY'
];
---

<Layout title="AL DEN DS GNS | Sr Visual Designer">
  <div class="bg-pattern" data-parallax="0.2"></div>
  <Nav currentPage="home" />
  
  <main class="main">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-alden-logo">
        {HERO_LETTERS.map((letter, index) => (
          <div class="alden-letter" data-letter={letter} data-index={index}>
            {letter}
          </div>
        ))}
      </div>
      
      <div class="hero-content">
        <div class="hero-description">
          <div class="hero-role">
            <h2 class="hero-role-visual" data-animate-hero="visual" data-delay="0.6">Technology</h2>
            <h2 class="hero-role-swimmer" data-animate-hero="swimmer" data-delay="0.7">Visual Design</h2>
            <h2 class="hero-role-and" data-animate-hero="and" data-delay="0.8">Brand Systems</h2>
            <h2 class="hero-role-porsche" data-animate-hero="porsche" data-delay="0.9">
              <span class="fancy-creative">Creative</span> Production
            </h2>
          </div>
          
          <div class="hero-bio" data-animate-hero="bio" data-delay="1.0">
            <p class="hero-bio-title">
              <span class="hero-job-title">SR SOFTWARE AND USER EXP</span>
              <span class="hero-location">BASED IN KINGSTON JAMAICA I partner with brands, companies and entrepreneurs to transform visions into captivating experiences, all designed with the users at the helm.</span>
            </p>
          </div>
        </div>
        
        <div class="hero-scroll" data-animate-hero="scroll" data-delay="1.5">
          <span class="scroll-text">[NICE TO MEET YOU]</span>
          <span class="scroll-chinese">「很高興見到你」</span>
          <span class="scroll-instruction">[SCROLL DOWN] 請下去 [DOWN]</span>
        </div>
      </div>
      
      <div class="hero-background">
        <div class="hero-overlay"></div>
        <video class="hero-video" src="/videos/hero-background.mp4" autoplay loop muted playsinline></video>
      </div>
    </section>
    
    <!-- Info Section -->
    <section class="info">
      <div class="info-hero">
        <h2 class="info-hero-in">IN</h2>
        <div class="info-hero-chinese">
          <span class="chinese-bracket">﹁</span>
          <span class="chinese-char">簡</span>
          <span class="chinese-char">介</span>
          <span class="chinese-bracket">﹂</span>
        </div>
        <h2 class="info-hero-fo">FO</h2>
      </div>
      
      <div class="info-content">
        <h3 class="info-title">
          A <span class="title-bracket">[</span>cross-cultural<span class="title-bracket">]</span> 
          perspective shaped by <span class="title-name">Hong Kong</span> roots and 
          <span class="title-name">English</span> countryside.
        </h3>
        
        <div class="info-text">
          <p>A multidisciplinary perspective informed by technology, design, and brand strategy.</p>
          <p>A strategic approach led by clarity, precision, and intent.</p>
          <p>Every digital experience is engineered to be intuitive, scalable, and enduring.</p>
        </div>
        
        <Button href="/info" variant="light" chineseText="讀我的故事" class="hover-lift">
          READ MY STORY
        </Button>
      </div>
      
      <div class="info-divider">
        <div class="divider-line"></div>
        <div class="divider-text">﹁<br />技<br />術<br />﹂</div>
        <div class="divider-line"></div>
      </div>
      
      <div class="info-expertise">
        <div class="expertise-left">
          <img src="/images/expertise.jpg" alt="" class="expertise-image image-hover" loading="lazy" />
        </div>
        
        <div class="expertise-right">
          <h4 class="expertise-title">
            <span class="expertise-quiet">Quietly</span> <span class="expertise-powerful">powerful</span>
            Digital Experiences
          </h4>
          <p class="expertise-description">
            Design to me is a bridge between emotion and function. My goal has always been to 
            elevate everyday interactions into something more meaningful and crucially, quietly 
            threading in moments of joy that catch us by surprise and stay with us for years to come.
          </p>
          <Button href="/info" variant="light" chineseText="讀我的故事" class="hover-lift">
            READ MY STORY
          </Button>
        </div>
        
        <div class="expertise-list">
          <span class="list-label">[EXPERTISE AND SERVICES]</span>
          <div class="list-items">
            {EXPERTISE_ITEMS.map(item => (
              <div class="list-item">{item}</div>
            ))}
          </div>
        </div>
      </div>
    </section>
    
    <Footer />
  </main>
</Layout>

<style is:global>
/* ===== CSS VARIABLES ===== */
:root {
  --font-koulen: 'Koulen', sans-serif;
  --font-roboto-mono: 'Roboto Mono', monospace;
  --font-albert-sans: 'Albert Sans', sans-serif;
  
  --token-bg-dark: #0a0a0a;
  --token-text-light: #ffffff;
  --token-text-dark: #333333;
  --token-accent-gold: #d4af37;
  
  --container-padding: 24px;
  --container-padding-mobile: 16px;
  --container-max-width: 2500px;
}

/* ===== BREAKPOINTS ===== */
/* @custom-media --mobile (max-width: 809.98px);
@custom-media --tablet (min-width: 810px) and (max-width: 1199.98px);
@custom-media --desktop-small (min-width: 1200px) and (max-width: 1499.98px);
@custom-media --desktop-medium (min-width: 1500px) and (max-width: 1999.98px);
@custom-media --desktop-large (min-width: 2000px); */

/* ===== BASE STYLES ===== */
.main {
  width: 100%;
  max-width: var(--container-max-width);
  margin: 0 auto;
  background: var(--token-bg-dark);
  position: relative;
}

/* Background pattern (shared) */
.bg-pattern,
.hero::before,
.info::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('https://framerusercontent.com/images/rR6HYXBrMmX4cRpXfXUOvpvpB0.png');
  background-repeat: repeat;
  background-size: 256px 256px;
  opacity: 0.05;
  pointer-events: none;
  z-index: 0;
}

/* ===== TYPOGRAPHY UTILITIES ===== */
.fancy-creative {
  font-family: 'Pinyon Script', cursive;
  color: var(--token-accent-gold);
  letter-spacing: 0.2em;
  font-size: 0.7em;
}

.chinese-text {
  font-family: 'HanyiSentyFoundation Regular', sans-serif;
  color: var(--token-accent-gold);
}

/* ===== HERO SECTION ===== */
.hero {
  position: relative;
  min-height: 100vh;
  padding-top: 200px;
  padding-bottom: 2020px;
  overflow: visible;
}

@media (--mobile) {
  .hero {
    padding-top: 150px;
  }
}

.hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* Alden Logo Letters */
.hero-alden-logo {
  position: absolute;
  top: 32%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  z-index: 5;
  cursor: pointer;
  
  @media (max-width: 809px) {
    top: 20%;
    gap: 5px;
    flex-wrap: wrap;
  }
}

.alden-letter {
  font-family: var(--font-koulen);
  font-size: 600px;
  line-height: 0.8;
  color: var(--token-text-light);
  opacity: 0.001;
  will-change: transform, opacity;
  transition: all 0.8s cubic-bezier(0.55, 0.45, 0.16, 1);
  
  @media (min-width: 2000px) { font-size: 940px; }
  @media (min-width: 1500px) and (max-width: 1999px) { font-size: 670px; }
  @media (min-width: 1200px) and (max-width: 1499px) { font-size: 470px; }
  @media (min-width: 810px) and (max-width: 1199px) { font-size: 350px; }
  @media (max-width: 809px) { 
    font-size: 120px;
    transform: none;
  }
  
  &:nth-child(odd) { transform: translateX(-100px); }
  &:nth-child(even) { transform: translateX(100px); }
  
  @media (max-width: 809px) {
    &:nth-child(odd),
    &:nth-child(even) {
      transform: none;
    }
  }
}

/* Hero Content */
.hero-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  padding: 1100px var(--container-padding) 100px;
  z-index: 2;
  box-sizing: border-box;
  
  @media (max-width: 809px) {
    padding: 750px var(--container-padding-mobile) 80px;
    align-items: stretch;
  }
}

/* Hero Role Headings */
.hero-role {
  display: flex;
  flex-direction: column;
  margin-bottom: 120px;
  text-align: left;
  
  @media (min-width: 1200px) and (max-width: 1499px) { margin-bottom: 156px; }
  @media (min-width: 810px) and (max-width: 1199px) { margin-bottom: 132px; }
  @media (max-width: 809px) { margin-bottom: 40px; }
}

.hero-role-visual,
.hero-role-swimmer,
.hero-role-and,
.hero-role-porsche {
  font-size: 80px;
  font-family: var(--font-koulen);
  color: var(--token-text-light);
  display: block;
  text-align: left;
  
  @media (min-width: 2000px) { font-size: 244px; }
  @media (min-width: 1500px) and (max-width: 1999px) { font-size: 182px; }
  @media (min-width: 1200px) and (max-width: 1499px) { font-size: 142px; }
  @media (min-width: 810px) and (max-width: 1199px) { font-size: 92px; }
  @media (max-width: 809px) { font-size: 39px; }
}

/* Hero Bio */
.hero-bio {
  width: 28%;
  
  @media (min-width: 2000px) { width: 21%; }
  @media (min-width: 1500px) and (max-width: 1999px) { width: 32%; }
  @media (min-width: 1200px) and (max-width: 1499px) { width: 32%; }
  @media (min-width: 810px) and (max-width: 1199px) { width: 49%; }
  @media (max-width: 809px) { width: 100%; }
}

.hero-bio-title {
  font-family: var(--font-roboto-mono);
  font-weight: 600;
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-light);
  margin-bottom: 1em;
}

.hero-job-title,
.hero-location {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  color: var(--token-accent-gold);
  display: block;
}

.hero-job-title {
  margin-bottom: 8px;
  font-weight: 600;
}

/* Hero Scroll */
.hero-scroll {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  max-width: calc(100% - 48px);
  padding: 0 var(--container-padding);
  z-index: 2;
  margin-top: auto;
  
  @media (--mobile) {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 0 var(--container-padding-mobile);
  }
}

.scroll-text,
.scroll-chinese,
.scroll-instruction {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 0.83;
  color: var(--token-text-light);
}

.scroll-chinese {
  font-family: 'HanyiSentyFoundation Regular', sans-serif;
  letter-spacing: -0.07em;
}

/* Hero Background & Video */
.hero-background {
  position: absolute;
  top: -79px;
  left: 0;
  width: 100%;
  min-height: calc(100vh + 2150px);
  z-index: 1;
  pointer-events: none;
  
  @media (--desktop-large) { height: 360vh; }
  @media (--desktop-small) { 
    height: 350vh;
    top: -200px;
  }
  @media (--tablet) { 
    height: 320vh;
    top: -70px;
  }
  @media (--mobile) { 
    height: 330vh;
    top: -10px;
  }
}

.hero-video {
  position: absolute;
  top: -708px;
  left: -1.5%;
  width: 103%;
  height: 111%;
  object-fit: cover;
  filter: brightness(1.01);
  z-index: 1;
  transform: scale(1.1);
  
  @media (--desktop-large) { top: -1000px; }
  @media (--desktop-small) { top: -658px; }
  @media (--tablet) { 
    top: -500px;
    height: 120%;
  }
  @media (--mobile) { 
    top: 0;
    transform: scale(1.5);
  }
}

@keyframes scaleIn {
  to { transform: scale(1); }
}

/* ===== INFO SECTION ===== */
.info {
  background: var(--token-bg-dark);
  padding: 180px 0 500px;
  position: relative;
  z-index: 2;
  overflow: hidden;
  
  @media (min-width: 1200px) and (max-width: 1499px) { padding: 38px 0 150px; }
  @media (min-width: 810px) and (max-width: 1199px) { padding: 31px 0 150px; }
  @media (max-width: 809px) { padding: 0 var(--container-padding-mobile) 32px; }
}

.info::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* Info Hero */
.info-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 97%;
  margin: 0 auto;
  position: relative;
  min-height: 800px;
  
  @media (min-width: 810px) and (max-width: 1199px) { 
    align-items: flex-start;
    padding: 40px 0 0;
  }
  @media (max-width: 809px) { 
    width: 100%;
    min-height: 500px;
    padding: 48px 0 0;
  }
}

.info-hero-in,
.info-hero-fo {
  font-family: var(--font-koulen);
  font-size: 670px;
  line-height: 0.7;
  color: var(--token-text-light);
  
  @media (min-width: 2000px) { font-size: 940px; }
  @media (min-width: 1500px) and (max-width: 1999px) { font-size: 510px; }
  @media (min-width: 1200px) and (max-width: 1499px) { font-size: 350px; }
  @media (min-width: 810px) and (max-width: 1199px) { font-size: 181px; }
  @media (max-width: 809px) { 
    position: absolute;
    top: 60px;
    font-size: 120px;
  }
}

.info-hero-in {
  @media (max-width: 809px) { left: 0; }
}

.info-hero-fo {
  letter-spacing: -0.02em;
  
  @media (min-width: 2000px) { letter-spacing: -0.04em; }
  @media (max-width: 809px) { right: 0; }
}

.info-hero-chinese {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  
  @media (min-width: 810px) and (max-width: 1199px) { top: 54%; }
  @media (max-width: 809px) { 
    top: 30px;
    transform: translateX(-50%);
  }
  
  .chinese-char,
  .chinese-bracket {
    font-size: 156px;
    color: var(--token-accent-gold);
    
    @media (min-width: 1200px) and (max-width: 1499px) { font-size: 126px; }
    @media (min-width: 810px) and (max-width: 1199px) { font-size: 86px; }
    @media (max-width: 809px) { font-size: 73px; }
  }
}

/* Info Content */
.info-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 211px;
  width: 100%;
  padding: 0 150px;
  margin-top: 50px;
  
  @media (min-width: 2000px) { gap: 188px; }
  @media (min-width: 1200px) and (max-width: 1499px) { 
    padding: 0;
    gap: 188px;
  }
  @media (min-width: 810px) and (max-width: 1199px) { gap: 123px; }
  @media (max-width: 809px) { 
    gap: 100px;
    padding: 0;
  }
}

.info-title {
  width: 96%;
  font-family: var(--font-koulen);
  font-size: 74px;
  line-height: 1;
  text-align: center;
  color: var(--token-text-light);
  
  @media (min-width: 2000px) { width: 70%; }
  @media (min-width: 1500px) and (max-width: 1999px) { font-size: 63px; }
  @media (min-width: 1200px) and (max-width: 1499px) { 
    width: 114%;
    font-size: 44px;
  }
  @media (min-width: 810px) and (max-width: 1199px) { 
    width: 137%;
    font-size: 44px;
  }
  @media (max-width: 809px) { 
    width: 100%;
    font-size: 36px;
  }
}

.title-bracket {
  font-family: var(--font-albert-sans);
}

.title-name {
  font-family: 'Pinyon Script', cursive;
  color: var(--token-accent-gold);
}

.info-text {
  width: 42%;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 49px;
  
  @media (--desktop-large) { width: 29%; }
  @media (--desktop-small) { width: 52%; }
  @media (--tablet) { width: 77%; }
  @media (--mobile) { width: 100%; }
  
  p {
    font-family: var(--font-roboto-mono);
    font-size: 14px;
    line-height: 1.4;
    color: var(--token-text-light);
  }
}

/* Info Divider */
.info-divider {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 70px;
  padding: 0 var(--container-padding);
  margin: 87px 0;
  
  @media (--mobile) { 
    gap: 20px;
    padding: 0;
  }
}

.divider-line {
  flex: 1;
  height: 1px;
  background: var(--token-text-light);
}

.divider-text {
  font-family: 'HanyiSentyFoundation Regular', sans-serif;
  font-size: 26px;
  line-height: 1.1;
  color: var(--token-text-light);
  text-align: center;
}

/* Expertise Section */
.info-expertise {
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  padding: 117px var(--container-padding) 0;
  gap: 20px;
  
  @media (--desktop-large) { padding: 117px var(--container-padding) 100px; }
  @media (--mobile) { 
    flex-direction: column;
    gap: 30px;
    padding: 35px 0 0;
  }
}

.expertise-left {
  width: 35%;
  position: relative;
  
  @media (--tablet) { width: 35%; }
  @media (--mobile) { 
    width: 100%;
    order: 1;
    padding-top: 70px;
  }
}

.expertise-image {
  width: 100%;
  height: auto;
  object-fit: cover;
  
  @media (--mobile) { height: 321px; }
}

.expertise-right {
  width: 65%;
  padding-left: 20px;
  
  @media (--desktop-large) { width: 65%; }
  @media (--desktop-small) { width: 70%; }
  @media (--tablet) { width: 82%; }
  @media (--mobile) { 
    width: 100%;
    padding-left: 0;
    order: 0;
  }
}

.expertise-title {
  font-family: var(--font-koulen);
  font-size: 34px;
  line-height: 1;
  color: var(--token-text-dark);
  margin-bottom: 12px;
  
  @media (--tablet) { font-size: 31px; }
  @media (--mobile) { font-size: 28px; }
}

.expertise-quiet {
  color: var(--token-text-light);
}

.expertise-powerful {
  font-family: 'Pinyon Script', cursive;
}

.expertise-description {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-dark);
  margin-bottom: 34px;
  max-width: 45%;
  
  @media (--desktop-large) { max-width: 46%; }
  @media (--desktop-small) { max-width: 51%; }
  @media (--tablet) { max-width: 82%; }
  @media (--mobile) { max-width: 100%; }
}

.expertise-list {
  margin-top: 40px;
  width: 45%;
  
  @media (--desktop-large) { width: 46%; }
  @media (--desktop-small) { width: 51%; }
  @media (--mobile) { 
    width: 100%;
    order: 3;
    margin-top: 20px;
  }
}

.list-label {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  color: var(--token-accent-gold);
  display: block;
  margin-bottom: 20px;
}

.list-items {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.list-item {
  font-family: var(--font-koulen);
  font-size: 37px;
  line-height: 1;
  color: var(--token-text-dark);
  border-bottom: 1px solid var(--token-text-dark);
  padding: 8px 0;
  
  @media (--tablet) { font-size: 31px; }
  @media (--mobile) { font-size: 28px; }
}

/* ===== ANIMATIONS ===== */
@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

@keyframes fadeDownLarge {
  to {
    opacity: 1;
    transform: rotate(180deg) translateY(0);
    filter: blur(0);
  }
}

/* CSS fallback for non-JS */
.no-js [data-animate] {
  opacity: 0.001;
  transform: translateY(10px);
  filter: blur(7px);
  animation: fadeUp 1s forwards;
}
</style>