.hero-bio-title {
  font-family: var(--font-roboto-mono);
  font-weight: 600;
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-light);
  margin-bottom: 1em;
}

.hero-job-title {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  color: var(--token-accent-gold);
  display: block;
  margin-bottom: 8px;
  font-weight: 600;
}

