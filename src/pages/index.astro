        element.style.opacity = '1';
        element.style.transform = 'translateY(0)';
        element.style.filter = 'blur(0)';
      } else {
        // Element is leaving viewport - animate out
        element.style.opacity = '0';
        element.style.transform = 'translateY(20px)';
        element.style.filter = 'blur(2px)';
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  });

  // Observe elements
  const observeOrder = [
    elements.featuredWorkTitle,
    ...elements.devItems,
    ...elements.photoItems,
    elements.heroIn,
    elements.title,
    elements.text,
    elements.button,
    elements.divider,
    elements.expertise
  ];

  observeOrder.forEach(el => {
    if (el) observer.observe(el);
  });
  
  // ===== LETTER ANIMATION FOR COLLECTION OF WORK =====
  (function initLetterAnimation() {
    // Set up Intersection Observer for letter animations
    const letterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const container = entry.target;
          const letters = container.querySelectorAll('.letter-char');
          
          letters.forEach((char, index) => {
            setTimeout(() => {
              char.style.opacity = '1';
              char.style.transform = 'translateX(0px) translateY(0px) scale(1)';
              char.style.filter = 'blur(0px)';
              char.style.transition = 'opacity 0.6s ease-in-out, transform 0.6s ease-in-out, filter 0.6s ease-in-out';
            }, index * 150); // 150ms delay between each letter
          });
          
          // Stop observing once animation is triggered
          letterObserver.unobserve(container);
        }
      });
    }, {
      threshold: 0.3,
      rootMargin: '0px 0px -100px 0px'
    });

    // Observe all containers with letter animations
    document.querySelectorAll('.hero-subtitle, .section-title, .hero-role-porsche .tagline-word').forEach(container => {
      if (container.querySelector('.letter-char')) {
        letterObserver.observe(container);
      }
    });
  })();
  
  // ===== SCROLL-BASED VIDEO CONTROL =====
  (function initVideoScroll() {
    const pageVideoBg = document.getElementById('pageVideoBg') as HTMLElement;
    const videoWrap   = document.getElementById('pageVideoWrap') as HTMLElement;
    const video       = document.querySelector('.page-video') as HTMLVideoElement;
    
    if (!pageVideoBg || !videoWrap || !video) return;

    let ticking   = false;
    let animated  = false;
    let lastSY    = 0;
    let videoLoaded = false;
    let lastVideoTime = 0;
    let seekTimeout = null;
    let lastTargetTime = 0;
    let frameCount = 0;

    // Enhanced video preparation
    function prepareVideo() {
      video.currentTime = 0;
      video.playbackRate = 1.0;
      video.muted = true;
      video.loop = false;
      
      // Preload video frames
      if ('requestVideoFrameCallback' in video) {
        video.requestVideoFrameCallback(() => {
          videoLoaded = true;
        });
      } else {
        videoLoaded = true;
      }
    }

    // Wait for video to load metadata
    video.addEventListener('loadedmetadata', prepareVideo);
    
    // Fallback if metadata doesn't load
    setTimeout(() => {
      if (!videoLoaded && video.readyState >= 2) {
        prepareVideo();
      }
    }, 1000);

    function apply() {
      ticking = false;
      const sy = window.scrollY;
      lastSY = sy;

      // Video: no parallax movement, only scale animation
      const scale = animated ? 1 : 1.1;
      if (animated) {
        videoWrap.style.transform = 'none';
      } else {
        videoWrap.style.transform = `scale(${scale})`;
      }
      
      // Enhanced video playback control
      if (videoLoaded && video.duration) {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const scrollProgress = Math.min(1, Math.max(0, sy / maxScroll));
        const targetTime = scrollProgress * video.duration;
        
        // Only seek if target time changed significantly
        const timeDiff = Math.abs(targetTime - lastTargetTime);
        if (timeDiff > 0.05) { // Only seek for meaningful changes
          lastTargetTime = targetTime;
          
          // Clear any pending seek
          if (seekTimeout) {
            clearTimeout(seekTimeout);
          }
          
          // Optimized seek with frame rate consideration
          seekTimeout = setTimeout(() => {
            const currentTimeDiff = Math.abs(video.currentTime - targetTime);
            if (currentTimeDiff > 0.02) { // Tight threshold for smoothness
              video.currentTime = targetTime;
              lastVideoTime = targetTime;
              frameCount++;
            }
          }, 8); // Faster update rate (125fps) for smoother motion
        }
      }
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(apply);
        ticking = true;
      }
    }

    // Enhanced scroll listener with passive option
    window.addEventListener('scroll', onScroll, { passive: true });

    // After zoom animation finishes, hand control fully to JS
    setTimeout(() => {
      animated = true;
      videoWrap.style.animation = 'none';
      videoWrap.style.transform = 'none';
    }, 3900);
  })();
})();
</script>