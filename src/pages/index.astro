---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="AL DEN DS GNS | Sr Visual Designer">
  <!-- Background Pattern -->
  <div class="bg-pattern" data-parallax="0.2"></div>
  
  <!-- Navigation -->
  <Nav currentPage="home" />
  
  <main class="main">
    <!-- Hero Section -->
    <section class="hero">
      <!-- ALDEN Main Logo - Individual Letters -->
      <div class="hero-alden-logo">
        <div class="alden-letter" data-letter="A">A</div>
        <div class="alden-letter" data-letter="L">L</div>
        <div class="alden-letter" data-letter="D">D</div>
        <div class="alden-letter" data-letter="E">E</div>
        <div class="alden-letter" data-letter="N">N</div>
      </div>
      
      <!-- Hero Content Container -->
      <div class="hero-content">
        <div class="hero-description">
          <div class="hero-name">
            <h2 class="hero-name-andre" data-animate-hero="mason" data-delay="0.1">andre</h2>
            <span class="hero-bracket" data-animate-hero="bracket1" data-delay="0.2">[</span>
            <h2 class="hero-name-walters" data-animate-hero="wong" data-delay="0.3">WALTERS</h2>
            <span class="hero-bracket" data-animate-hero="bracket2" data-delay="0.4">]</span>
          </div>
          
          <div class="hero-role">
            <h2 class="hero-role-visual" data-animate-hero="visual" data-delay="0.6">software developer,</h2>
            <h2 class="hero-role-swimmer" data-animate-hero="swimmer" data-delay="0.7">visual designer,</h2>
            <h2 class="hero-role-and" data-animate-hero="and" data-delay="0.8">creative,</h2>
            <h2 class="hero-role-porsche" data-animate-hero="porsche" data-delay="0.9">nature and photography fanatic</h2>
          </div>
          
          <div class="hero-bio" data-animate-hero="bio" data-delay="1.0">
            <p class="hero-bio-title">
              <span class="hero-job-title">SR SOFTWARE AND USER EXP</span>
              <span class="hero-location">BASED IN KINGSTON JAMAICA I partner with brands, companies and entrepreneurs to transform visions into captivating experiences, all designed with the users at the helm.</span>
            </p>
          </div>
        </div>
        
        <!-- Scroll Instructions -->
        <div class="hero-scroll" data-animate-hero="scroll" data-delay="1.5">
          <span class="scroll-text">[NICE TO MEET YOU]</span>
          <span class="scroll-chinese">「很高興見到你」</span>
          <span class="scroll-instruction">[SCROLL DOWN] 請下去 [DOWN]</span>
        </div>
      </div>
      
      <div class="hero-background">
        <div class="hero-overlay"></div>
        <video class="hero-video" src="/videos/hero-background.mp4" autoplay loop muted playsinline></video>
      </div>
    </section>
    
    <!-- Info Section -->
    <section class="info">
      <div class="info-hero">
        <h2 class="info-hero-in">IN</h2>
        <div class="info-hero-chinese">
          <span class="chinese-bracket">﹁</span>
          <span class="chinese-char">簡</span>
          <span class="chinese-char">介</span>
          <span class="chinese-bracket">﹂</span>
        </div>
        <h2 class="info-hero-fo">FO</h2>
      </div>
      
      <div class="info-content">
        <h3 class="info-title">
          A <span class="title-bracket">[</span>cross-cultural<span class="title-bracket">]</span> 
          perspective shaped by <span class="title-name">Hong Kong</span> roots and 
          <span class="title-name">English</span> countryside.
        </h3>
        
        <div class="info-text">
          <p>A design approach led by curiosity, emotion, and empathy.</p>
          <p>All digital experiences created are crafted to be intuitive, meaningful, and quietly delightful.</p>
        </div>
        
        <Button href="/info" variant="light" chineseText="讀我的故事" class="hover-lift">
          READ MY STORY
        </Button>
      </div>
      
      <div class="info-divider">
        <div class="divider-line"></div>
        <div class="divider-text">﹁<br />技<br />術<br />﹂</div>
        <div class="divider-line"></div>
      </div>
      
      <div class="info-expertise">
        <div class="expertise-left">
          <img src="/images/expertise.jpg" alt="" class="expertise-image image-hover" loading="lazy" />
        </div>
        
        <div class="expertise-right">
          <h4 class="expertise-title">
            <span class="expertise-quiet">Quietly</span> <span class="expertise-powerful">powerful</span>
            Digital Experiences
          </h4>
          <p class="expertise-description">
            Design to me is a bridge between emotion and function. My goal has always been to 
            elevate everyday interactions into something more meaningful and crucially, quietly 
            threading in moments of joy that catch us by surprise and stay with us for years to come.
          </p>
          <Button href="/info" variant="light" chineseText="讀我的故事" class="hover-lift">
            READ MY STORY
          </Button>
        </div>
        
        <div class="expertise-list">
          <span class="list-label">[EXPERTISE AND SERVICES]</span>
          <div class="list-items">
            <div class="list-item">Art direction</div>
            <div class="list-item">UI / VISUAL DESIGN</div>
            <div class="list-item">USER EXPERIENCE DESIGN</div>
            <div class="list-item">enterprise design thinking</div>
            <div class="list-item">RESEARCH / STRATEGY</div>
            <div class="list-item">BRAND IDENTITY</div>
          </div>
      </div>
    </section>
    
    <!-- Footer -->
    <Footer />
  </main>
</Layout>

<style>
/* Main container */
.main {
  width: 100%;
  max-width: 2500px;
  margin: 0 auto;
  background: var(--token-bg-dark);
  position: relative;
}

.main::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: none;
  background-size: 300px 300px, 400px 400px, 200px 200px;
  background-position: 0% 0%, 50% 50%, 100% 100%;
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

/* Background pattern */
.bg-pattern {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  opacity: 0.05;
  pointer-events: none;
  z-index: 10;
  background-image: url('https://framerusercontent.com/images/rR6HYXBrMmX4cRpXfXUOvpvpB0.png');
  background-repeat: repeat;
  background-size: 256px 256px;
}

/* Hero Section */
.hero {
  position: relative;
  min-height: 100vh;
  padding-top: 150px;
  padding-bottom: 2020px;
  overflow: visible;
  transition: opacity 0.3s ease;
}

.hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('https://framerusercontent.com/images/rR6HYXBrMmX4cRpXfXUOvpvpB0.png');
  background-repeat: repeat;
  background-size: 256px 256px;
  opacity: 0.05;
  pointer-events: none;
  z-index: 0;
}

.hero-alden-logo {
  position: absolute;
  top: 29%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 5;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  opacity: 1;
  will-change: transform, opacity;
  cursor: pointer;
}

.alden-letter {
  font-family: var(--font-koulen);
  font-size: 600px;
  line-height: 0.8;
  color: var(--token-text-light);
  opacity: 0.001;
  will-change: transform, opacity;
  transition: all 0.8s cubic-bezier(0.55, 0.45, 0.16, 1);
}

.alden-letter:nth-child(1) { /* A */
  transform: translateX(-100px);
}

.alden-letter:nth-child(2) { /* L */
  transform: translateX(100px);
}

.alden-letter:nth-child(3) { /* D */
  transform: translateX(-100px);
}

.alden-letter:nth-child(4) { /* E */
  transform: translateX(100px);
}

.alden-letter:nth-child(5) { /* N */
  transform: translateX(-100px);
}



.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  min-height: calc(100vh + 2400px);
  z-index: 1;
  pointer-events: none;
}

.hero-text {
  position: absolute;
  z-index: 2;
}


.hero-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  padding: 1100px 40px 100px 40px;
  z-index: 2;
  box-sizing: border-box;
}

.hero-name {
  display: flex;
  align-items: center;
  gap: 72px;
  margin-bottom: 40px;
}

.hero-role {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-bottom: 120px;
  flex-wrap: wrap;
}

.hero-role-visual,
.hero-role-swimmer,
.hero-role-and,
.hero-role-porsche {
  font-size: 150px;
  font-family: var(--font-koulen);
  color: var(--token-text-light);
  opacity: 1;
  transform: translateY(0);
  filter: blur(0);
}

.hero-bio {
  opacity: 0.001;
  will-change: transform, opacity;
}

.hero-bio-title {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-light);
  margin-bottom: 16px;
}

.hero-company {
  color: rgb(0, 153, 255);
}

.hero-location {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  color: var(--token-text-light);
}

.hero-bio-text {
  font-family: var(--font-roboto-mono);
  font-size: 14px;
  line-height: 1.4;
  color: var(--token-text-light);
  opacity: 0.001;
  transform: translateY(10px);
  filter: none;
  will-change: transform, opacity, filter;
}

@media (min-width: 2000px) {
  .hero-m-text, .hero-h2-text, .hero-m-rotated-text {
    font-size: 940px;
  }
}

@media (max-width: 1999.98px) and (min-width: 1500px) {
  .hero-m-text, .hero-h2-text, .hero-m-rotated-text {
    font-size: 470px;
  }
}

@media (max-width: 1499.98px) and (min-width: 1200px) {
  .hero-m-text, .hero-h2-text, .hero-m-rotated-text {
    font-size: 350px;
  }
}

@media (max-width: 1199.98px) and (min-width: 810px) {
  .hero-m-text, .hero-h2-text, .hero-m-rotated-text {
    font-size: 181px;
  }
}

@media (max-width: 809.98px) {
  .hero-m-text, .hero-h2-text, .hero-m-rotated-text {
    font-size: 181px;
  }
}

@keyframes fadeUpLarge {
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

@keyframes fadeDownLarge {
  to {
    opacity: 1;
    transform: rotate(180deg) translateY(0);
    filter: blur(0);
  }
}

.hero-chinese-text {
  font-family: 'HanyiSentyFoundation Regular', sans-serif;
  font-size: 72px;
  line-height: 1.1;
  color: var(--token-accent-gold);
  text-orientation: upright;
  writing-mode: vertical-rl;
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
}

@media (max-width: 1499.98px) and (min-width: 1200px) {
  .hero-chinese-text {
    font-size: 42px;
  }
}

@media (max-width: 1199.98px) and (min-width: 810px) {
  .hero-chinese-text {
    font-size: 41px;
  }
}

@media (max-width: 809.98px) {
  .hero-chinese-text {
    font-size: 42px;
    position: relative;
    top: auto;
    left: auto;
    transform: none;
    writing-mode: horizontal-tb;
  }
}

.hero-description {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
}

@media (max-width: 1499.98px) and (min-width: 1200px) {
  .hero-description {
    max-width: 600px;
  }
}

@media (max-width: 1199.98px) and (min-width: 810px) {
  .hero-description {
    max-width: 600px;
  }
}

@media (max-width: 809.98px) {
  .hero-description {
    max-width: 100%;
    margin-bottom: 40px;
  }
}

.hero-name {
  display: flex;
  align-items: center;
  gap: 72px;
  margin-bottom: 40px;
  margin-top: 200px;
}

@media (max-width: 809.98px) {
  .hero-name {
    flex-wrap: wrap;
    gap: 10px;
  }
}

.hero-name-andre,
.hero-name-walters {
  font-size: 80px;
  font-family: var(--font-koulen);
  color: var(--token-text-light);
  opacity: 1;
  transform: translateY(0);
  filter: blur(0);
}

@media (min-width: 2000px) {
  .hero-name-andre,
  .hero-name-walters {
    font-size: 120px;
  }
  .hero-bracket { font-size: 63px; }
}

@media (max-width: 1999.98px) and (min-width: 1500px) {
  .hero-name-andre,
  .hero-name-walters {
    font-size: 100px;
  }
  .hero-bracket { font-size: 50px; }
}

@media (max-width: 1499.98px) and (min-width: 1200px) {
  .hero-name-andre,
  .hero-name-walters {
    font-size: 80px;
  }
  .hero-bracket { font-size: 35px; }
}

@media (max-width: 1199.98px) and (min-width: 810px) {
  .hero-name-andre,
  .hero-name-walters {
    font-size: 60px;
  }
  .hero-bracket { font-size: 25px; }
}

@media (max-width: 809.98px) {
  .hero-name-andre,
  .hero-name-walters {
    font-size: 30px;
  }
