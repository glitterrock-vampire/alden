/* ===== ANIMATIONS ===== */
@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

@keyframes fadeDownLarge {
  to {
    opacity: 1;
    transform: rotate(180deg) translateY(0);
    filter: blur(0);
  }
}

/* CSS fallback for non-JS */
.no-js [data-animate] {
  opacity: 0.001;
  transform: translateY(10px);
  filter: blur(7px);
  animation: fadeUp 1s forwards;
}
</style>

<script>
// ===== INFO SECTION FADE ANIMATIONS =====
(function initInfoAnimations() {
  // Elements to animate
  const elements = {
    workSeparator: document.querySelector('.work-separator'),
    workSeparatorText: document.querySelector('.work-separator-text'),
    featuredWorkTitle: document.querySelector('.featured-work-title'),
    workGallery: document.querySelector('.work-gallery'),
    viewWorkBtn: document.querySelector('.view-full-work-btn'),
    heroIn: document.querySelector('.info-hero-in'),
    title: document.querySelector('.info-title'),
    text: document.querySelector('.info-text'),
    button: document.querySelector('.info-content .button'),
    divider: document.querySelector('.info-divider'),
    expertise: document.querySelector('.info-expertise')
  };

  // Set initial states - simple fade only
  Object.values(elements).forEach(el => {
    if (el) {
      el.style.opacity = '0';
      el.style.transition = 'opacity 0.6s ease-in-out';
    }
  });

  // Intersection Observer for simple fade animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        const element = entry.target;
        
        // Simple staggered fade-in
        setTimeout(() => {
          element.style.opacity = '1';
        }, index * 100);
        
        observer.unobserve(element);
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -100px 0px'
  });

  // Observe elements in order
  const observeOrder = [
    elements.featuredWorkTitle,
    elements.viewWorkBtn,
    elements.heroIn,
    elements.title,
    elements.text,
    elements.button,
    elements.divider,
    elements.expertise
  ];

  observeOrder.forEach(el => {
    if (el) observer.observe(el);
  });

  // ===== STAGGERED TILE ANIMATIONS (like work page) =====
  (function initTileStagger() {
    // Use IntersectionObserver to trigger animations as user scrolls
    const featuredElements = document.querySelectorAll('[data-animate-hero^="featured"], [data-animate-hero^="tile"], [data-animate-hero^="view-work"]');
    
    const io = new IntersectionObserver(
      entries => entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const delay = parseFloat(el.dataset.delay) || 0;
          
          // Different animations for different elements
          if (el.dataset.animateHero === 'featured-title') {
            // Title: simple fade like hero
            el.style.opacity = '0';
            el.style.transform = 'translateY(10px)';
            el.style.filter = 'blur(7px)';
            el.style.transition = 'opacity 0.6s ease-in-out, transform 0.6s ease-in-out, filter 0.6s ease-in-out';
            
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
              el.style.filter = 'blur(0)';
            }, 200); // Immediate trigger for title
          } else if (el.dataset.animateHero.startsWith('tile')) {
            // Tiles: dynamic scale and rotation with scroll-based delay
            el.style.opacity = '0';
            el.style.transform = 'translateY(40px) scale(0.9) rotate(2deg)';
            el.style.transition = 'opacity 0.8s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1)';
            
            // Use element index for stagger instead of data-delay
            const tileIndex = Array.from(document.querySelectorAll('[data-animate-hero^="tile"]')).indexOf(el);
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0) scale(1) rotate(0deg)';
            }, 200 + (tileIndex * 200)); // 200ms stagger between tiles
          } else if (el.dataset.animateHero === 'view-work') {
            // Button: slide and scale
            el.style.opacity = '0';
            el.style.transform = 'translateY(30px) scale(0.95)';
            el.style.transition = 'opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1)';
            
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0) scale(1)';
            }, 800); // Button appears after tiles
          }
          
          io.unobserve(el);
        }
      }),
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' } // Trigger earlier as scrolling
    );
    
    featuredElements.forEach(el => io.observe(el));
  })();
  
  // ===== SCROLL-BASED VIDEO CONTROL =====
  (function initVideoScroll() {
    const pageVideoBg = document.getElementById('pageVideoBg') as HTMLElement;
    const videoWrap   = document.getElementById('pageVideoWrap') as HTMLElement;
    const video       = document.querySelector('.page-video') as HTMLVideoElement;
    if (!pageVideoBg || !videoWrap || !video) return;

    let ticking   = false;
    let animated  = false;
    let lastSY    = 0;
    let videoLoaded = false;
    let lastVideoTime = 0;
    let seekTimeout = null;

    // Wait for video to load metadata
    video.addEventListener('loadedmetadata', () => {
      videoLoaded = true;
      video.currentTime = 0;
      video.playbackRate = 1.0; // Ensure normal playback rate
      
      // Request video frame callback for smoother playback
      if ('requestVideoFrameCallback' in video) {
        video.requestVideoFrameCallback(() => {
          // Video is ready for smooth frame control
        });
      }
    });

    function apply() {
      ticking = false;
      const sy = window.scrollY;
      lastSY = sy;

      // Video: no parallax movement, only scale animation
      const scale = animated ? 1 : 1.1;
      if (animated) {
        videoWrap.style.transform = 'none';
      } else {
        videoWrap.style.transform = `scale(${scale})`;
      }
      
      // Control video playback based on scroll - extended range for full page
      if (videoLoaded && video.duration) {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const scrollProgress = Math.min(1, Math.max(0, sy / maxScroll));
        const targetTime = scrollProgress * video.duration;
        
        // Clear any pending seek
        if (seekTimeout) {
          clearTimeout(seekTimeout);
        }
        
        // Simplified smoother approach
        seekTimeout = setTimeout(() => {
          const currentTimeDiff = Math.abs(video.currentTime - targetTime);
          if (currentTimeDiff > 0.01) { // Very small threshold
            // Direct seek with smaller timeout for responsiveness
            video.currentTime = targetTime;
            lastVideoTime = targetTime;
          }
        }, 12); // Balanced update rate (83fps)
      }
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(apply);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // After zoom animation finishes, hand control fully to JS
    setTimeout(() => {
      animated = true;
      videoWrap.style.animation = 'none';
      videoWrap.style.transform = 'none';
    }, 3900);
  })();
})();
</script>