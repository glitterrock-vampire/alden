---
// src/layouts/BaseLayout.astro
export interface Props {
	title: string;
	description?: string;
}

const { title, description = "ALDEN - Senior Visual Designer" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="generator" content={Astro.generator} />
	<title>{title}</title>
	<meta name="description" content={description} />

	<!-- Font imports -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Koulen&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">

	<!-- Custom fonts -->
	<style>
		@font-face {
			font-family: 'HanyiSentyFoundation Regular';
			src: local('Arial'), local('Helvetica'), sans-serif;
			font-display: swap;
		}
		@font-face {
			font-family: 'Pinyon Script';
			src: url('/fonts/pinyon-script.woff2') format('woff2');
			font-display: swap;
		}
	</style>
</head>
<body>
	<slot />
</body>
</html>

<style is:global>
	/* Global CSS Variables */
	:root {
		--color-bg: #000;
		--color-text-primary: #e7e5df;
		--color-text-secondary: #ccbb87;
		--color-accent: #8a7432;
		--color-light: #e7e5df;
		--color-dark: #2f2f2f;
		--font-primary: 'Koulen', sans-serif;
		--font-secondary: 'Roboto Mono', monospace;
		--font-script: 'Pinyon Script', cursive;
		--font-chinese: 'HanyiSentyFoundation Regular', sans-serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-size: 87.5%;
		background-color: var(--color-bg);
		color: var(--color-text-primary);
		overscroll-behavior: none;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	body {
		font-family: var(--font-secondary);
		line-height: 1.4;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/* Hide scrollbar */
	::-webkit-scrollbar {
		display: none;
	}

	img {
		display: block;
		max-width: 100%;
		height: auto;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Screen reader only */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
